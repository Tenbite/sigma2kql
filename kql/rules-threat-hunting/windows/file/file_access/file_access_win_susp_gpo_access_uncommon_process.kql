// Title: Access To Sysvol Policies Share By Uncommon Process
// Sigma ID: 8344c19f-a023-45ff-ad63-a01c5396aea0
// Status: test | Level: medium
// Author: frack113
// Date: 2023-12-21 | Modified: -
// ATT&CK: credential-access, T1552.006
// Tags: detection.threat-hunting
// Description: Detects file access requests to the Windows Sysvol Policies Share by uncommon processes
// False positives:
//   - Unknown
// References:
//   - https://github.com/vletoux/pingcastle
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules-threat-hunting/windows/file/file_access/file_access_win_susp_gpo_access_uncommon_process.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceFileEvents
| where (FileName startswith "\\" and (FileName contains "\\sysvol\\" and FileName contains "\\Policies\\")) and (not((InitiatingProcessFolderPath contains ":\\Program Files (x86)\\" or InitiatingProcessFolderPath contains ":\\Program Files\\" or InitiatingProcessFolderPath contains ":\\Windows\\explorer.exe" or InitiatingProcessFolderPath contains ":\\Windows\\system32\\" or InitiatingProcessFolderPath contains ":\\Windows\\SysWOW64\\")))
