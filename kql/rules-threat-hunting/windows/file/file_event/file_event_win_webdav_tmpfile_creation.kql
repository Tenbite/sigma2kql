// Title: WebDAV Temporary Local File Creation
// Sigma ID: 4c55738d-72d8-490e-a2db-7969654e375f
// Status: test | Level: medium
// Author: Micah Babinski
// Date: 2023-08-21 | Modified: -
// ATT&CK: initial-access, resource-development, T1584, T1566
// Tags: detection.threat-hunting
// Description: Detects the creation of WebDAV temporary files with potentially suspicious extensions
// False positives:
//   - Legitimate use of WebDAV in an environment
// References:
//   - https://www.trellix.com/en-us/about/newsroom/stories/research/beyond-file-search-a-novel-method.html
//   - https://micahbabinski.medium.com/search-ms-webdav-and-chill-99c5b23ac462
//   - https://dear-territory-023.notion.site/WebDav-Share-Testing-e4950fa0c00149c3aa430d779b9b1d0f?pvs=4
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules-threat-hunting/windows/file/file_event/file_event_win_webdav_tmpfile_creation.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceFileEvents
| where FolderPath contains "\\AppData\\Local\\Temp\\TfsStore\\Tfs_DAV\\" and (FolderPath endswith ".7z" or FolderPath endswith ".bat" or FolderPath endswith ".dat" or FolderPath endswith ".ico" or FolderPath endswith ".js" or FolderPath endswith ".lnk" or FolderPath endswith ".ps1" or FolderPath endswith ".rar" or FolderPath endswith ".vbe" or FolderPath endswith ".vbs" or FolderPath endswith ".zip")
