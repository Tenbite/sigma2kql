// Title: Potentially Suspicious Azure Front Door Connection
// Sigma ID: 8cb4d14e-776e-43c2-8fb9-91e7fcea32b4
// Status: test | Level: medium
// Author: Isaac Dunham
// Date: 2024-11-07 | Modified: -
// ATT&CK: command-and-control, T1102.002, T1090.004
// Tags: detection.threat-hunting
// Description: Detects connections with Azure Front Door (known legitimate service that can be leveraged for
//   C2) that fall outside of known benign behavioral baseline (not using common apps or common
//   azurefd.net endpoints)
// False positives:
//   - Results are not inherently suspicious, but should be investigated during threat hunting for potential cloud C2.
//   - Organization-specific Azure Front Door endpoints
// References:
//   - https://lots-project.com/site/2a2e617a75726566642e6e6574
//   - https://medium.com/r3d-buck3t/red-teaming-in-cloud-leverage-azure-frontdoor-cdn-for-c2-redirectors-79dd9ca98178
//   - https://www.fortalicesolutions.com/posts/hiding-behind-the-front-door-with-azure-domain-fronting
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules-threat-hunting/windows/network_connection/net_connection_win_susp_azurefd_connection.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceNetworkEvents
| where RemoteUrl contains "azurefd.net" and (not(((InitiatingProcessFolderPath endswith "brave.exe" or InitiatingProcessFolderPath endswith "chrome.exe" or InitiatingProcessFolderPath endswith "chromium.exe" or InitiatingProcessFolderPath endswith "firefox.exe" or InitiatingProcessFolderPath endswith "msedge.exe" or InitiatingProcessFolderPath endswith "msedgewebview2.exe" or InitiatingProcessFolderPath endswith "opera.exe" or InitiatingProcessFolderPath endswith "vivaldi.exe") or InitiatingProcessFolderPath endswith "searchapp.exe" or (RemoteUrl contains "afdxtest.z01.azurefd.net" or RemoteUrl contains "fp-afd.azurefd.net" or RemoteUrl contains "fp-afdx-bpdee4gtg6frejfd.z01.azurefd.net" or RemoteUrl contains "roxy.azurefd.net" or RemoteUrl contains "powershellinfraartifacts-gkhedzdeaghdezhr.z01.azurefd.net" or RemoteUrl contains "storage-explorer-publishing-feapcgfgbzc2cjek.b01.azurefd.net" or RemoteUrl contains "graph.azurefd.net"))))
