// Title: Potential Data Exfiltration Via Curl.EXE
// Sigma ID: 00bca14a-df4e-4649-9054-3f2aa676bc04
// Status: test | Level: medium
// Author: Florian Roth (Nextron Systems), Cedric MAURUGEON (Update)
// Date: 2020-07-03 | Modified: 2023-05-02
// ATT&CK: exfiltration, command-and-control, T1567, T1105
// Tags: detection.threat-hunting
// Description: Detects the execution of the "curl" process with "upload" flags. Which might indicate potential
//   data exfiltration
// False positives:
//   - Scripts created by developers and admins
// References:
//   - https://twitter.com/d1r4c/status/1279042657508081664
//   - https://medium.com/@petehouston/upload-files-with-curl-93064dcccc76
//   - https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1105/T1105.md#atomic-test-19---curl-upload-file
//   - https://curl.se/docs/manpage.html
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules-threat-hunting/windows/process_creation/proc_creation_win_curl_fileupload.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\curl.exe" or ProcessVersionInfoProductName =~ "The curl executable") and ((ProcessCommandLine contains " --form" or ProcessCommandLine contains " --upload-file " or ProcessCommandLine contains " --data " or ProcessCommandLine contains " --data-") or ProcessCommandLine matches regex "\\s-[FTd]\\s")) and (not((ProcessCommandLine contains "://localhost" or ProcessCommandLine contains "://127.0.0.1")))
