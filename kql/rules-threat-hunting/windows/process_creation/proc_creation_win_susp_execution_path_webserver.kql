// Title: Execution From Webserver Root Folder
// Sigma ID: 35efb964-e6a5-47ad-bbcd-19661854018d
// Status: test | Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2019-01-16 | Modified: 2024-01-18
// ATT&CK: persistence, T1505.003
// Tags: detection.threat-hunting
// Description: Detects a program executing from a web server root folder. Use this rule to hunt for potential
//   interesting activity such as webshell or backdoors
// False positives:
//   - Various applications
//   - Tools that include ping or nslookup command invocations
// References:
//   - Internal Research
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules-threat-hunting/windows/process_creation/proc_creation_win_susp_execution_path_webserver.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (FolderPath contains "\\wwwroot\\" or FolderPath contains "\\wmpub\\" or FolderPath contains "\\htdocs\\") and (not(((FolderPath contains "bin\\" or FolderPath contains "\\Tools\\" or FolderPath contains "\\SMSComponent\\") and InitiatingProcessFolderPath endswith "\\services.exe")))
