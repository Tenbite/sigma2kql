// Title: Invocation Of Crypto-Classes From The "Cryptography" PowerShell Namespace
// Sigma ID: ad856965-f44d-42a8-945e-bbf7bd03d05a
// Status: test | Level: medium
// Author: Andreas Braathen (mnemonic.io)
// Date: 2023-12-01 | Modified: -
// ATT&CK: execution, stealth, T1059.001, T1027.010
// Tags: detection.threat-hunting
// Description: Detects the invocation of PowerShell commands with references to classes from the
//   "System.Security.Cryptography" namespace. The PowerShell namespace
//   "System.Security.Cryptography" provides classes for on-the-fly encryption and decryption. These
//   can be used for example in decrypting malicious payload for defense evasion.
// False positives:
//   - Classes are legitimately used, but less so when e.g. parents with low prevalence or decryption of content in temporary folders.
// References:
//   - https://learn.microsoft.com/en-us/dotnet/api/system.security.cryptography?view=net-8.0
//   - https://blogs.vmware.com/security/2023/11/jupyter-rising-an-update-on-jupyter-infostealer.html
//   - https://www.virustotal.com/gui/file/39102fb7bb6a74a9c8cb6d46419f9015b381199ea8524c1376672b30fffd69d2
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules-threat-hunting/windows/process_creation/proc_creation_win_powershell_crypto_namespace.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") or (ProcessVersionInfoOriginalFileName in~ ("PowerShell.EXE", "pwsh.dll"))) and ProcessCommandLine contains "System.Security.Cryptography." and (ProcessCommandLine contains ".AesCryptoServiceProvider" or ProcessCommandLine contains ".DESCryptoServiceProvider" or ProcessCommandLine contains ".DSACryptoServiceProvider" or ProcessCommandLine contains ".RC2CryptoServiceProvider" or ProcessCommandLine contains ".Rijndael" or ProcessCommandLine contains ".RSACryptoServiceProvider" or ProcessCommandLine contains ".TripleDESCryptoServiceProvider")
