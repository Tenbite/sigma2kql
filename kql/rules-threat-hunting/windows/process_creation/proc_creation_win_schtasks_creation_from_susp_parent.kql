// Title: Scheduled Task Creation From Potential Suspicious Parent Location
// Sigma ID: 9494479d-d994-40bf-a8b1-eea890237021
// Status: test | Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-23 | Modified: 2024-05-13
// ATT&CK: execution, persistence, privilege-escalation, T1053.005
// Tags: detection.threat-hunting
// Description: Detects the execution of "schtasks.exe" from a parent that is located in a potentially
//   suspicious location. Multiple malware strains were seen exhibiting a similar behavior in order
//   to achieve persistence.
// False positives:
//   - Software installers that run from temporary folders and also install scheduled tasks
// References:
//   - https://app.any.run/tasks/649e7b46-9bec-4d05-98a5-dfa9a13eaae5/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules-threat-hunting/windows/process_creation/proc_creation_win_schtasks_creation_from_susp_parent.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((InitiatingProcessFolderPath contains ":\\Temp\\" or InitiatingProcessFolderPath contains "\\AppData\\Local\\" or InitiatingProcessFolderPath contains "\\AppData\\Roaming\\" or InitiatingProcessFolderPath contains "\\Temporary Internet" or InitiatingProcessFolderPath contains "\\Users\\Public\\" or InitiatingProcessFolderPath contains "\\Windows\\Temp\\") and FolderPath endswith "\\schtasks.exe" and ProcessCommandLine contains "/Create ") and (not((ProcessCommandLine contains "update_task.xml" or ProcessCommandLine contains "unattended.ini")))
