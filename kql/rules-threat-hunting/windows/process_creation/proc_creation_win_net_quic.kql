// Title: SMB over QUIC Via Net.EXE
// Sigma ID: 2238d337-42fb-4971-9a68-63570f2aede4
// Status: test | Level: medium
// Author: frack113
// Date: 2023-07-21 | Modified: -
// ATT&CK: lateral-movement, T1570
// Tags: detection.threat-hunting
// Description: Detects the mounting of Windows SMB shares over QUIC, which can be an unexpected event in some
//   enterprise environments.
// False positives:
//   - Administrative activity
// References:
//   - https://github.com/redcanaryco/atomic-red-team/blob/74438b0237d141ee9c99747976447dc884cb1a39/atomics/T1570/T1570.md
//   - https://www.trustedsec.com/blog/making-smb-accessible-with-ntlmquic/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules-threat-hunting/windows/process_creation/proc_creation_win_net_quic.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\net.exe" or FolderPath endswith "\\net1.exe") or (ProcessVersionInfoOriginalFileName in~ ("net.exe", "net1.exe"))) and ProcessCommandLine contains "/TRANSPORT:QUIC"
