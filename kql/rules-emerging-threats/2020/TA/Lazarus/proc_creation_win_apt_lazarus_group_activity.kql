// Title: Lazarus Group Activity
// Sigma ID: 24c4d154-05a4-4b99-b57d-9b977472443a
// Status: test | Level: critical
// Author: Florian Roth (Nextron Systems), wagga
// Date: 2020-12-23 | Modified: 2023-03-10
// ATT&CK: G0032, execution, T1059
// Tags: detection.emerging-threats
// Description: Detects different process execution behaviors as described in various threat reports on Lazarus
//   group activity
// False positives:
//   - Unlikely
// References:
//   - https://securelist.com/lazarus-covets-covid-19-related-intelligence/99906/
//   - https://www.hvs-consulting.de/lazarus-report/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules-emerging-threats/2020/TA/Lazarus/proc_creation_win_apt_lazarus_group_activity.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (ProcessCommandLine contains "reg.exe save hklm\\sam %temp%\\~reg_sam.save" or ProcessCommandLine contains "1q2w3e4r@#$@#$@#$" or ProcessCommandLine contains " -hp1q2w3e4 " or ProcessCommandLine contains ".dat data03 10000 -p ") or (ProcessCommandLine contains "netstat -aon | find " and ProcessCommandLine contains "ESTA" and ProcessCommandLine contains " > %temp%\\~") or (ProcessCommandLine contains ".255 10 C:\\ProgramData\\IBM\\" and ProcessCommandLine contains ".DAT") or ((ProcessCommandLine contains " /c " and ProcessCommandLine contains " -p 0x") and (ProcessCommandLine contains "C:\\ProgramData\\" or ProcessCommandLine contains "C:\\RECYCLER\\")) or ((ProcessCommandLine contains "rundll32 " and ProcessCommandLine contains "C:\\ProgramData\\") and (ProcessCommandLine contains ".bin," or ProcessCommandLine contains ".tmp," or ProcessCommandLine contains ".dat," or ProcessCommandLine contains ".io," or ProcessCommandLine contains ".ini," or ProcessCommandLine contains ".db,"))
