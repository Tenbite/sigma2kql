// Title: Winnti Malware HK University Campaign
// Sigma ID: 3121461b-5aa0-4a41-b910-66d25524edbb
// Status: test | Level: critical
// Author: Florian Roth (Nextron Systems), Markus Neis
// Date: 2020-02-01 | Modified: 2021-11-27
// ATT&CK: privilege-escalation, persistence, execution, stealth, T1574.001, G0044
// Tags: detection.emerging-threats
// Description: Detects specific process characteristics of Winnti malware noticed in Dec/Jan 2020 in a campaign
//   against Honk Kong universities
// False positives:
//   - Unlikely
// References:
//   - https://www.welivesecurity.com/2020/01/31/winnti-group-targeting-universities-hong-kong/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules-emerging-threats/2020/TA/Winnti/proc_creation_win_apt_winnti_mal_hk_jan20.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where ((InitiatingProcessFolderPath contains "C:\\Windows\\Temp" or InitiatingProcessFolderPath contains "\\hpqhvind.exe") and FolderPath startswith "C:\\ProgramData\\DRM") or (InitiatingProcessFolderPath startswith "C:\\ProgramData\\DRM" and FolderPath endswith "\\wmplayer.exe") or (InitiatingProcessFolderPath endswith "\\Test.exe" and FolderPath endswith "\\wmplayer.exe") or FolderPath =~ "C:\\ProgramData\\DRM\\CLR\\CLR.exe" or (InitiatingProcessFolderPath startswith "C:\\ProgramData\\DRM\\Windows" and FolderPath endswith "\\SearchFilterHost.exe")
