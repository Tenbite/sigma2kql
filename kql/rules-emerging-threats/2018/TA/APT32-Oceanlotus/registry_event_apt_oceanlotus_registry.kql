// Title: OceanLotus Registry Activity
// Sigma ID: 4ac5fc44-a601-4c06-955b-309df8c4e9d4
// Status: test | Level: critical
// Author: megan201296, Jonhnathan Ribeiro
// Date: 2019-04-14 | Modified: 2023-09-28
// ATT&CK: persistence, defense-impairment, T1112
// Tags: detection.emerging-threats
// Description: Detects registry keys created in OceanLotus (also known as APT32) attacks
// False positives:
//   - Unknown
// References:
//   - https://www.welivesecurity.com/2019/03/20/fake-or-fake-keeping-up-with-oceanlotus-decoys/
//   - https://github.com/eset/malware-ioc/tree/master/oceanlotus
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules-emerging-threats/2018/TA/APT32-Oceanlotus/registry_event_apt_oceanlotus_registry.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.
// Note: 7 wildcard comparison(s) rewritten to 'matches regex' (KQL treats * in contains/endswith/== as a literal character)

DeviceRegistryEvents
| where RegistryKey contains "\\SOFTWARE\\Classes\\CLSID\\{E08A0F4B-1F65-4D4D-9A09-BD4625B9C5A1}\\Model" or (RegistryKey matches regex @"(?i)Classes\\AppXc52346ec40fb4061ad96be0e6cb7d16a.*$" or RegistryKey matches regex @"(?i)Classes\\AppX3bbba44c6cae4d9695755183472171e2.*$" or RegistryKey matches regex @"(?i)Classes\\CLSID\\\{E3517E26-8E93-458D-A6DF-8030BC80528B\}.*$" or RegistryKey contains "Classes\\CLSID\\{E08A0F4B-1F65-4D4D-9A09-BD4625B9C5A1}\\Model") or (RegistryKey matches regex @"(?i)\\SOFTWARE\\App.*$" and ((RegistryKey matches regex @"(?i)AppXbf13d4ea2945444d8b13e2121cb6b663.*$" or RegistryKey matches regex @"(?i)AppX70162486c7554f7f80f481985d67586d.*$" or RegistryKey matches regex @"(?i)AppX37cc7fdccd644b4f85f4b22d5a3f105a.*$") and (RegistryKey endswith "Application" or RegistryKey endswith "DefaultIcon")))
