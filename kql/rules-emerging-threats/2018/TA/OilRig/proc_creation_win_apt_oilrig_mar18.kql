// Title: OilRig APT Activity
// Sigma ID: ce6e34ca-966d-41c9-8d93-5b06c8b97a06
// Status: test | Level: critical
// Author: Florian Roth (Nextron Systems), Markus Neis, Jonhnathan Ribeiro, Daniil Yugoslavskiy, oscd.community
// Date: 2018-03-23 | Modified: 2023-03-08
// ATT&CK: privilege-escalation, execution, persistence, defense-impairment, G0049, T1053.005, S0111, T1543.003, T1112, command-and-control, T1071.004
// Tags: detection.emerging-threats
// Description: Detects OilRig activity as reported by Nyotron in their March 2018 report
// False positives:
//   - Unlikely
// References:
//   - https://web.archive.org/web/20180402134442/https://nyotron.com/wp-content/uploads/2018/03/Nyotron-OilRig-Malware-Report-March-2018C.pdf
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules-emerging-threats/2018/TA/OilRig/proc_creation_win_apt_oilrig_mar18.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (ProcessCommandLine contains "SC Scheduled Scan" and ProcessCommandLine contains "\\microsoft\\Taskbar\\autoit3.exe") or (FolderPath contains "\\Windows\\Temp\\DB\\" and FolderPath endswith ".exe") or (FolderPath =~ "C:\\Windows\\system32\\Service.exe" and (ProcessCommandLine contains "i" or ProcessCommandLine contains "u")) or (InitiatingProcessFolderPath endswith "\\local\\microsoft\\Taskbar\\autoit3.exe" and (ProcessCommandLine contains "nslookup.exe" and ProcessCommandLine contains "-q=TXT"))
