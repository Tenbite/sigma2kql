// Title: Shell Execution GCC  - Linux
// Sigma ID: 9b5de532-a757-4d70-946c-1f3e44f48b4d
// Status: test | Level: high
// Author: Li Ling, Andy Parkidomo, Robert Rakowski, Blake Hartstein (Bloomberg L.P.)
// Date: 2024-09-02 | Modified: -
// ATT&CK: discovery, T1083
// Description: Detects the use of the "gcc" utility to execute a shell. Such behavior may be associated with
//   privilege escalation, unauthorized command execution, or to break out from restricted
//   environments.
// False positives:
//   - Unknown
// References:
//   - https://gtfobins.github.io/gtfobins/gcc/#shell
//   - https://gtfobins.github.io/gtfobins/c89/#shell
//   - https://gtfobins.github.io/gtfobins/c99/#shell
//   - https://www.elastic.co/guide/en/security/current/linux-restricted-shell-breakout-via-linux-binary-s.html
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/linux/process_creation/proc_creation_lnx_gcc_shell_execution.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where ((FolderPath endswith "/c89" or FolderPath endswith "/c99" or FolderPath endswith "/gcc") and ProcessCommandLine contains "-wrapper") and (ProcessCommandLine contains "/bin/bash,-s" or ProcessCommandLine contains "/bin/dash,-s" or ProcessCommandLine contains "/bin/fish,-s" or ProcessCommandLine contains "/bin/sh,-s" or ProcessCommandLine contains "/bin/zsh,-s")
