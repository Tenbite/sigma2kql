// Title: Suspicious Microsoft Office Child Process - MacOS
// Sigma ID: 69483748-1525-4a6c-95ca-90dc8d431b68
// Status: test | Level: high
// Author: Sohan G (D4rkCiph3r)
// Date: 2023-01-31 | Modified: 2023-02-04
// ATT&CK: execution, persistence, T1059.002, T1137.002, T1204.002
// Description: Detects suspicious child processes spawning from microsoft office suite applications such as
//   word or excel. This could indicates malicious macro execution
// False positives:
//   - Unknown
// References:
//   - https://redcanary.com/blog/applescript/
//   - https://objective-see.org/blog/blog_0x4B.html
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/macos/process_creation/proc_creation_macos_office_susp_child_processes.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where (InitiatingProcessFolderPath contains "Microsoft Word" or InitiatingProcessFolderPath contains "Microsoft Excel" or InitiatingProcessFolderPath contains "Microsoft PowerPoint" or InitiatingProcessFolderPath contains "Microsoft OneNote") and (FolderPath endswith "/bash" or FolderPath endswith "/curl" or FolderPath endswith "/dash" or FolderPath endswith "/fish" or FolderPath endswith "/osacompile" or FolderPath endswith "/osascript" or FolderPath endswith "/sh" or FolderPath endswith "/zsh" or FolderPath endswith "/python" or FolderPath endswith "/python3" or FolderPath endswith "/wget")
