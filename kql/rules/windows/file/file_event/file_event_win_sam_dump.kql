// Title: Potential SAM Database Dump
// Sigma ID: 4e87b8e2-2ee9-4b2a-a715-4727d297ece0
// Status: test | Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-11 | Modified: 2023-01-05
// ATT&CK: credential-access, T1003.002
// Description: Detects the creation of files that look like exports of the local SAM (Security Account Manager)
// False positives:
//   - Rare cases of administrative activity
// References:
//   - https://github.com/search?q=CVE-2021-36934
//   - https://web.archive.org/web/20210725081645/https://github.com/cube0x0/CVE-2021-36934
//   - https://www.google.com/search?q=%22reg.exe+save%22+sam
//   - https://github.com/HuskyHacks/ShadowSteal
//   - https://github.com/FireFart/hivenightmare
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/file/file_event/file_event_win_sam_dump.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceFileEvents
| where (FolderPath endswith "\\Temp\\sam" or FolderPath endswith "\\sam.sav" or FolderPath endswith "\\Intel\\sam" or FolderPath endswith "\\sam.hive" or FolderPath endswith "\\Perflogs\\sam" or FolderPath endswith "\\ProgramData\\sam" or FolderPath endswith "\\Users\\Public\\sam" or FolderPath endswith "\\AppData\\Local\\sam" or FolderPath endswith "\\AppData\\Roaming\\sam" or FolderPath endswith "_ShadowSteal.zip" or FolderPath endswith "\\Documents\\SAM.export" or FolderPath endswith ":\\sam") or (FolderPath contains "\\hive_sam_" or FolderPath contains "\\sam.save" or FolderPath contains "\\sam.export" or FolderPath contains "\\~reg_sam.save" or FolderPath contains "\\sam_backup" or FolderPath contains "\\sam.bck" or FolderPath contains "\\sam.backup")
