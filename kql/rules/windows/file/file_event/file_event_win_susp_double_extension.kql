// Title: Suspicious Double Extension Files
// Sigma ID: b4926b47-a9d7-434c-b3a0-adc3fa0bd13e
// Status: test | Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), frack113
// Date: 2022-06-19 | Modified: 2026-10-16
// ATT&CK: stealth, T1036.007
// Description: Detects dropped files with double extensions, which is often used by malware as a method to
//   abuse the fact that Windows hide default extensions by default.
// False positives:
//   - Unlikely
// References:
//   - https://www.crowdstrike.com/blog/meet-crowdstrikes-adversary-of-the-month-for-june-mustang-panda/
//   - https://www.anomali.com/blog/china-based-apt-mustang-panda-targets-minority-groups-public-and-private-sector-organizations
//   - https://www.cybereason.com/blog/research/a-bazar-of-tricks-following-team9s-development-cycles
//   - https://twitter.com/malwrhunterteam/status/1235135745611960321
//   - https://twitter.com/luc4m/status/1073181154126254080
//   - https://cloud.google.com/blog/topics/threat-intelligence/cybercriminals-weaponize-fake-ai-websites
//   - https://vipre.com/blog/svg-phishing-attacks-the-new-trick-in-the-cybercriminals-playbook/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/file/file_event/file_event_win_susp_double_extension.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceFileEvents
| where (FolderPath matches regex "(?i)\\.(docx?|gif|jpe?g|mp3|mp4|pdf|png|pptx?|rtf|svg|txt|xlsx?)\\.(bat|exe|iso|rar|svg|vbe|vbs|zip)$" or (FolderPath endswith ".rar.exe" or FolderPath endswith ".zip.exe")) and (not((FolderPath endswith ".svg.svg" or FolderPath endswith ".png.svg" or FolderPath endswith ".jpg.svg" or FolderPath endswith ".jpeg.svg"))) and (not(FolderPath startswith "/usr/share/icons/"))
