// Title: Potential Persistence Via Microsoft Office Add-In
// Sigma ID: 8e1cb247-6cf6-42fa-b440-3f27d57e9936
// Status: test | Level: high
// Author: NVISO
// Date: 2020-05-11 | Modified: 2023-02-08
// ATT&CK: persistence, T1137.006
// Description: Detects potential persistence activity via startup add-ins that load when Microsoft Office
//   starts (.wll/.xll are simply .dll fit for Word or Excel).
// False positives:
//   - Legitimate add-ins
// References:
//   - Internal Research
//   - https://labs.withsecure.com/publications/add-in-opportunities-for-office-persistence
//   - https://github.com/redcanaryco/atomic-red-team/blob/4ae9580a1a8772db87a1b6cdb0d03e5af231e966/atomics/T1137.006/T1137.006.md
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/file/file_event/file_event_win_office_addin_persistence.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceFileEvents
| where (FolderPath contains "\\Microsoft\\Word\\Startup\\" and FolderPath endswith ".wll") or (FolderPath contains "\\Microsoft\\Excel\\Startup\\" and FolderPath endswith ".xll") or (FolderPath contains "Microsoft\\Excel\\XLSTART\\" and FolderPath endswith ".xlam") or (FolderPath contains "\\Microsoft\\Addins\\" and (FolderPath endswith ".xlam" or FolderPath endswith ".xla" or FolderPath endswith ".ppam"))
