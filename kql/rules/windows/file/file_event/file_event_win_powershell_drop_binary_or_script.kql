// Title: Potential Binary Or Script Dropper Via PowerShell
// Sigma ID: 7047d730-036f-4f40-b9d8-1c63e36d5e62
// Status: test | Level: medium
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-03-17 | Modified: 2025-07-04
// ATT&CK: persistence
// Description: Detects PowerShell creating a binary executable or a script file.
// False positives:
//   - False positives will differ depending on the environment and scripts used. Apply additional filters accordingly.
// References:
//   - https://www.zscaler.com/blogs/security-research/onenote-growing-threat-malware-distribution
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/file/file_event/file_event_win_powershell_drop_binary_or_script.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceFileEvents
| where ((InitiatingProcessFolderPath endswith "\\powershell.exe" or InitiatingProcessFolderPath endswith "\\powershell_ise.exe" or InitiatingProcessFolderPath endswith "\\pwsh.exe") and (FolderPath endswith ".bat" or FolderPath endswith ".chm" or FolderPath endswith ".cmd" or FolderPath endswith ".com" or FolderPath endswith ".dll" or FolderPath endswith ".exe" or FolderPath endswith ".hta" or FolderPath endswith ".jar" or FolderPath endswith ".js" or FolderPath endswith ".ocx" or FolderPath endswith ".scr" or FolderPath endswith ".sys" or FolderPath endswith ".vbe" or FolderPath endswith ".vbs" or FolderPath endswith ".wsf")) and (not(((FolderPath startswith "C:\\Users\\" and FolderPath contains "\\AppData\\Local\\Temp\\" and (FolderPath endswith ".dll" or FolderPath endswith ".exe")) or ((FolderPath startswith "C:\\Windows\\Temp\\" or FolderPath startswith "C:\\Windows\\SystemTemp\\") and (FolderPath endswith ".dll" or FolderPath endswith ".exe")) or (FolderPath startswith "C:\\Users\\" and FolderPath contains "\\WindowsPowerShell\\Modules\\" and FolderPath endswith ".dll") or (FolderPath startswith "C:\\Program Files\\PackageManagement\\ProviderAssemblies\\nuget\\" and FolderPath endswith "\\Microsoft.PackageManagement.NuGetProvider.dll"))))
