// Title: NTDS.DIT Creation By Uncommon Parent Process
// Sigma ID: 4e7050dd-e548-483f-b7d6-527ab4fa784d
// Status: test | Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-03-11 | Modified: 2023-01-05
// ATT&CK: credential-access, T1003.003
// Description: Detects creation of a file named "ntds.dit" (Active Directory Database) by an uncommon parent
//   process or directory
// False positives:
//   - Unknown
// References:
//   - https://www.ired.team/offensive-security/credential-access-and-credential-dumping/ntds.dit-enumeration
//   - https://www.n00py.io/2022/03/manipulating-user-passwords-without-mimikatz/
//   - https://pentestlab.blog/tag/ntds-dit/
//   - https://github.com/samratashok/nishang/blob/414ee1104526d7057f9adaeee196d91ae447283e/Gather/Copy-VSS.ps1
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/file/file_event/file_event_win_ntds_dit_uncommon_parent_process.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceFileEvents
| where FolderPath endswith "\\ntds.dit" and ((InitiatingProcessParentFileName in~ ("cscript.exe", "httpd.exe", "nginx.exe", "php-cgi.exe", "powershell.exe", "pwsh.exe", "w3wp.exe", "wscript.exe")) or (InitiatingProcessParentFileName startswith "apache" or InitiatingProcessParentFileName startswith "tomcat" or InitiatingProcessParentFileName startswith "" or InitiatingProcessParentFileName startswith "" or InitiatingProcessParentFileName startswith "" or InitiatingProcessParentFileName startswith ""))
