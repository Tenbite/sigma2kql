// Title: Creation of WerFault.exe/Wer.dll in Unusual Folder
// Sigma ID: 28a452f3-786c-4fd8-b8f2-bddbe9d616d1
// Status: test | Level: medium
// Author: frack113
// Date: 2022-05-09 | Modified: 2026-05-18
// ATT&CK: privilege-escalation, persistence, execution, stealth, T1574.001
// Description: Detects the creation of a file named "WerFault.exe" or "wer.dll" in an uncommon folder, which
//   could be a sign of WerFault DLL hijacking.
// False positives:
//   - Unknown
// References:
//   - https://www.bleepingcomputer.com/news/security/hackers-are-now-hiding-malware-in-windows-event-logs/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/file/file_event/file_event_win_werfault_dll_hijacking.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceFileEvents
| where (FolderPath endswith "\\WerFault.exe" or FolderPath endswith "\\wer.dll") and (not(((FolderPath startswith "C:\\Windows\\SoftwareDistribution\\" or FolderPath startswith "C:\\Windows\\System32\\" or FolderPath startswith "C:\\Windows\\SysWOW64\\" or FolderPath startswith "C:\\Windows\\WinSxS\\" or FolderPath startswith "C:\\Windows\\UUS\\") or InitiatingProcessFolderPath endswith "\\wuaucltcore.exe")))
