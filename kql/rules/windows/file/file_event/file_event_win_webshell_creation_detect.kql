// Title: Potential Webshell Creation On Static Website
// Sigma ID: 39f1f9f2-9636-45de-98f6-a4046aa8e4b9
// Status: test | Level: medium
// Author: Beyu Denis, oscd.community, Tim Shelton, Thurein Oo
// Date: 2019-10-22 | Modified: 2023-10-15
// ATT&CK: persistence, T1505.003
// Description: Detects the creation of files with certain extensions on a static web site. This can be
//   indicative of potential uploads of a web shell.
// False positives:
//   - Legitimate administrator or developer creating legitimate executable files in a web application folder
// References:
//   - PT ESC rule and personal experience
//   - https://github.com/swisskyrepo/PayloadsAllTheThings/blob/c95a0a1a2855dc0cd7f7327614545fe30482a636/Upload%20Insecure%20Files/README.md
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/file/file_event/file_event_win_webshell_creation_detect.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceFileEvents
| where ((FolderPath contains "\\inetpub\\wwwroot\\" and (FolderPath contains ".ashx" or FolderPath contains ".asp" or FolderPath contains ".ph" or FolderPath contains ".soap")) or ((FolderPath contains "\\www\\" or FolderPath contains "\\htdocs\\" or FolderPath contains "\\html\\") and FolderPath contains ".ph")) and (not(((FolderPath contains "\\AppData\\Local\\Temp\\" or FolderPath contains "\\Windows\\Temp\\") or InitiatingProcessFolderPath =~ "System" or FolderPath contains "\\xampp")))
