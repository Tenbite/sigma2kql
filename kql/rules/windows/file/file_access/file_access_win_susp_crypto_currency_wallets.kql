// Title: Access To Crypto Currency Wallets By Uncommon Applications
// Sigma ID: f41b0311-44f9-44f0-816d-dd45e39d4bc8
// Status: test | Level: medium
// Author: X__Junior (Nextron Systems)
// Date: 2024-07-29 | Modified: -
// ATT&CK: T1003, credential-access
// Description: Detects file access requests to crypto currency files by uncommon processes. Could indicate
//   potential attempt of crypto currency wallet stealing.
// False positives:
//   - Antivirus, Anti-Spyware, Anti-Malware Software
//   - Backup software
//   - Legitimate software installed on partitions other than "C:\"
//   - Searching software such as "everything.exe"
// References:
//   - Internal Research
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/file/file_access/file_access_win_susp_crypto_currency_wallets.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceFileEvents
| where ((FileName contains "\\AppData\\Roaming\\Ethereum\\keystore\\" or FileName contains "\\AppData\\Roaming\\EthereumClassic\\keystore\\" or FileName contains "\\AppData\\Roaming\\monero\\wallets\\") or (FileName endswith "\\AppData\\Roaming\\Bitcoin\\wallet.dat" or FileName endswith "\\AppData\\Roaming\\BitcoinABC\\wallet.dat" or FileName endswith "\\AppData\\Roaming\\BitcoinSV\\wallet.dat" or FileName endswith "\\AppData\\Roaming\\DashCore\\wallet.dat" or FileName endswith "\\AppData\\Roaming\\DogeCoin\\wallet.dat" or FileName endswith "\\AppData\\Roaming\\Litecoin\\wallet.dat" or FileName endswith "\\AppData\\Roaming\\Ripple\\wallet.dat" or FileName endswith "\\AppData\\Roaming\\Zcash\\wallet.dat")) and (not((InitiatingProcessFolderPath =~ "System" or (InitiatingProcessFolderPath startswith "C:\\Program Files (x86)\\" or InitiatingProcessFolderPath startswith "C:\\Program Files\\" or InitiatingProcessFolderPath startswith "C:\\Windows\\system32\\" or InitiatingProcessFolderPath startswith "C:\\Windows\\SysWOW64\\")))) and (not((InitiatingProcessFolderPath startswith "C:\\ProgramData\\Microsoft\\Windows Defender\\" and (InitiatingProcessFolderPath endswith "\\MpCopyAccelerator.exe" or InitiatingProcessFolderPath endswith "\\MsMpEng.exe"))))
