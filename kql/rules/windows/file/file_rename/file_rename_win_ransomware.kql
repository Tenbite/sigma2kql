// Title: Suspicious Appended Extension
// Sigma ID: e3f673b3-65d1-4d80-9146-466f8b63fa99
// Status: test | Level: medium
// Author: frack113
// Date: 2022-07-16 | Modified: 2023-11-11
// ATT&CK: impact, T1486
// Description: Detects file renames where the target filename uses an uncommon double extension. Could indicate
//   potential ransomware activity renaming files and adding a custom extension to the encrypted
//   files, such as ".jpg.crypted", ".docx.locky", etc.
// False positives:
//   - Backup software
// References:
//   - https://app.any.run/tasks/d66ead5a-faf4-4437-93aa-65785afaf9e5/
//   - https://blog.cyble.com/2022/08/10/onyx-ransomware-renames-its-leak-site-to-vsop/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/file/file_rename/file_rename_win_ransomware.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceFileEvents
| where ((PreviousFileName endswith ".doc" or PreviousFileName endswith ".docx" or PreviousFileName endswith ".jpeg" or PreviousFileName endswith ".jpg" or PreviousFileName endswith ".lnk" or PreviousFileName endswith ".pdf" or PreviousFileName endswith ".png" or PreviousFileName endswith ".pst" or PreviousFileName endswith ".rtf" or PreviousFileName endswith ".xls" or PreviousFileName endswith ".xlsx") and (FolderPath contains ".doc." or FolderPath contains ".docx." or FolderPath contains ".jpeg." or FolderPath contains ".jpg." or FolderPath contains ".lnk." or FolderPath contains ".pdf." or FolderPath contains ".png." or FolderPath contains ".pst." or FolderPath contains ".rtf." or FolderPath contains ".xls." or FolderPath contains ".xlsx.")) and (not((FolderPath endswith ".backup" or FolderPath endswith ".bak" or FolderPath endswith ".old" or FolderPath endswith ".orig" or FolderPath endswith ".temp" or FolderPath endswith ".tmp"))) and (not((FolderPath contains ":\\ProgramData\\Anaconda3\\" and FolderPath endswith ".c~")))
