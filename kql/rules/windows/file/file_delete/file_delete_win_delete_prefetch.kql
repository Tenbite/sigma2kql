// Title: Prefetch File Deleted
// Sigma ID: 0a1f9d29-6465-4776-b091-7f43b26e4c89
// Status: test | Level: high
// Author: Cedric MAURUGEON
// Date: 2021-09-29 | Modified: 2024-01-25
// ATT&CK: stealth, T1070.004
// Description: Detects the deletion of a prefetch file which may indicate an attempt to destroy forensic
//   evidence
// False positives:
//   - Unknown
// References:
//   - Internal Research
//   - https://www.group-ib.com/blog/hunting-for-ttps-with-prefetch-files/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/file/file_delete/file_delete_win_delete_prefetch.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceFileEvents
| where (FolderPath contains ":\\Windows\\Prefetch\\" and FolderPath endswith ".pf") and (not((InitiatingProcessFolderPath endswith ":\\windows\\system32\\svchost.exe" and (RequestAccountName contains "AUTHORI" or RequestAccountName contains "AUTORI"))))
