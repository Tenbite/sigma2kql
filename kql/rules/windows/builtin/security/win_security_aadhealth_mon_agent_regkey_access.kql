// Title: Azure AD Health Monitoring Agent Registry Keys Access
// Sigma ID: ff151c33-45fa-475d-af4f-c2f93571f4fe
// Status: test | Level: medium
// Author: Roberto Rodriguez (Cyb3rWard0g), OTR (Open Threat Research), MSTIC
// Date: 2021-08-26 | Modified: 2022-10-09
// ATT&CK: discovery, T1012
// Description: This detection uses Windows security events to detect suspicious access attempts to the registry
//   key of Azure AD Health monitoring agent. This detection requires an access control entry (ACE)
//   on the system access control list (SACL) of the following securable object
//   HKLM\SOFTWARE\Microsoft\Microsoft Online\Reporting\MonitoringAgent.
// False positives:
//   - Unknown
// References:
//   - https://o365blog.com/post/hybridhealthagent/
//   - https://github.com/OTRF/Set-AuditRule/blob/c3dec5443414231714d850565d364ca73475ade5/rules/registry/aad_connect_health_monitoring_agent.yml
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/builtin/security/win_security_aadhealth_mon_agent_regkey_access.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceRegistryEvents
| where RegistryKey =~ "\\REGISTRY\\MACHINE\\SOFTWARE\\Microsoft\\Microsoft Online\\Reporting\\MonitoringAgent" and (not((InitiatingProcessFolderPath contains "Microsoft.Identity.Health.Adfs.DiagnosticsAgent.exe" or InitiatingProcessFolderPath contains "Microsoft.Identity.Health.Adfs.InsightsService.exe" or InitiatingProcessFolderPath contains "Microsoft.Identity.Health.Adfs.MonitoringAgent.Startup.exe" or InitiatingProcessFolderPath contains "Microsoft.Identity.Health.Adfs.PshSurrogate.exe" or InitiatingProcessFolderPath contains "Microsoft.Identity.Health.Common.Clients.ResourceMonitor.exe")))
