// Title: Office Autorun Keys Modification
// Sigma ID: baecf8fb-edbf-429f-9ade-31fc3f22b970
// Status: test | Level: medium
// Author: Victor Sergeev, Daniil Yugoslavskiy, Gleb Sukhodolskiy, Timur Zinniatullin, oscd.community, Tim Shelton, frack113 (split)
// Date: 2019-10-25 | Modified: 2026-08-28
// ATT&CK: privilege-escalation, persistence, T1547.001
// Description: Detects modification of autostart extensibility point (ASEP) in registry. Adversaries may modify
//   these keys to execute malicious code when Office files are opened. There are various legitimate
//   add-ins that also use these keys and this filter list might not be exhaustive. Thus, it is
//   recommended to review and tune filters for your environment to reduce false positives before
//   deploying to production.
// False positives:
//   - Legitimate software or add-in installations and administrative configurations
//   - Automatic registry modifications during legitimate software installations
// References:
//   - https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1547.001/T1547.001.md
//   - https://learn.microsoft.com/en-us/sysinternals/downloads/autoruns
//   - https://gist.github.com/GlebSukhodolskiy/0fc5fa5f482903064b448890db1eaf9d
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules/windows/registry/registry_set/registry_set_asep_reg_keys_modification_office.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.
// Note: 18 wildcard comparison(s) rewritten to 'matches regex' (KQL treats * in contains/endswith/== as a literal character)

DeviceRegistryEvents
| where ((RegistryKey contains "\\Software\\Wow6432Node\\Microsoft\\Office" or RegistryKey contains "\\Software\\Microsoft\\Office") and (RegistryKey contains "\\Word\\Addins" or RegistryKey contains "\\PowerPoint\\Addins" or RegistryKey contains "\\Outlook\\Addins" or RegistryKey contains "\\Onenote\\Addins" or RegistryKey contains "\\Excel\\Addins" or RegistryKey contains "\\Access\\Addins" or RegistryKey contains "test\\Special\\Perf")) and (not((RegistryValueData =~ "(Empty)" or isnull(RegistryValueData) or ((InitiatingProcessFolderPath startswith "C:\\Program Files\\Microsoft Office\\" or InitiatingProcessFolderPath startswith "C:\\Program Files (x86)\\Microsoft Office\\" or InitiatingProcessFolderPath startswith "C:\\PROGRA~2\\MICROS~2\\Office" or InitiatingProcessFolderPath startswith "C:\\Windows\\System32\\msiexec.exe" or InitiatingProcessFolderPath startswith "C:\\Windows\\SysWOW64\\msiexec.exe" or InitiatingProcessFolderPath startswith "C:\\Windows\\System32\\regsvr32.exe" or InitiatingProcessFolderPath startswith "C:\\Windows\\SysWOW64\\regsvr32.exe") and (RegistryKey matches regex @"(?i)\\Excel\\Addins\\AdHocReportingExcelClientLib\.AdHocReportingExcelClientAddIn\.1.*$" or RegistryKey matches regex @"(?i)\\Excel\\Addins\\ExcelPlugInShell\.PowerMapConnect.*$" or RegistryKey matches regex @"(?i)\\Excel\\Addins\\NativeShim.*$" or RegistryKey matches regex @"(?i)\\Excel\\Addins\\NativeShim\.InquireConnector\.1.*$" or RegistryKey matches regex @"(?i)\\Excel\\Addins\\PowerPivotExcelClientAddIn\.NativeEntry\.1.*$" or RegistryKey matches regex @"(?i)\\Outlook\\AddIns\\AccessAddin\.DC.*$" or RegistryKey matches regex @"(?i)\\Outlook\\AddIns\\ColleagueImport\.ColleagueImportAddin.*$" or RegistryKey matches regex @"(?i)\\Outlook\\AddIns\\EvernoteCC\.EvernoteContactConnector.*$" or RegistryKey matches regex @"(?i)\\Outlook\\AddIns\\EvernoteOLRD\.Connect.*$" or RegistryKey contains "\\Outlook\\Addins\\OneNote.OutlookAddin" or RegistryKey matches regex @"(?i)\\Outlook\\Addins\\DriveFSExtensionLib\.Connect.*$" or RegistryKey matches regex @"(?i)\\Outlook\\Addins\\GoogleAppsSync\.Connect.*$" or RegistryKey matches regex @"(?i)\\Outlook\\Addins\\Microsoft\.VbaAddinForOutlook\.1.*$" or RegistryKey matches regex @"(?i)\\Outlook\\Addins\\OcOffice\.OcForms.*$" or RegistryKey matches regex @"(?i)\\Outlook\\Addins\\OscAddin\.Connect.*$" or RegistryKey matches regex @"(?i)\\Outlook\\Addins\\OutlookChangeNotifier\.Connect.*$" or RegistryKey contains "\\Outlook\\Addins\\UCAddin.LyncAddin.1" or RegistryKey contains "\\Outlook\\Addins\\UCAddin.UCAddin.1" or RegistryKey matches regex @"(?i)\\Outlook\\Addins\\UmOutlookAddin\.FormRegionAddin.*$" or RegistryKey contains "AddinTakeNotesService\\FriendlyName")) or ((InitiatingProcessFolderPath startswith "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\" or InitiatingProcessFolderPath startswith "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\Updates\\") and InitiatingProcessFolderPath endswith "\\OfficeClickToRun.exe") or ((InitiatingProcessFolderPath startswith "C:\\Program Files\\Common Files\\Microsoft Shared\\VSTO\\" or InitiatingProcessFolderPath startswith "C:\\Program Files (x86)\\Microsoft Shared\\VSTO\\") and InitiatingProcessFolderPath endswith "\\VSTOInstaller.exe")))) and (not((((InitiatingProcessFolderPath in~ ("C:\\Program Files\\AVG\\Antivirus\\RegSvr.exe", "C:\\Program Files\\AVG\\Antivirus\\x86\\RegSvr.exe")) and RegistryKey matches regex @"(?i)\\Microsoft\\Office\\Outlook\\Addins\\Antivirus\.AsOutExt.*$") or ((InitiatingProcessFolderPath in~ ("C:\\Program Files\\Avast Software\\Avast\\RegSvr.exe", "C:\\Program Files\\Avast Software\\Avast\\x86\\RegSvr.exe")) and RegistryKey matches regex @"(?i)\\Microsoft\\Office\\Outlook\\Addins\\Avast\.AsOutExt.*$"))))
