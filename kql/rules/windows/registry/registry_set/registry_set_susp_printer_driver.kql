// Title: Suspicious Printer Driver Empty Manufacturer
// Sigma ID: e0813366-0407-449a-9869-a2db1119dc41
// Status: test | Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2020-07-01 | Modified: 2023-08-17
// ATT&CK: persistence, privilege-escalation, execution, stealth, T1574
// Tags: cve.2021-1675
// Description: Detects a suspicious printer driver installation with an empty Manufacturer value
// False positives:
//   - Alerts on legitimate printer drivers that do not set any more details in the Manufacturer value
// References:
//   - https://twitter.com/SBousseaden/status/1410545674773467140
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/registry/registry_set/registry_set_susp_printer_driver.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceRegistryEvents
| where ((RegistryKey contains "\\Control\\Print\\Environments\\Windows x64\\Drivers" and RegistryKey contains "\\Manufacturer") and RegistryValueData =~ "(Empty)") and (not((RegistryKey endswith "\\CutePDF Writer v4.0*" or (RegistryKey endswith "\\VNC Printer (PS)*" or RegistryKey endswith "\\VNC Printer (UD)*") or RegistryKey endswith "\\Version-3\\PDF24*")))
