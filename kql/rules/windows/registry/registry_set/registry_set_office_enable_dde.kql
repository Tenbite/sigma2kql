// Title: Enable Microsoft Dynamic Data Exchange
// Sigma ID: 63647769-326d-4dde-a419-b925cc0caf42
// Status: test | Level: medium
// Author: frack113
// Date: 2022-02-26 | Modified: 2023-08-17
// ATT&CK: execution, T1559.002
// Description: Enable Dynamic Data Exchange protocol (DDE) in all supported editions of Microsoft Word or
//   Excel.
// False positives:
//   - Unknown
// References:
//   - https://msrc.microsoft.com/update-guide/vulnerability/ADV170021
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules/windows/registry/registry_set/registry_set_office_enable_dde.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceRegistryEvents
| where (RegistryKey endswith "\\Word\\Security\\AllowDDE" and (RegistryValueData in~ ("DWORD (0x00000001)", "DWORD (0x00000002)"))) or ((RegistryKey endswith "\\Excel\\Security\\DisableDDEServerLaunch" or RegistryKey endswith "\\Excel\\Security\\DisableDDEServerLookup") and RegistryValueData =~ "DWORD (0x00000000)")
