// Title: Potential Persistence Via Event Viewer Events.asp
// Sigma ID: a1e11042-a74a-46e6-b07c-c4ce8ecc239b
// Status: test | Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-17 | Modified: 2023-03-05
// ATT&CK: persistence, defense-impairment, T1112
// Description: Detects potential registry persistence technique using the Event Viewer "Events.asp" technique
// False positives:
//   - Unknown
// References:
//   - https://twitter.com/nas_bench/status/1626648985824788480
//   - https://admx.help/?Category=Windows_7_2008R2&Policy=Microsoft.Policies.InternetCommunicationManagement::EventViewer_DisableLinks
//   - https://www.hexacorn.com/blog/2019/02/15/beyond-good-ol-run-key-part-103/
//   - https://github.com/redcanaryco/atomic-red-team/blob/f296668303c29d3f4c07e42bdd2b28d8dd6625f9/atomics/T1112/T1112.md
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/registry/registry_set/registry_set_persistence_event_viewer_events_asp.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceRegistryEvents
| where (RegistryKey contains "\\Microsoft\\Windows NT\\CurrentVersion\\Event Viewer\\MicrosoftRedirectionProgram" or RegistryKey contains "\\Microsoft\\Windows NT\\CurrentVersion\\Event Viewer\\MicrosoftRedirectionURL") and (not(((InitiatingProcessFolderPath endswith "C:\\WINDOWS\\system32\\svchost.exe" and RegistryKey endswith "\\Microsoft\\Windows NT\\CurrentVersion\\Event Viewer\\MicrosoftRedirectionProgram" and RegistryValueData =~ "%%SystemRoot%%\\PCHealth\\HelpCtr\\Binaries\\HelpCtr.exe") or (InitiatingProcessFolderPath endswith "C:\\WINDOWS\\system32\\svchost.exe" and RegistryKey endswith "\\Microsoft\\Windows NT\\CurrentVersion\\Event Viewer\\MicrosoftRedirectionProgramCommandLineParameters" and RegistryValueData matches regex "-url hcp://services/centers/support.topic=%%s") or RegistryValueData =~ "http://go.microsoft.com/fwlink/events.asp" or RegistryValueData =~ "(Empty)")))
