// Title: ServiceDll Hijack
// Sigma ID: 612e47e9-8a59-43a6-b404-f48683f45bd6
// Status: test | Level: medium
// Author: frack113
// Date: 2022-02-04 | Modified: 2026-08-31
// ATT&CK: persistence, privilege-escalation, T1543.003
// Description: Detects changes to the "ServiceDLL" value related to a service in the registry. This is often
//   used as a method of persistence.
// False positives:
//   - Administrative scripts
//   - Installation of a service
// References:
//   - https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1543.003/T1543.003.md#atomic-test-4---tinyturla-backdoor-service-w64time
//   - https://www.hexacorn.com/blog/2013/09/19/beyond-good-ol-run-key-part-4/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules/windows/registry/registry_set/registry_set_servicedll_hijack.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.
// Note: 2 wildcard comparison(s) rewritten to 'matches regex' (KQL treats * in contains/endswith/== as a literal character)

DeviceRegistryEvents
| where ((RegistryKey matches regex @"(?i)\\System.*$" and RegistryKey contains "ControlSet" and RegistryKey matches regex @"(?i)\\Services.*$") and RegistryKey endswith "\\Parameters\\ServiceDll") and (not((RegistryValueData =~ "C:\\Windows\\system32\\spool\\drivers\\x64\\3\\PrintConfig.dll" or (InitiatingProcessFolderPath endswith "\\regsvr32.exe" and RegistryKey endswith "\\Services\\PrintNotify\\Parameters\\ServiceDll" and RegistryValueData startswith "C:\\WINDOWS\\System32\\DriverStore\\FileRepository\\" and RegistryValueData endswith "\\arm64\\PrintConfig.dll") or (InitiatingProcessFolderPath =~ "C:\\Windows\\system32\\lsass.exe" and RegistryKey endswith "\\Services\\NTDS\\Parameters\\ServiceDll" and RegistryValueData =~ "%%systemroot%%\\system32\\ntdsa.dll") or InitiatingProcessFolderPath =~ "C:\\Windows\\System32\\poqexec.exe"))) and (not((InitiatingProcessFolderPath endswith "\\regsvr32.exe" and RegistryValueData =~ "C:\\Windows\\System32\\STAgent.dll")))
