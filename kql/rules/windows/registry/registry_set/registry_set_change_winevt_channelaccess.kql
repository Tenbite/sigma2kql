// Title: Change Winevt Channel Access Permission Via Registry
// Sigma ID: 7d9263bd-dc47-4a58-bc92-5474abab390c
// Status: test | Level: high
// Author: frack113
// Date: 2022-09-17 | Modified: 2024-03-25
// ATT&CK: defense-impairment, T1685.001
// Description: Detects tampering with the "ChannelAccess" registry key in order to change access to Windows
//   event channel.
// False positives:
//   - Unknown
// References:
//   - https://app.any.run/tasks/77b2e328-8f36-46b2-b2e2-8a80398217ab/
//   - https://learn.microsoft.com/en-us/windows/win32/api/winevt/
//   - https://itconnect.uw.edu/tools-services-support/it-systems-infrastructure/msinf/other-help/understanding-sddl-syntax/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/registry/registry_set/registry_set_change_winevt_channelaccess.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.
// Note: 1 wildcard comparison(s) rewritten to 'matches regex' (KQL treats * in contains/endswith/== as a literal character)

DeviceRegistryEvents
| where (RegistryKey matches regex @"(?i)\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels.*$" and RegistryKey endswith "\\ChannelAccess" and (RegistryValueData contains "(A;;0x1;;;LA)" or RegistryValueData contains "(A;;0x1;;;SY)" or RegistryValueData contains "(A;;0x5;;;BA)")) and (not((InitiatingProcessFolderPath =~ "C:\\Windows\\servicing\\TrustedInstaller.exe" or (InitiatingProcessFolderPath startswith "C:\\Windows\\WinSxS\\" and InitiatingProcessFolderPath endswith "\\TiWorker.exe"))))
