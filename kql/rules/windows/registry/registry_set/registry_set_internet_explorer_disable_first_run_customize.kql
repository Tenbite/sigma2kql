// Title: Internet Explorer DisableFirstRunCustomize Enabled
// Sigma ID: ab567429-1dfb-4674-b6d2-979fd2f9d125
// Status: test | Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-16 | Modified: 2025-10-07
// ATT&CK: defense-impairment
// Description: Detects changes to the Internet Explorer "DisableFirstRunCustomize" value, which prevents
//   Internet Explorer from running the first run wizard the first time a user starts the browser
//   after installing Internet Explorer or Windows.
// False positives:
//   - As this is controlled by group policy as well as user settings. Some false positives may occur.
// References:
//   - https://www.ncsc.gov.uk/files/NCSC-MAR-Devil-Bait.pdf
//   - https://unit42.paloaltonetworks.com/operation-ke3chang-resurfaces-with-new-tidepool-malware/
//   - https://admx.help/?Category=InternetExplorer&Policy=Microsoft.Policies.InternetExplorer::NoFirstRunCustomise
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/d7c9da10c170a6988d68ebdf2c9f7bd8782b7c55/rules/windows/registry/registry_set/registry_set_internet_explorer_disable_first_run_customize.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceRegistryEvents
| where (RegistryKey endswith "\\Microsoft\\Internet Explorer\\Main\\DisableFirstRunCustomize" and (RegistryValueData in~ ("DWORD (0x00000001)", "DWORD (0x00000002)"))) and (not((InitiatingProcessFolderPath in~ ("C:\\Windows\\explorer.exe", "C:\\Windows\\System32\\ie4uinit.exe")))) and (not((((InitiatingProcessFolderPath contains "\\Temp\\" and InitiatingProcessFolderPath contains "\\.cr\\avira_") and RegistryValueData contains "DWORD (0x00000001)") or ((InitiatingProcessFolderPath in~ ("C:\\Program Files (x86)\\Foxit Software\\Foxit PDF Reader\\FoxitPDFReader.exe", "C:\\Program Files\\Foxit Software\\Foxit PDF Reader\\FoxitPDFReader.exe")) and RegistryValueData contains "DWORD (0x00000001)"))))
