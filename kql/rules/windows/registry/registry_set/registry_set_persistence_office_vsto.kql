// Title: Potential Persistence Via Visual Studio Tools for Office
// Sigma ID: 9d15044a-7cfe-4d23-8085-6ebc11df7685
// Status: test | Level: medium
// Author: Bhabesh Raj
// Date: 2021-01-10 | Modified: 2026-01-09
// ATT&CK: T1137.006, persistence
// Description: Detects persistence via Visual Studio Tools for Office (VSTO) add-ins in Office applications.
// False positives:
//   - Legitimate Addin Installation
// References:
//   - https://twitter.com/_vivami/status/1347925307643355138
//   - https://vanmieghem.io/stealth-outlook-persistence/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules/windows/registry/registry_set/registry_set_persistence_office_vsto.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.
// Note: 7 wildcard comparison(s) rewritten to 'matches regex' (KQL treats * in contains/endswith/== as a literal character)

DeviceRegistryEvents
| where (RegistryKey matches regex @"(?i)\\Software\\Microsoft\\Office\\Outlook\\Addins.*$" or RegistryKey matches regex @"(?i)\\Software\\Microsoft\\Office\\Word\\Addins.*$" or RegistryKey matches regex @"(?i)\\Software\\Microsoft\\Office\\Excel\\Addins.*$" or RegistryKey matches regex @"(?i)\\Software\\Microsoft\\Office\\Powerpoint\\Addins.*$" or RegistryKey matches regex @"(?i)\\Software\\Microsoft\\VSTO\\Security\\Inclusion.*$") and (not(((InitiatingProcessFolderPath in~ ("C:\\Windows\\System32\\msiexec.exe", "C:\\Windows\\SysWOW64\\msiexec.exe", "C:\\Windows\\System32\\regsvr32.exe", "C:\\Windows\\SysWOW64\\regsvr32.exe")) or ((InitiatingProcessFolderPath startswith "C:\\Program Files\\Common Files (x86)\\Microsoft Shared\\ClickToRun\\" or InitiatingProcessFolderPath startswith "C:\\Program Files\\Common Files\\Microsoft Shared\\ClickToRun\\") and InitiatingProcessFolderPath endswith "\\OfficeClickToRun.exe") or (InitiatingProcessFolderPath in~ ("C:\\Program Files (x86)\\Microsoft Office\\root\\integration\\integrator.exe", "C:\\Program Files\\Microsoft Office\\root\\integration\\integrator.exe")) or ((InitiatingProcessFolderPath startswith "C:\\Program Files\\Microsoft Office\\OFFICE" or InitiatingProcessFolderPath startswith "C:\\Program Files (x86)\\Microsoft Office\\OFFICE" or InitiatingProcessFolderPath startswith "C:\\Program Files\\Microsoft Office\\Root\\OFFICE" or InitiatingProcessFolderPath startswith "C:\\Program Files (x86)\\Microsoft Office\\Root\\OFFICE" or InitiatingProcessFolderPath startswith "C:\\PROGRA~2\\MICROS~2\\Office") and (InitiatingProcessFolderPath endswith "\\excel.exe" or InitiatingProcessFolderPath endswith "\\Integrator.exe" or InitiatingProcessFolderPath endswith "\\OneNote.exe" or InitiatingProcessFolderPath endswith "\\outlook.exe" or InitiatingProcessFolderPath endswith "\\powerpnt.exe" or InitiatingProcessFolderPath endswith "\\Teams.exe" or InitiatingProcessFolderPath endswith "\\visio.exe" or InitiatingProcessFolderPath endswith "\\winword.exe")) or ((InitiatingProcessFolderPath startswith "C:\\Program Files\\Common Files\\Microsoft Shared\\VSTO\\" or InitiatingProcessFolderPath startswith "C:\\Program Files (x86)\\Microsoft Shared\\VSTO\\") and InitiatingProcessFolderPath endswith "\\VSTOInstaller.exe")))) and (not((((InitiatingProcessFolderPath in~ ("C:\\Program Files\\AVG\\Antivirus\\RegSvr.exe", "C:\\Program Files (x86)\\AVG\\Antivirus\\RegSvr.exe")) and RegistryKey matches regex @"(?i)\\Microsoft\\Office\\Outlook\\Addins\\Antivirus\.AsOutExt.*$") or ((InitiatingProcessFolderPath in~ ("C:\\Program Files\\Avast Software\\Avast\\RegSvr.exe", "C:\\Program Files (x86)\\Avast Software\\Avast\\RegSvr.exe")) and RegistryKey matches regex @"(?i)\\Microsoft\\Office\\Outlook\\Addins\\Avast\.AsOutExt.*$"))))
