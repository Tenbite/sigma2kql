// Title: New Root or CA or AuthRoot Certificate to Store
// Sigma ID: d223b46b-5621-4037-88fe-fda32eead684
// Status: test | Level: medium
// Author: frack113
// Date: 2022-04-04 | Modified: 2023-08-17
// ATT&CK: impact, T1490
// Description: Detects the addition of new root, CA or AuthRoot certificates to the Windows registry
// False positives:
//   - Unknown
// References:
//   - https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1553.004/T1553.004.md#atomic-test-6---add-root-certificate-to-currentuser-certificate-store
//   - https://posts.specterops.io/code-signing-certificate-cloning-attacks-and-defenses-6f98657fc6ec
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/registry/registry_set/registry_set_install_root_or_ca_certificat.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.
// Note: 9 wildcard comparison(s) rewritten to 'matches regex' (KQL treats * in contains/endswith/== as a literal character)

DeviceRegistryEvents
| where (RegistryKey matches regex @"(?i)\\SOFTWARE\\Microsoft\\SystemCertificates\\Root\\Certificates.*$" or RegistryKey matches regex @"(?i)\\SOFTWARE\\Policies\\Microsoft\\SystemCertificates\\Root\\Certificates.*$" or RegistryKey matches regex @"(?i)\\SOFTWARE\\Microsoft\\EnterpriseCertificates\\Root\\Certificates.*$" or RegistryKey matches regex @"(?i)\\SOFTWARE\\Microsoft\\SystemCertificates\\CA\\Certificates.*$" or RegistryKey matches regex @"(?i)\\SOFTWARE\\Policies\\Microsoft\\SystemCertificates\\CA\\Certificates.*$" or RegistryKey matches regex @"(?i)\\SOFTWARE\\Microsoft\\EnterpriseCertificates\\CA\\Certificates.*$" or RegistryKey matches regex @"(?i)\\SOFTWARE\\Microsoft\\SystemCertificates\\AuthRoot\\Certificates.*$" or RegistryKey matches regex @"(?i)\\SOFTWARE\\Policies\\Microsoft\\SystemCertificates\\AuthRoot\\Certificates.*$" or RegistryKey matches regex @"(?i)\\SOFTWARE\\Microsoft\\EnterpriseCertificates\\AuthRoot\\Certificates.*$") and RegistryKey endswith "\\Blob" and RegistryValueData =~ "Binary Data"
