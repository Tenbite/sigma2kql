// Title: Old TLS1.0/TLS1.1 Protocol Version Enabled
// Sigma ID: 439957a7-ad86-4a8f-9705-a28131c6821b
// Status: test | Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-09-05 | Modified: -
// ATT&CK: stealth
// Description: Detects applications or users re-enabling old TLS versions by setting the "Enabled" value to "1"
//   for the "Protocols" registry key.
// False positives:
//   - Legitimate enabling of the old tls versions due to incompatibility
// References:
//   - https://techcommunity.microsoft.com/t5/windows-it-pro-blog/tls-1-0-and-tls-1-1-soon-to-be-disabled-in-windows/ba-p/3887947
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/registry/registry_set/registry_set_tls_protocol_old_version_enabled.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.
// Note: 2 wildcard comparison(s) rewritten to 'matches regex' (KQL treats * in contains/endswith/== as a literal character)

DeviceRegistryEvents
| where (RegistryKey matches regex @"(?i)\\Control\\SecurityProviders\\SCHANNEL\\Protocols\\TLS 1\.0.*$" or RegistryKey matches regex @"(?i)\\Control\\SecurityProviders\\SCHANNEL\\Protocols\\TLS 1\.1.*$") and RegistryKey endswith "\\Enabled" and RegistryValueData =~ "DWORD (0x00000001)"
