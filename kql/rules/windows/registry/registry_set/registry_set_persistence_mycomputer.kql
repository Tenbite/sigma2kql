// Title: Potential Persistence Via MyComputer Registry Keys
// Sigma ID: 8fbe98a8-8f9d-44f8-aa71-8c572e29ef06
// Status: test | Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-09 | Modified: 2026-11-16
// ATT&CK: persistence
// Description: Detects modification to the "Default" value of the "MyComputer" key and subkeys to point to a
//   custom binary that will be launched whenever the associated action is executed (see reference
//   section for example)
// False positives:
//   - Unlikely but if you experience FPs add specific processes and locations you would like to monitor for
// References:
//   - https://www.hexacorn.com/blog/2017/01/18/beyond-good-ol-run-key-part-55/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/698f0912f571d5fac3bf8c51f5421139834a011c/rules/windows/registry/registry_set/registry_set_persistence_mycomputer.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceRegistryEvents
| where (RegistryKey contains "\\Microsoft\\Windows\\CurrentVersion\\Explorer\\MyComputer" and RegistryKey endswith "path\\(Default)") and (not(((RegistryValueData startswith "%%SystemRoot%%\\" or RegistryValueData startswith "%%Windir%%\\" or RegistryValueData startswith "%SystemRoot%\\" or RegistryValueData startswith "%Windir%\\" or RegistryValueData startswith "C:\\Windows\\") and ((RegistryKey endswith "\\MyComputer\\BackupPath\\(Default)" and (RegistryValueData endswith "\\System32\\sdclt.exe" or RegistryValueData endswith "\\SysWOW64\\sdclt.exe")) or (RegistryKey endswith "\\MyComputer\\cleanuppath\\(Default)" and (RegistryValueData endswith "\\System32\\cleanmgr.exe /D %c" or RegistryValueData endswith "\\SysWOW64\\cleanmgr.exe /D %c" or RegistryValueData endswith "\\System32\\cleanmgr.exe /D %%c" or RegistryValueData endswith "\\SysWOW64\\cleanmgr.exe /D %%c")) or (RegistryKey endswith "\\MyComputer\\DefragPath\\(Default)" and (RegistryValueData endswith "\\System32\\dfrgui.exe" or RegistryValueData endswith "\\SysWOW64\\dfrgui.exe"))))))
