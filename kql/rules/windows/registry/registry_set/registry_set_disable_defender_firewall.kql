// Title: Disable Microsoft Defender Firewall via Registry
// Sigma ID: 974515da-6cc5-4c95-ae65-f97f9150ec7f
// Status: test | Level: medium
// Author: frack113
// Date: 2022-01-09 | Modified: 2024-03-25
// ATT&CK: defense-impairment, T1686.003
// Description: Adversaries may disable or modify system firewalls in order to bypass controls limiting network
//   usage
// False positives:
//   - Unknown
// References:
//   - https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1562.004/T1562.004.md#atomic-test-2---disable-microsoft-defender-firewall-via-registry
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/registry/registry_set/registry_set_disable_defender_firewall.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.
// Note: 1 wildcard comparison(s) rewritten to 'matches regex' (KQL treats * in contains/endswith/== as a literal character)

DeviceRegistryEvents
| where RegistryKey matches regex @"(?i)\\Services\\SharedAccess\\Parameters\\FirewallPolicy.*$" and RegistryKey endswith "\\EnableFirewall" and RegistryValueData =~ "DWORD (0x00000000)"
