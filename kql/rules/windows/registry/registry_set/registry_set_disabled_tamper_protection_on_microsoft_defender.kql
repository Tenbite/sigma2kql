// Title: Disable Tamper Protection on Windows Defender
// Sigma ID: 93d298a1-d28f-47f1-a468-d971e7796679
// Status: test | Level: medium
// Author: Austin Songer @austinsonger
// Date: 2021-08-04 | Modified: 2023-08-17
// ATT&CK: defense-impairment, T1685
// Description: Detects disabling Windows Defender Tamper Protection
// False positives:
//   - Unknown
// References:
//   - https://www.tenforums.com/tutorials/123792-turn-off-tamper-protection-microsoft-defender-antivirus.html
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules/windows/registry/registry_set/registry_set_disabled_tamper_protection_on_microsoft_defender.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceRegistryEvents
| where (RegistryKey contains "\\Microsoft\\Windows Defender\\Features\\TamperProtection" and RegistryValueData =~ "DWORD (0x00000000)") and (not(((InitiatingProcessFolderPath startswith "C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\" and InitiatingProcessFolderPath endswith "\\MsMpEng.exe") or InitiatingProcessFolderPath =~ "C:\\Program Files\\Windows Defender\\MsMpEng.exe")))
