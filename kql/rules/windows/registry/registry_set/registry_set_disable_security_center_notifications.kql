// Title: Disable Windows Security Center Notifications
// Sigma ID: 3ae1a046-f7db-439d-b7ce-b8b366b81fa6
// Status: test | Level: medium
// Author: frack113
// Date: 2022-08-19 | Modified: 2023-08-17
// ATT&CK: persistence, defense-impairment, T1112
// Description: Detect set UseActionCenterExperience to 0 to disable the Windows security center notification
// False positives:
//   - Unknown
// References:
//   - https://github.com/redcanaryco/atomic-red-team/blob/40b77d63808dd4f4eafb83949805636735a1fd15/atomics/T1112/T1112.md
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/registry/registry_set/registry_set_disable_security_center_notifications.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceRegistryEvents
| where RegistryKey endswith "Windows\\CurrentVersion\\ImmersiveShell\\UseActionCenterExperience" and RegistryValueData =~ "DWORD (0x00000000)"
