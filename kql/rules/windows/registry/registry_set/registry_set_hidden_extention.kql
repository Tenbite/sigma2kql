// Title: Registry Modification to Hidden File Extension
// Sigma ID: 5df86130-4e95-4a54-90f7-26541b40aec2
// Status: test | Level: medium
// Author: frack113
// Date: 2022-01-22 | Modified: 2023-08-17
// ATT&CK: persistence, T1137
// Description: Hides the file extension through modification of the registry
// False positives:
//   - Administrative scripts
// References:
//   - https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1112/T1112.md#atomic-test-1---modify-registry-of-current-user-profile---cmd
//   - https://unit42.paloaltonetworks.com/ransomware-families/
//   - https://www.microsoft.com/en-us/wdsi/threats/malware-encyclopedia-description?name=TrojanSpy%3aMSIL%2fHakey.A
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/registry/registry_set/registry_set_hidden_extention.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceRegistryEvents
| where (RegistryKey endswith "\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced\\HideFileExt" and RegistryValueData =~ "DWORD (0x00000001)") or (RegistryKey endswith "\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced\\Hidden" and RegistryValueData =~ "DWORD (0x00000002)")
