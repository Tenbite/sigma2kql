// Title: Removal Of AMSI Provider Registry Keys
// Sigma ID: 41d1058a-aea7-4952-9293-29eaaf516465
// Status: test | Level: high
// Author: frack113
// Date: 2021-06-07 | Modified: 2025-10-07
// ATT&CK: defense-impairment, T1685
// Description: Detects the deletion of AMSI provider registry key entries in HKLM\Software\Microsoft\AMSI. This
//   technique could be used by an attacker in order to disable AMSI inspection.
// False positives:
//   - Unlikely
// References:
//   - https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1562.001/T1562.001.md
//   - https://seclists.org/fulldisclosure/2020/Mar/45
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/registry/registry_delete/registry_delete_removal_amsi_registry_key.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceRegistryEvents
| where (ActionType in~ ("RegistryKeyDeleted", "RegistryValueDeleted")) and ((RegistryKey endswith "{2781761E-28E0-4109-99FE-B9D127C57AFE}" or RegistryKey endswith "{A7C452EF-8E9F-42EB-9F2B-245613CA0DC9}") and (not(((InitiatingProcessFolderPath startswith "C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\" or InitiatingProcessFolderPath startswith "C:\\Program Files\\Windows Defender\\" or InitiatingProcessFolderPath startswith "C:\\Program Files (x86)\\Windows Defender\\") and InitiatingProcessFolderPath endswith "\\MsMpEng.exe"))))
