// Title: NetNTLM Downgrade Attack - Registry
// Sigma ID: d67572a0-e2ec-45d6-b8db-c100d14b8ef2
// Status: test | Level: high
// Author: Florian Roth (Nextron Systems), wagga, Nasreddine Bencherchali (Splunk STRT)
// Date: 2018-03-20 | Modified: 2024-12-03
// ATT&CK: persistence, defense-impairment, T1685, T1112
// Description: Detects NetNTLM downgrade attack
// False positives:
//   - Services or tools that set the values to more restrictive values
// References:
//   - https://web.archive.org/web/20171113231705/https://www.optiv.com/blog/post-exploitation-using-netntlm-downgrade-attacks
//   - https://www.ultimatewindowssecurity.com/wiki/page.aspx?spid=NSrpcservers
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/registry/registry_event/registry_event_net_ntlm_downgrade.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceRegistryEvents
| where (RegistryKey endswith "SYSTEM*" and RegistryKey contains "ControlSet" and RegistryKey contains "\\Control\\Lsa") and ((RegistryKey endswith "\\lmcompatibilitylevel" and (RegistryValueData in~ ("DWORD (0x00000000)", "DWORD (0x00000001)", "DWORD (0x00000002)"))) or (RegistryKey endswith "\\NtlmMinClientSec" and (RegistryValueData in~ ("DWORD (0x00000000)", "DWORD (0x00000010)", "DWORD (0x00000020)", "DWORD (0x00000030)"))) or RegistryKey endswith "\\RestrictSendingNTLMTraffic")
