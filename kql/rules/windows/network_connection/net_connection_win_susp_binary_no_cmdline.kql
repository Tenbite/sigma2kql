// Title: Suspicious Network Connection Binary No CommandLine
// Sigma ID: 20384606-a124-4fec-acbb-8bd373728613
// Status: test | Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-07-03 | Modified: -
// ATT&CK: stealth
// Description: Detects suspicious network connections made by a well-known Windows binary run with no command
//   line parameters
// False positives:
//   - Unknown
// References:
//   - https://redcanary.com/blog/raspberry-robin/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules/windows/network_connection/net_connection_win_susp_binary_no_cmdline.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceNetworkEvents
| where ((InitiatingProcessFolderPath endswith "\\regsvr32.exe" or InitiatingProcessFolderPath endswith "\\rundll32.exe" or InitiatingProcessFolderPath endswith "\\dllhost.exe") and (InitiatingProcessCommandLine endswith "\\regsvr32.exe" or InitiatingProcessCommandLine endswith "\\rundll32.exe" or InitiatingProcessCommandLine endswith "\\dllhost.exe")) and (not((InitiatingProcessCommandLine =~ "" or isnull(InitiatingProcessCommandLine))))
