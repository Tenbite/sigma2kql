// Title: DotNet CLR DLL Loaded By Scripting Applications
// Sigma ID: 4508a70e-97ef-4300-b62b-ff27992990ea
// Status: test | Level: high
// Author: omkar72, oscd.community
// Date: 2020-10-14 | Modified: 2023-02-23
// ATT&CK: execution, privilege-escalation, stealth, T1055
// Description: Detects .NET CLR DLLs being loaded by scripting applications such as wscript or cscript. This
//   could be an indication of potential suspicious execution.
// False positives:
//   - Unknown
// References:
//   - https://github.com/tyranid/DotNetToJScript
//   - https://thewover.github.io/Introducing-Donut/
//   - https://web.archive.org/web/20230329154538/https://blog.menasec.net/2019/07/interesting-difr-traces-of-net-clr.html
//   - https://web.archive.org/web/20221026202428/https://gist.github.com/code-scrap/d7f152ffcdb3e0b02f7f394f5187f008
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/image_load/image_load_susp_script_dotnet_clr_dll_load.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceImageLoadEvents
| where (InitiatingProcessFolderPath endswith "\\cmstp.exe" or InitiatingProcessFolderPath endswith "\\cscript.exe" or InitiatingProcessFolderPath endswith "\\mshta.exe" or InitiatingProcessFolderPath endswith "\\msxsl.exe" or InitiatingProcessFolderPath endswith "\\regsvr32.exe" or InitiatingProcessFolderPath endswith "\\wmic.exe" or InitiatingProcessFolderPath endswith "\\wscript.exe") and (FolderPath endswith "\\clr.dll" or FolderPath endswith "\\mscoree.dll" or FolderPath endswith "\\mscorlib.dll")
