// Title: System Control Panel Item Loaded From Uncommon Location
// Sigma ID: 2b140a5c-dc02-4bb8-b6b1-8bdb45714cde
// Status: test | Level: high
// Author: Anish Bogati
// Date: 2024-01-09 | Modified: 2026-02-17
// ATT&CK: persistence, privilege-escalation, execution, stealth, T1574.001
// Description: Detects image load events of system control panel items (.cpl) from uncommon or non-system
//   locations that may indicate DLL sideloading or other abuse techniques.
// False positives:
//   - Unknown
// References:
//   - https://www.hexacorn.com/blog/2024/01/06/1-little-known-secret-of-fondue-exe/
//   - https://www.hexacorn.com/blog/2024/01/01/1-little-known-secret-of-hdwwiz-exe/
//   - https://github.com/mhaskar/FsquirtCPLPoC
//   - https://securelist.com/sidewinder-apt/114089/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules/windows/image_load/image_load_side_load_cpl_from_non_system_location.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceImageLoadEvents
| where (FolderPath endswith "\\appwiz.cpl" or FolderPath endswith "\\bthprops.cpl" or FolderPath endswith "\\hdwwiz.cpl") and (not((FolderPath startswith "C:\\Windows\\Prefetch\\" or FolderPath startswith "C:\\Windows\\System32\\" or FolderPath startswith "C:\\Windows\\SysWOW64\\" or FolderPath startswith "C:\\Windows\\WinSxS\\")))
