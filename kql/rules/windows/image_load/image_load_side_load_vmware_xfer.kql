// Title: Potential DLL Sideloading Via VMware Xfer
// Sigma ID: 9313dc13-d04c-46d8-af4a-a930cc55d93b
// Status: test | Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-08-02 | Modified: 2023-02-17
// ATT&CK: privilege-escalation, persistence, execution, stealth, T1574.001
// Description: Detects loading of a DLL by the VMware Xfer utility from the non-default directory which may be
//   an attempt to sideload arbitrary DLL
// False positives:
//   - Unlikely
// References:
//   - https://www.sentinelone.com/labs/lockbit-ransomware-side-loads-cobalt-strike-beacon-with-legitimate-vmware-utility/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/image_load/image_load_side_load_vmware_xfer.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceImageLoadEvents
| where (InitiatingProcessFolderPath endswith "\\VMwareXferlogs.exe" and FolderPath endswith "\\glib-2.0.dll") and (not(FolderPath startswith "C:\\Program Files\\VMware\\"))
