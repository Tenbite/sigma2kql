// Title: Potential appverifUI.DLL Sideloading
// Sigma ID: ee6cea48-c5b6-4304-a332-10fc6446f484
// Status: test | Level: high
// Author: X__Junior (Nextron Systems)
// Date: 2023-06-20 | Modified: -
// ATT&CK: persistence, privilege-escalation, execution, stealth, T1574.001
// Description: Detects potential DLL sideloading of "appverifUI.dll"
// False positives:
//   - Unlikely
// References:
//   - https://web.archive.org/web/20220519091349/https://fatrodzianko.com/2020/02/15/dll-side-loading-appverif-exe/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules/windows/image_load/image_load_side_load_appverifui.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceImageLoadEvents
| where FolderPath endswith "\\appverifUI.dll" and (not(((InitiatingProcessFolderPath in~ ("C:\\Windows\\SysWOW64\\appverif.exe", "C:\\Windows\\System32\\appverif.exe")) and (FolderPath startswith "C:\\Windows\\System32\\" or FolderPath startswith "C:\\Windows\\SysWOW64\\" or FolderPath startswith "C:\\Windows\\WinSxS\\"))))
