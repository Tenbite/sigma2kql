// Title: UAC Bypass Using Iscsicpl - ImageLoad
// Sigma ID: 9ed5959a-c43c-4c59-84e3-d28628429456
// Status: test | Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-17 | Modified: 2022-07-25
// ATT&CK: privilege-escalation, T1548.002
// Description: Detects the "iscsicpl.exe" UAC bypass technique that leverages a DLL Search Order hijacking
//   technique to load a custom DLL's from temp or a any user controlled location in the users %PATH%
// False positives:
//   - Unknown
// References:
//   - https://github.com/hackerhouse-opensource/iscsicpl_bypassUAC
//   - https://twitter.com/wdormann/status/1547583317410607110
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/image_load/image_load_uac_bypass_iscsicpl.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceImageLoadEvents
| where (InitiatingProcessFolderPath =~ "C:\\Windows\\SysWOW64\\iscsicpl.exe" and FolderPath endswith "\\iscsiexe.dll") and (not((FolderPath contains "C:\\Windows\\" and FolderPath contains "iscsiexe.dll")))
