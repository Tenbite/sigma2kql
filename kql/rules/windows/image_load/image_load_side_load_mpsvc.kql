// Title: Potential DLL Sideloading Of MpSvc.DLL
// Sigma ID: 5ba243e5-8165-4cf7-8c69-e1d3669654c1
// Status: test | Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), Wietze Beukema
// Date: 2024-07-11 | Modified: -
// ATT&CK: privilege-escalation, persistence, execution, stealth, T1574.001
// Description: Detects potential DLL sideloading of "MpSvc.dll".
// False positives:
//   - Legitimate applications loading their own versions of the DLL mentioned in this rule.
// References:
//   - https://hijacklibs.net/entries/microsoft/built-in/mpsvc.html
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/image_load/image_load_side_load_mpsvc.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceImageLoadEvents
| where FolderPath endswith "\\MpSvc.dll" and (not((FolderPath startswith "C:\\Program Files\\Windows Defender\\" or FolderPath startswith "C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\" or FolderPath startswith "C:\\Windows\\WinSxS\\")))
