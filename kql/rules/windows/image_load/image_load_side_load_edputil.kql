// Title: Potential Edputil.DLL Sideloading
// Sigma ID: e4903324-1a10-4ed3-981b-f6fe3be3a2c2
// Status: test | Level: high
// Author: X__Junior (Nextron Systems)
// Date: 2023-06-09 | Modified: 2026-11-05
// ATT&CK: persistence, privilege-escalation, execution, stealth, T1574.001
// Description: Detects potential DLL sideloading of "edputil.dll"
// False positives:
//   - Unlikely
// References:
//   - https://alternativeto.net/news/2023/5/cybercriminals-use-wordpad-vulnerability-to-spread-qbot-malware/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/52f81d60d5ea122e49a34b2289ea0c2a7bb0b113/rules/windows/image_load/image_load_side_load_edputil.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceImageLoadEvents
| where FolderPath endswith "\\edputil.dll" and (not((FolderPath startswith "C:\\Windows\\System32\\" or FolderPath startswith "C:\\Windows\\SysWOW64\\" or FolderPath startswith "C:\\Windows\\WinSxS\\")))
