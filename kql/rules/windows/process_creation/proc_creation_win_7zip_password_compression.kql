// Title: Compress Data and Lock With Password for Exfiltration With 7-ZIP
// Sigma ID: 9fbf5927-5261-4284-a71d-f681029ea574
// Status: test | Level: medium
// Author: frack113
// Date: 2021-07-27 | Modified: 2026-06-05
// ATT&CK: collection, T1560.001
// Description: An adversary may compress or encrypt data that is collected prior to exfiltration using 3rd
//   party utilities
// False positives:
//   - Legitimate activity is expected since compressing files with a password is common.
// References:
//   - https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1560.001/T1560.001.md
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_7zip_password_compression.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (ProcessVersionInfoFileDescription contains "7-Zip" or (FolderPath endswith "\\7z.exe" or FolderPath endswith "\\7zr.exe" or FolderPath endswith "\\7za.exe") or (ProcessVersionInfoOriginalFileName in~ ("7z.exe", "7za.exe", "7zr.exe"))) and ProcessCommandLine contains " -p" and (ProcessCommandLine contains " a " or ProcessCommandLine contains " u ")
