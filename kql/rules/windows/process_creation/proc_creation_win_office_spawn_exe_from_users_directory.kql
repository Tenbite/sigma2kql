// Title: Suspicious Binary In User Directory Spawned From Office Application
// Sigma ID: aa3a6f94-890e-4e22-b634-ffdfd54792cc
// Status: test | Level: high
// Author: Jason Lynch
// Date: 2019-04-02 | Modified: 2023-02-04
// ATT&CK: execution, T1204.002, G0046
// Tags: car.2013-05-002
// Description: Detects an executable in the users directory started from one of the Microsoft Office suite
//   applications (Word, Excel, PowerPoint, Publisher, Visio)
// False positives:
//   - Unknown
// References:
//   - https://blog.morphisec.com/fin7-not-finished-morphisec-spots-new-campaign
//   - https://www.virustotal.com/gui/file/23160972c6ae07f740800fa28e421a81d7c0ca5d5cab95bc082b4a986fbac57
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/process_creation/proc_creation_win_office_spawn_exe_from_users_directory.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((InitiatingProcessFolderPath endswith "\\WINWORD.EXE" or InitiatingProcessFolderPath endswith "\\EXCEL.EXE" or InitiatingProcessFolderPath endswith "\\POWERPNT.exe" or InitiatingProcessFolderPath endswith "\\MSPUB.exe" or InitiatingProcessFolderPath endswith "\\VISIO.exe" or InitiatingProcessFolderPath endswith "\\MSACCESS.exe" or InitiatingProcessFolderPath endswith "\\EQNEDT32.exe") and FolderPath startswith "C:\\users\\" and FolderPath endswith ".exe") and (not(FolderPath endswith "\\Teams.exe"))
