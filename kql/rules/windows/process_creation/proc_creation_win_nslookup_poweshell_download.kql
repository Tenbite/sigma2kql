// Title: Nslookup PowerShell Download Cradle - ProcessCreation
// Sigma ID: 1b3b01c7-84e9-4072-86e5-fc285a41ff23
// Status: test | Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-05 | Modified: 2026-10-13
// ATT&CK: command-and-control, T1071.004
// Description: Detects suspicious powershell download cradle using nslookup. This cradle uses nslookup to
//   extract payloads from DNS records
// False positives:
//   - Unknown
// References:
//   - https://twitter.com/Alh4zr3d/status/1566489367232651264
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/process_creation/proc_creation_win_nslookup_poweshell_download.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (FolderPath endswith "\\nslookup.exe" or ProcessVersionInfoOriginalFileName =~ "nslookup.exe") and ((InitiatingProcessFolderPath endswith "\\powershell.exe" or InitiatingProcessFolderPath endswith "\\pwsh.exe") and (ProcessCommandLine contains " -q=txt " or ProcessCommandLine contains " -querytype=txt " or ProcessCommandLine contains " -type=txt"))
