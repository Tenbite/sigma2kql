// Title: DumpMinitool Execution
// Sigma ID: dee0a7a3-f200-4112-a99b-952196d81e42
// Status: test | Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), Florian Roth (Nextron Systems)
// Date: 2022-04-06 | Modified: 2023-04-12
// ATT&CK: stealth, T1036, T1003.001, credential-access
// Description: Detects the use of "DumpMinitool.exe" a tool that allows the dump of process memory via the use
//   of the "MiniDumpWriteDump"
// False positives:
//   - Unknown
// References:
//   - https://twitter.com/mrd0x/status/1511415432888131586
//   - https://twitter.com/mrd0x/status/1511489821247684615
//   - https://lolbas-project.github.io/lolbas/OtherMSBinaries/DumpMinitool/
//   - https://gist.github.com/nasbench/6d58c3c125e2fa1b8f7a09754c1b087f
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/process_creation/proc_creation_win_dumpminitool_execution.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\DumpMinitool.exe" or FolderPath endswith "\\DumpMinitool.x86.exe" or FolderPath endswith "\\DumpMinitool.arm64.exe") or (ProcessVersionInfoOriginalFileName in~ ("DumpMinitool.exe", "DumpMinitool.x86.exe", "DumpMinitool.arm64.exe"))) and (ProcessCommandLine contains " Full" or ProcessCommandLine contains " Mini" or ProcessCommandLine contains " WithHeap")
