// Title: Suspicious Advpack Call Via Rundll32.EXE
// Sigma ID: a1473adb-5338-4a20-b4c3-126763e2d3d3
// Status: test | Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-17 | Modified: -
// ATT&CK: stealth
// Description: Detects execution of "rundll32" calling "advpack.dll" with potential obfuscated ordinal calls in
//   order to leverage the "RegisterOCX" function
// False positives:
//   - Unlikely
// References:
//   - https://twitter.com/Hexacorn/status/1224848930795552769
//   - http://www.hexacorn.com/blog/2020/02/05/stay-positive-lolbins-not/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_rundll32_advpack_obfuscated_ordinal_call.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where (FolderPath endswith "\\rundll32.exe" or ProcessVersionInfoOriginalFileName =~ "RUNDLL32.EXE" or ProcessCommandLine contains "rundll32") and ProcessCommandLine contains "advpack" and ((ProcessCommandLine contains "#+" and ProcessCommandLine contains "12") or ProcessCommandLine contains "#-")
