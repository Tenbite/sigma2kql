// Title: Suspicious Download From File-Sharing Website Via Bitsadmin
// Sigma ID: 8518ed3d-f7c9-4601-a26c-f361a4256a0c
// Status: test | Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-06-28 | Modified: 2026-03-29
// ATT&CK: persistence, execution, stealth, T1197, S0190, T1036.003, command-and-control, T1105
// Description: Detects usage of bitsadmin downloading a file from a suspicious domain
// False positives:
//   - Some legitimate apps use this, but limited.
// References:
//   - https://blog.netspi.com/15-ways-to-download-a-file/#bitsadmin
//   - https://isc.sans.edu/diary/22264
//   - https://lolbas-project.github.io/lolbas/Binaries/Bitsadmin/
//   - https://symantec-enterprise-blogs.security.com/blogs/threat-intelligence/ransomware-hive-conti-avoslocker
//   - https://www.cisa.gov/uscert/ncas/alerts/aa22-321a
//   - https://www.microsoft.com/en-us/security/blog/2024/01/17/new-ttps-observed-in-mint-sandstorm-campaign-targeting-high-profile-individuals-at-universities-and-research-orgs/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules/windows/process_creation/proc_creation_win_bitsadmin_download_file_sharing_domains.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (FolderPath endswith "\\bitsadmin.exe" or ProcessVersionInfoOriginalFileName =~ "bitsadmin.exe") and (ProcessCommandLine contains " /transfer " or ProcessCommandLine contains " /create " or ProcessCommandLine contains " /addfile ") and (ProcessCommandLine contains ".githubusercontent.com" or ProcessCommandLine contains "0x0.st" or ProcessCommandLine contains "anonfiles.com" or ProcessCommandLine contains "bashupload.com" or ProcessCommandLine contains "cdn.discordapp.com" or ProcessCommandLine contains "chunk.io" or ProcessCommandLine contains "ddns.net" or ProcessCommandLine contains "dl.dropboxusercontent.com" or ProcessCommandLine contains "ghostbin.co" or ProcessCommandLine contains "github.com" or ProcessCommandLine contains "glitch.me" or ProcessCommandLine contains "gofile.io" or ProcessCommandLine contains "hastebin.com" or ProcessCommandLine contains "mediafire.com" or ProcessCommandLine contains "mega.nz" or ProcessCommandLine contains "onrender.com" or ProcessCommandLine contains "pages.dev" or ProcessCommandLine contains "paste.ee" or ProcessCommandLine contains "pastebin.com" or ProcessCommandLine contains "pastebin.pl" or ProcessCommandLine contains "pastetext.net" or ProcessCommandLine contains "privatlab.com" or ProcessCommandLine contains "privatlab.net" or ProcessCommandLine contains "send.exploit.in" or ProcessCommandLine contains "sendspace.com" or ProcessCommandLine contains "storage.googleapis.com" or ProcessCommandLine contains "storjshare.io" or ProcessCommandLine contains "supabase.co" or ProcessCommandLine contains "temp.sh" or ProcessCommandLine contains "transfer.sh" or ProcessCommandLine contains "trycloudflare.com" or ProcessCommandLine contains "ufile.io" or ProcessCommandLine contains "w3spaces.com" or ProcessCommandLine contains "workers.dev" or ProcessCommandLine contains "x0.at")
