// Title: Uncommon Svchost Parent Process
// Sigma ID: 01d2e2a1-5f09-44f7-9fc1-24faa7479b6d
// Status: test | Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2017-08-15 | Modified: 2026-10-19
// ATT&CK: stealth, T1036.005
// Description: Detects an uncommon svchost parent process
// False positives:
//   - Unknown
// References:
//   - Internal Research
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules/windows/process_creation/proc_creation_win_svchost_uncommon_parent_process.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where FolderPath endswith "\\svchost.exe" and (not(((InitiatingProcessFolderPath endswith "\\Mrt.exe" or InitiatingProcessFolderPath endswith "\\MsMpEng.exe" or InitiatingProcessFolderPath endswith "\\ngen.exe" or InitiatingProcessFolderPath endswith "\\rpcnet.exe" or InitiatingProcessFolderPath endswith "\\services.exe" or InitiatingProcessFolderPath endswith "\\TiWorker.exe") or (InitiatingProcessFolderPath endswith "\\svchost.exe" and (ProcessCommandLine endswith "svchost.exe\"" or ProcessCommandLine endswith "svchost.exe" or ProcessCommandLine endswith "-k TSLicensing")) or isnull(InitiatingProcessFolderPath) or (InitiatingProcessFolderPath in~ ("-", "")))))
