// Title: Operator Bloopers Cobalt Strike Modules
// Sigma ID: 4f154fb6-27d1-4813-a759-78b93e0b9c48
// Status: test | Level: high
// Author: _pete_0, TheDFIRReport
// Date: 2022-05-06 | Modified: 2023-01-30
// ATT&CK: execution, T1059.003
// Description: Detects Cobalt Strike module/commands accidentally entered in CMD shell
// False positives:
//   - Unknown
// References:
//   - https://hstechdocs.helpsystems.com/manuals/cobaltstrike/current/userguide/content/cobalt-4-5-user-guide.pdf
//   - https://thedfirreport.com/2021/10/04/bazarloader-and-the-conti-leaks/
//   - https://thedfirreport.com/2022/06/16/sans-ransomware-summit-2022-can-you-detect-this/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_hktl_cobaltstrike_bloopers_modules.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where (ProcessVersionInfoOriginalFileName =~ "Cmd.Exe" or FolderPath endswith "\\cmd.exe") and (ProcessCommandLine contains "Invoke-UserHunter" or ProcessCommandLine contains "Invoke-ShareFinder" or ProcessCommandLine contains "Invoke-Kerberoast" or ProcessCommandLine contains "Invoke-SMBAutoBrute" or ProcessCommandLine contains "Invoke-Nightmare" or ProcessCommandLine contains "zerologon" or ProcessCommandLine contains "av_query")
