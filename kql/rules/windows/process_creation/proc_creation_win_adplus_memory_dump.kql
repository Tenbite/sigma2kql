// Title: Potential Adplus.EXE Abuse
// Sigma ID: 2f869d59-7f6a-4931-992c-cce556ff2d53
// Status: test | Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-09 | Modified: 2023-06-23
// ATT&CK: execution, credential-access, T1003.001
// Description: Detects execution of "AdPlus.exe", a binary that is part of the Windows SDK that can be used as
//   a LOLBIN in order to dump process memory and execute arbitrary commands.
// False positives:
//   - Legitimate usage of Adplus for debugging purposes
// References:
//   - https://lolbas-project.github.io/lolbas/OtherMSBinaries/Adplus/
//   - https://twitter.com/nas_bench/status/1534916659676422152
//   - https://twitter.com/nas_bench/status/1534915321856917506
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_adplus_memory_dump.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where (FolderPath endswith "\\adplus.exe" or ProcessVersionInfoOriginalFileName =~ "Adplus.exe") and (ProcessCommandLine contains " -hang " or ProcessCommandLine contains " -pn " or ProcessCommandLine contains " -pmn " or ProcessCommandLine contains " -p " or ProcessCommandLine contains " -po " or ProcessCommandLine contains " -c " or ProcessCommandLine contains " -sc ")
