// Title: Gpscript Execution
// Sigma ID: 1e59c230-6670-45bf-83b0-98903780607e
// Status: test | Level: medium
// Author: frack113
// Date: 2022-05-16 | Modified: 2023-06-14
// ATT&CK: stealth, T1218
// Description: Detects the execution of the LOLBIN gpscript, which executes logon or startup scripts configured
//   in Group Policy
// False positives:
//   - Legitimate uses of logon scripts distributed via group policy
// References:
//   - https://oddvar.moe/2018/04/27/gpscript-exe-another-lolbin-to-the-list/
//   - https://lolbas-project.github.io/lolbas/Binaries/Gpscript/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_lolbin_gpscript.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where ((FolderPath endswith "\\gpscript.exe" or ProcessVersionInfoOriginalFileName =~ "GPSCRIPT.EXE") and (ProcessCommandLine contains " /logon" or ProcessCommandLine contains " /startup")) and (not(InitiatingProcessCommandLine =~ "C:\\windows\\system32\\svchost.exe -k netsvcs -p -s gpsvc"))
