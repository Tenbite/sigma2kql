// Title: Potentially Suspicious Execution Of Regasm/Regsvcs With Uncommon Extension
// Sigma ID: e9f8f8cc-07cc-4e81-b724-f387db9175e4
// Status: test | Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-13 | Modified: -
// ATT&CK: stealth, T1218.009
// Description: Detects potentially suspicious execution of the Regasm/Regsvcs utilities with an uncommon
//   extension.
// False positives:
//   - Unknown
// References:
//   - https://www.fortiguard.com/threat-signal-report/4718?s=09
//   - https://lolbas-project.github.io/lolbas/Binaries/Regasm/
//   - https://lolbas-project.github.io/lolbas/Binaries/Regsvcs/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/process_creation/proc_creation_win_regasm_regsvcs_uncommon_extension_execution.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\Regsvcs.exe" or FolderPath endswith "\\Regasm.exe") or (ProcessVersionInfoOriginalFileName in~ ("RegSvcs.exe", "RegAsm.exe"))) and (ProcessCommandLine contains ".dat" or ProcessCommandLine contains ".gif" or ProcessCommandLine contains ".jpeg" or ProcessCommandLine contains ".jpg" or ProcessCommandLine contains ".png" or ProcessCommandLine contains ".txt")
