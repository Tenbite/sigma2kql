// Title: Add Windows Capability Via PowerShell Cmdlet
// Sigma ID: b36d01a3-ddaf-4804-be18-18a6247adfcd
// Status: test | Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-22 | Modified: 2023-05-09
// ATT&CK: execution
// Description: Detects usage of the "Add-WindowsCapability" cmdlet to add Windows capabilities. Notable
//   capabilities could be "OpenSSH" and others.
// False positives:
//   - Legitimate usage of the capabilities by administrators or users. Add additional filters accordingly.
// References:
//   - https://learn.microsoft.com/en-us/windows-server/administration/openssh/openssh_install_firstuse?tabs=powershell
//   - https://www.virustotal.com/gui/file/af1c82237b6e5a3a7cdbad82cc498d298c67845d92971bada450023d1335e267/content
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_powershell_add_windows_capability.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") or (ProcessVersionInfoOriginalFileName in~ ("PowerShell.EXE", "pwsh.dll"))) and ProcessCommandLine contains "Add-WindowsCapability" and ProcessCommandLine contains "OpenSSH."
