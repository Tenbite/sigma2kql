// Title: Tor Client/Browser Execution
// Sigma ID: 62f7c9bf-9135-49b2-8aeb-1e54a6ecc13c
// Status: test | Level: high
// Author: frack113
// Date: 2022-02-20 | Modified: 2025-10-27
// ATT&CK: command-and-control, T1090.003
// Description: Detects the use of Tor or Tor-Browser to connect to onion routing networks
// False positives:
//   - Unknown
// References:
//   - https://web.archive.org/web/20260310035047/https://www.logpoint.com/en/blog/detecting-tor-use-with-logpoint/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/d7c9da10c170a6988d68ebdf2c9f7bd8782b7c55/rules/windows/process_creation/proc_creation_win_browsers_tor_execution.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ProcessVersionInfoFileDescription =~ "Tor Browser" or ProcessVersionInfoProductName =~ "Tor Browser" or (FolderPath endswith "\\tor.exe" or FolderPath endswith "\\Tor Browser\\Browser\\firefox.exe")
