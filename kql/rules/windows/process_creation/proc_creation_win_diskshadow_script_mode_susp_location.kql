// Title: Diskshadow Script Mode - Execution From Potential Suspicious Location
// Sigma ID: fa1a7e52-3d02-435b-81b8-00da14dd66c1
// Status: test | Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-09-15 | Modified: 2024-03-05
// ATT&CK: stealth, T1218
// Description: Detects execution of "Diskshadow.exe" in script mode using the "/s" flag where the script is
//   located in a potentially suspicious location.
// False positives:
//   - False positives may occur if you execute the script from one of the paths mentioned in the rule. Apply additional filters that fits your org needs.
// References:
//   - https://bohops.com/2018/03/26/diskshadow-the-return-of-vss-evasion-persistence-and-active-directory-database-extraction/
//   - https://www.ired.team/offensive-security/credential-access-and-credential-dumping/ntds.dit-enumeration
//   - https://medium.com/@cyberjyot/lolbin-execution-via-diskshadow-f6ff681a27a4
//   - https://learn.microsoft.com/en-us/windows-server/administration/windows-commands/diskshadow
//   - https://www.lifars.com/wp-content/uploads/2022/01/GriefRansomware_Whitepaper-2.pdf
//   - https://www.zscaler.com/blogs/security-research/technical-analysis-crytox-ransomware
//   - https://research.checkpoint.com/2022/evilplayout-attack-against-irans-state-broadcaster/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules/windows/process_creation/proc_creation_win_diskshadow_script_mode_susp_location.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (ProcessVersionInfoOriginalFileName =~ "diskshadow.exe" or FolderPath endswith "\\diskshadow.exe") and (ProcessCommandLine contains "-s " or ProcessCommandLine contains "/s " or ProcessCommandLine contains "–s " or ProcessCommandLine contains "—s " or ProcessCommandLine contains "―s ") and (ProcessCommandLine contains ":\\Temp\\" or ProcessCommandLine contains ":\\Windows\\Temp\\" or ProcessCommandLine contains "\\AppData\\Local\\" or ProcessCommandLine contains "\\AppData\\Roaming\\" or ProcessCommandLine contains "\\ProgramData\\" or ProcessCommandLine contains "\\Users\\Public\\")
