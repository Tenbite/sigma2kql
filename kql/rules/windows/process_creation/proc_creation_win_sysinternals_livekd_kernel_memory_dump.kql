// Title: Kernel Memory Dump Via LiveKD
// Sigma ID: c7746f1c-47d3-43d6-8c45-cd1e54b6b0a2
// Status: test | Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-16 | Modified: 2024-03-13
// ATT&CK: stealth
// Description: Detects execution of LiveKD with the "-m" flag to potentially dump the kernel memory
// False positives:
//   - Unlikely in production environment
// References:
//   - https://learn.microsoft.com/en-us/sysinternals/downloads/livekd
//   - https://4sysops.com/archives/creating-a-complete-memory-dump-without-a-blue-screen/
//   - https://kb.acronis.com/content/60892
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_sysinternals_livekd_kernel_memory_dump.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where ((FolderPath endswith "\\livekd.exe" or FolderPath endswith "\\livekd64.exe") or ProcessVersionInfoOriginalFileName =~ "livekd.exe") and (ProcessCommandLine contains " -m" or ProcessCommandLine contains " /m" or ProcessCommandLine contains " –m" or ProcessCommandLine contains " —m" or ProcessCommandLine contains " ―m")
