// Title: Execute Code with Pester.bat
// Sigma ID: 59e938ff-0d6d-4dc3-b13f-36cc28734d4e
// Status: test | Level: medium
// Author: Julia Fomina, oscd.community
// Date: 2020-10-08 | Modified: 2023-11-09
// ATT&CK: execution, stealth, T1059.001, T1216
// Description: Detects code execution via Pester.bat (Pester - Powershell Modulte for testing)
// False positives:
//   - Legitimate use of Pester for writing tests for Powershell scripts and modules
// References:
//   - https://twitter.com/Oddvarmoe/status/993383596244258816
//   - https://github.com/api0cradle/LOLBAS/blob/d148d278f5f205ce67cfaf49afdfb68071c7252a/OSScripts/pester.md
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_lolbin_pester_1.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where ((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") and (ProcessCommandLine contains "Pester" and ProcessCommandLine contains "Get-Help")) or ((FolderPath endswith "\\cmd.exe" and (ProcessCommandLine contains "pester" and ProcessCommandLine contains ";")) and (ProcessCommandLine contains "help" or ProcessCommandLine contains "?"))
