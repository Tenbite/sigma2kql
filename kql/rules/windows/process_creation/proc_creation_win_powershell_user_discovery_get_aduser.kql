// Title: User Discovery And Export Via Get-ADUser Cmdlet
// Sigma ID: 1114e048-b69c-4f41-bc20-657245ae6e3f
// Status: test | Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-09 | Modified: 2022-11-17
// ATT&CK: discovery, T1033
// Description: Detects usage of the Get-ADUser cmdlet to collect user information and output it to a file
// False positives:
//   - Legitimate admin scripts may use the same technique, it's better to exclude specific computers or users who execute these commands or scripts often
// References:
//   - http://blog.talosintelligence.com/2022/09/lazarus-three-rats.html
//   - https://www.microsoft.com/en-us/security/blog/2022/10/18/defenders-beware-a-case-for-post-ransomware-investigations/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_powershell_user_discovery_get_aduser.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where ((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") or (ProcessVersionInfoOriginalFileName in~ ("PowerShell.EXE", "pwsh.dll"))) and ((ProcessCommandLine contains "Get-ADUser " and ProcessCommandLine contains " -Filter *") and (ProcessCommandLine contains " > " or ProcessCommandLine contains " | Select " or ProcessCommandLine contains "Out-File" or ProcessCommandLine contains "Set-Content" or ProcessCommandLine contains "Add-Content"))
