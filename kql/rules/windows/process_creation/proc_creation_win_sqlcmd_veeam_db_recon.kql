// Title: Veeam Backup Database Suspicious Query
// Sigma ID: 696bfb54-227e-4602-ac5b-30d9d2053312
// Status: test | Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-04 | Modified: -
// ATT&CK: collection, T1005
// Description: Detects potentially suspicious SQL queries using SQLCmd targeting the Veeam backup databases in
//   order to steal information.
// False positives:
//   - Unknown
// References:
//   - https://labs.withsecure.com/publications/fin7-target-veeam-servers
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/process_creation/proc_creation_win_sqlcmd_veeam_db_recon.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (FolderPath endswith "\\sqlcmd.exe" and (ProcessCommandLine contains "VeeamBackup" and ProcessCommandLine contains "From ")) and (ProcessCommandLine contains "BackupRepositories" or ProcessCommandLine contains "Backups" or ProcessCommandLine contains "Credentials" or ProcessCommandLine contains "HostCreds" or ProcessCommandLine contains "SmbFileShares" or ProcessCommandLine contains "Ssh_creds" or ProcessCommandLine contains "VSphereInfo")
