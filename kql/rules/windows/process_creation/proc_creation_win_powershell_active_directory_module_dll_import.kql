// Title: Potential Active Directory Enumeration Using AD Module - ProcCreation
// Sigma ID: 70bc5215-526f-4477-963c-a47a5c9ebd12
// Status: test | Level: medium
// Author: frack113
// Date: 2023-01-22 | Modified: -
// ATT&CK: reconnaissance, discovery, impact
// Description: Detects usage of the "Import-Module" cmdlet to load the
//   "Microsoft.ActiveDirectory.Management.dl" DLL. Which is often used by attackers to perform AD
//   enumeration.
// False positives:
//   - Legitimate use of the library for administrative activity
// References:
//   - https://github.com/samratashok/ADModule
//   - https://twitter.com/cyb3rops/status/1617108657166061568?s=20
//   - https://www.ired.team/offensive-security-experiments/active-directory-kerberos-abuse/active-directory-enumeration-with-ad-module-without-rsat-or-admin-privileges
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_powershell_active_directory_module_dll_import.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where ((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") or (ProcessVersionInfoOriginalFileName in~ ("PowerShell.EXE", "pwsh.dll"))) and (ProcessCommandLine contains "Import-Module " or ProcessCommandLine contains "ipmo ") and ProcessCommandLine contains "Microsoft.ActiveDirectory.Management.dll"
