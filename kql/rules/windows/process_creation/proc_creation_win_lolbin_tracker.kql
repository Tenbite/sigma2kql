// Title: Potential DLL Injection Or Execution Using Tracker.exe
// Sigma ID: 148431ce-4b70-403d-8525-fcc2993f29ea
// Status: test | Level: medium
// Author: Avneet Singh @v3t0_, oscd.community
// Date: 2020-10-18 | Modified: 2023-01-09
// ATT&CK: privilege-escalation, stealth, T1055.001
// Description: Detects potential DLL injection and execution using "Tracker.exe"
// False positives:
//   - Unknown
// References:
//   - https://lolbas-project.github.io/lolbas/OtherMSBinaries/Tracker/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_lolbin_tracker.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\tracker.exe" or ProcessVersionInfoFileDescription =~ "Tracker") and (ProcessCommandLine contains " /d " or ProcessCommandLine contains " /c ")) and (not((ProcessCommandLine contains " /ERRORREPORT:PROMPT " or (InitiatingProcessFolderPath endswith "\\Msbuild\\Current\\Bin\\MSBuild.exe" or InitiatingProcessFolderPath endswith "\\Msbuild\\Current\\Bin\\amd64\\MSBuild.exe"))))
