// Title: New User Created Via Net.EXE
// Sigma ID: cd219ff3-fa99-45d4-8380-a7d15116c6dc
// Status: test | Level: medium
// Author: Endgame, JHasenbusch (adapted to Sigma for oscd.community)
// Date: 2018-10-30 | Modified: 2023-02-21
// ATT&CK: persistence, T1136.001
// Description: Identifies the creation of local users via the net.exe command.
// False positives:
//   - Legitimate user creation.
//   - Better use event IDs for user creation rather than command line rules.
// References:
//   - https://eqllib.readthedocs.io/en/latest/analytics/014c3f51-89c6-40f1-ac9c-5688f26090ab.html
//   - https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1136.001/T1136.001.md
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/process_creation/proc_creation_win_net_user_add.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\net.exe" or FolderPath endswith "\\net1.exe") or (ProcessVersionInfoOriginalFileName in~ ("net.exe", "net1.exe"))) and (ProcessCommandLine contains "user" and ProcessCommandLine contains "add")
