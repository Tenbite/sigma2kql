// Title: Whoami.EXE Execution With Output Option
// Sigma ID: c30fb093-1109-4dc8-88a8-b30d11c95a5d
// Status: test | Level: medium
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-28 | Modified: 2023-12-04
// ATT&CK: discovery, T1033
// Tags: car.2016-03-001
// Description: Detects the execution of "whoami.exe" with the "/FO" flag to choose CSV as output format or with
//   redirection options to export the results to a file for later use.
// False positives:
//   - Unknown
// References:
//   - https://brica.de/alerts/alert/public/1247926/agent-tesla-keylogger-delivered-inside-a-power-iso-daa-archive/
//   - https://app.any.run/tasks/7eaba74e-c1ea-400f-9c17-5e30eee89906/
//   - https://www.youtube.com/watch?v=DsJ9ByX84o4&t=6s
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_whoami_output.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where ((FolderPath endswith "\\whoami.exe" or ProcessVersionInfoOriginalFileName =~ "whoami.exe") and (ProcessCommandLine contains " /FO CSV" or ProcessCommandLine contains " -FO CSV")) or ProcessCommandLine matches regex ".*whoami.*>.*"
