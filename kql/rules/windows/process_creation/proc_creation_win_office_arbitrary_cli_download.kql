// Title: Potential Arbitrary File Download Using Office Application
// Sigma ID: 4ae3e30b-b03f-43aa-87e3-b622f4048eed
// Status: test | Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), Beyu Denis, oscd.community
// Date: 2022-05-17 | Modified: 2026-09-25
// ATT&CK: stealth, T1202
// Description: Detects potential arbitrary file download using a Microsoft Office application
// False positives:
//   - Unknown
// References:
//   - https://lolbas-project.github.io/lolbas/OtherMSBinaries/Winword/
//   - https://lolbas-project.github.io/lolbas/OtherMSBinaries/Powerpnt/
//   - https://lolbas-project.github.io/lolbas/OtherMSBinaries/Excel/
//   - https://lolbas-project.github.io/lolbas/Binaries/Msoxmled/
//   - https://medium.com/@reegun/unsanitized-file-validation-leads-to-malicious-payload-download-via-office-binaries-202d02db7191
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules/windows/process_creation/proc_creation_win_office_arbitrary_cli_download.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\EXCEL.EXE" or FolderPath endswith "\\MSOXMLED.EXE" or FolderPath endswith "\\POWERPNT.EXE" or FolderPath endswith "\\WINWORD.exe") or (ProcessVersionInfoOriginalFileName in~ ("Excel.exe", "msoxmled.exe", "POWERPNT.EXE", "WinWord.exe"))) and (ProcessCommandLine contains "http://" or ProcessCommandLine contains "https://")
