// Title: Invoke-Obfuscation VAR+ Launcher
// Sigma ID: 27aec9c9-dbb0-4939-8422-1742242471d0
// Status: test | Level: high
// Author: Jonathan Cheong, oscd.community
// Date: 2020-10-15 | Modified: 2024-04-15
// ATT&CK: stealth, T1027, execution, T1059.001
// Description: Detects Obfuscated use of Environment Variables to execute PowerShell
// False positives:
//   - Unknown
// References:
//   - https://github.com/SigmaHQ/sigma/issues/1009
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_hktl_invoke_obfuscation_var.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ProcessCommandLine matches regex "cmd.{0,5}(?:/c|/r)(?:\\s|)\\\"set\\s[a-zA-Z]{3,6}.*(?:\\{\\d\\}){1,}\\\\\\\"\\s+?\\-f(?:.*\\)){1,}.*\\\""
