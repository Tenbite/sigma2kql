// Title: Changing Existing Service ImagePath Value Via Reg.EXE
// Sigma ID: 9b0b7ac3-6223-47aa-a3fd-e8f211e637db
// Status: test | Level: medium
// Author: frack113
// Date: 2021-12-30 | Modified: 2024-03-13
// ATT&CK: privilege-escalation, persistence, execution, stealth, T1574.011
// Description: Adversaries may execute their own malicious payloads by hijacking the Registry entries used by
//   services. Adversaries may use flaws in the permissions for registry to redirect from the
//   originally specified executable to one that they control, in order to launch their own code at
//   Service start. Windows stores local service configuration information in the Registry under
//   HKLM\SYSTEM\CurrentControlSet\Services
// False positives:
//   - Unknown
// References:
//   - https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1574.011/T1574.011.md#atomic-test-2---service-imagepath-change-with-regexe
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules/windows/process_creation/proc_creation_win_reg_service_imagepath_change.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (FolderPath endswith "\\reg.exe" and (ProcessCommandLine contains "add " and ProcessCommandLine contains "SYSTEM\\CurrentControlSet\\Services\\" and ProcessCommandLine contains " ImagePath ")) and (ProcessCommandLine contains " -d " or ProcessCommandLine contains " /d " or ProcessCommandLine contains " –d " or ProcessCommandLine contains " —d " or ProcessCommandLine contains " ―d ")
