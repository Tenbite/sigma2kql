// Title: Computer Discovery And Export Via Get-ADComputer Cmdlet
// Sigma ID: 435e10e4-992a-4281-96f3-38b11106adde
// Status: test | Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-11-10 | Modified: 2022-11-17
// ATT&CK: discovery, T1033
// Description: Detects usage of the Get-ADComputer cmdlet to collect computer information and output it to a
//   file
// False positives:
//   - Legitimate admin scripts may use the same technique, it's better to exclude specific computers or users who execute these commands or scripts often
// References:
//   - http://blog.talosintelligence.com/2022/09/lazarus-three-rats.html
//   - https://www.microsoft.com/en-us/security/blog/2022/10/18/defenders-beware-a-case-for-post-ransomware-investigations/
//   - https://www.cisa.gov/uscert/sites/default/files/publications/aa22-320a_joint_csa_iranian_government-sponsored_apt_actors_compromise_federal%20network_deploy_crypto%20miner_credential_harvester.pdf
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_powershell_computer_discovery_get_adcomputer.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where ((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") or (ProcessVersionInfoOriginalFileName in~ ("PowerShell.EXE", "pwsh.dll"))) and ((ProcessCommandLine contains "Get-ADComputer " and ProcessCommandLine contains " -Filter *") and (ProcessCommandLine contains " > " or ProcessCommandLine contains " | Select " or ProcessCommandLine contains "Out-File" or ProcessCommandLine contains "Set-Content" or ProcessCommandLine contains "Add-Content"))
