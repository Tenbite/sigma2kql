// Title: Execution Of Non-Existing File
// Sigma ID: 71158e3f-df67-472b-930e-7d287acaa3e1
// Status: test | Level: high
// Author: Max Altgelt (Nextron Systems)
// Date: 2021-12-09 | Modified: 2026-07-05
// ATT&CK: stealth, privilege-escalation, T1055
// Description: Detects process creation events where the Image field lacks an absolute path, which occurs when
//   the backing file no longer exists on disk at the time of logging - commonly caused by Process
//   Ghosting or other unorthodox process creation techniques.
// False positives:
//   - Unknown
// References:
//   - https://pentestlaboratories.com/2021/12/08/process-ghosting/
//   - https://www.elastic.co/blog/process-ghosting-a-new-executable-image-tampering-attack
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_susp_image_missing.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where (not(FolderPath contains "\\")) and (not((isnull(FolderPath) or (FolderPath in~ ("-", "")) or ((FolderPath in~ ("MemCompression", "Registry", "System", "vmmem", "vmmemWSL")) or (ProcessCommandLine in~ ("MemCompression", "Registry", "vmmem", "vmmemWSL"))))))
