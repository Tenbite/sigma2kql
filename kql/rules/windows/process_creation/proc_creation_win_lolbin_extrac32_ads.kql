// Title: Suspicious Extrac32 Alternate Data Stream Execution
// Sigma ID: 4b13db67-0c45-40f1-aba8-66a1a7198a1e
// Status: test | Level: medium
// Author: frack113
// Date: 2021-11-26 | Modified: 2022-12-30
// ATT&CK: stealth, T1564.004
// Description: Extract data from cab file and hide it in an alternate data stream
// False positives:
//   - Unknown
// References:
//   - https://lolbas-project.github.io/lolbas/Binaries/Extrac32/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_lolbin_extrac32_ads.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where (ProcessCommandLine contains "extrac32.exe" and ProcessCommandLine contains ".cab") and ProcessCommandLine matches regex ":[^\\\\]"
