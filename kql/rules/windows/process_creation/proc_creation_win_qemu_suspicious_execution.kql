// Title: Potentially Suspicious Usage Of Qemu
// Sigma ID: 5fc297ae-25b6-488a-8f25-cc12ac29b744
// Status: test | Level: medium
// Author: Muhammad Faisal (@faisalusuf), Hunter Juhan (@threatHNTR)
// Date: 2024-06-03 | Modified: -
// ATT&CK: command-and-control, T1090, T1572
// Description: Detects potentially suspicious execution of the Qemu utility in a Windows environment. Threat
//   actors have leveraged this utility and this technique for achieving network access as reported
//   by Kaspersky.
// False positives:
//   - Unknown
// References:
//   - https://securelist.com/network-tunneling-with-qemu/111803/
//   - https://www.qemu.org/docs/master/system/invocation.html#hxtool-5
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_qemu_suspicious_execution.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where ((ProcessCommandLine contains "-m 1M" or ProcessCommandLine contains "-m 2M" or ProcessCommandLine contains "-m 3M") and (ProcessCommandLine contains "restrict=off" and ProcessCommandLine contains "-netdev " and ProcessCommandLine contains "connect=" and ProcessCommandLine contains "-nographic")) and (not((ProcessCommandLine contains " -cdrom " or ProcessCommandLine contains " type=virt " or ProcessCommandLine contains " -blockdev ")))
