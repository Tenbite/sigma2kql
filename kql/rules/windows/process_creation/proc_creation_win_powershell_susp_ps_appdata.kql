// Title: PowerShell Script Run in AppData
// Sigma ID: ac175779-025a-4f12-98b0-acdaeb77ea85
// Status: test | Level: medium
// Author: Florian Roth (Nextron Systems), Jonhnathan Ribeiro, oscd.community
// Date: 2019-01-09 | Modified: 2022-07-14
// ATT&CK: execution, T1059.001
// Description: Detects a suspicious command line execution that invokes PowerShell with reference to an AppData
//   folder
// False positives:
//   - Administrative scripts
// References:
//   - https://twitter.com/JohnLaTwC/status/1082851155481288706
//   - https://app.any.run/tasks/f87f1c4e-47e2-4c46-9cf4-31454c06ce03
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_powershell_susp_ps_appdata.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where (ProcessCommandLine contains "powershell.exe" or ProcessCommandLine contains "\\powershell" or ProcessCommandLine contains "\\pwsh" or ProcessCommandLine contains "pwsh.exe") and ((ProcessCommandLine contains "/c " and ProcessCommandLine contains "\\AppData\\") and (ProcessCommandLine contains "Local\\" or ProcessCommandLine contains "Roaming\\"))
