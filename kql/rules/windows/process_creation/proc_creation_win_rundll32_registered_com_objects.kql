// Title: Rundll32 Registered COM Objects
// Sigma ID: f1edd233-30b5-4823-9e6a-c4171b24d316
// Status: test | Level: high
// Author: frack113
// Date: 2022-02-13 | Modified: 2023-02-09
// ATT&CK: privilege-escalation, persistence, T1546.015
// Description: load malicious registered COM objects
// False positives:
//   - Legitimate use
// References:
//   - https://nasbench.medium.com/a-deep-dive-into-rundll32-exe-642344b41e90
//   - https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1546.015/T1546.015.md
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_rundll32_registered_com_objects.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where (FolderPath endswith "\\rundll32.exe" or ProcessVersionInfoOriginalFileName =~ "RUNDLL32.EXE") and ((ProcessCommandLine contains "-sta " or ProcessCommandLine contains "-localserver ") and (ProcessCommandLine contains "{" and ProcessCommandLine contains "}"))
