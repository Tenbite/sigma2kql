// Title: Uncommon Child Processes Of SndVol.exe
// Sigma ID: ba42babc-0666-4393-a4f7-ceaf5a69191e
// Status: test | Level: medium
// Author: X__Junior (Nextron Systems)
// Date: 2023-06-09 | Modified: -
// ATT&CK: execution
// Description: Detects potentially uncommon child processes of SndVol.exe (the Windows volume mixer)
// False positives:
//   - Unknown
// References:
//   - https://twitter.com/Max_Mal_/status/1661322732456353792
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_sndvol_susp_child_processes.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where InitiatingProcessFolderPath endswith "\\SndVol.exe" and (not((FolderPath endswith "\\rundll32.exe" and ProcessCommandLine contains " shell32.dll,Control_RunDLL ")))
