// Title: Potential Command Line Path Traversal Evasion Attempt
// Sigma ID: 1327381e-6ab0-4f38-b583-4c1b8346a56b
// Status: test | Level: medium
// Author: Christian Burkard (Nextron Systems)
// Date: 2021-10-26 | Modified: 2023-03-29
// ATT&CK: stealth, T1036
// Description: Detects potential evasion or obfuscation attempts using bogus path traversal via the commandline
// False positives:
//   - Google Drive
//   - Citrix
// References:
//   - https://twitter.com/hexacorn/status/1448037865435320323
//   - https://twitter.com/Gal_B1t/status/1062971006078345217
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_susp_commandline_path_traversal_evasion.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where ((FolderPath contains "\\Windows\\" and (ProcessCommandLine contains "\\..\\Windows\\" or ProcessCommandLine contains "\\..\\System32\\" or ProcessCommandLine contains "\\..\\..\\")) or ProcessCommandLine contains ".exe\\..\\") and (not((ProcessCommandLine contains "\\Google\\Drive\\googledrivesync.exe\\..\\" or ProcessCommandLine contains "\\Citrix\\Virtual Smart Card\\Citrix.Authentication.VirtualSmartcard.Launcher.exe\\..\\")))
