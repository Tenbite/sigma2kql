// Title: File Download From IP Based URL Via CertOC.EXE
// Sigma ID: b86f6dea-0b2f-41f5-bdcc-a057bd19cd6a
// Status: test | Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-10-18 | Modified: -
// ATT&CK: command-and-control, execution, T1105
// Description: Detects when a user downloads a file from an IP based URL using CertOC.exe
// False positives:
//   - Unknown
// References:
//   - https://lolbas-project.github.io/lolbas/Binaries/Certoc/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_certoc_download_direct_ip.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (FolderPath endswith "\\certoc.exe" or ProcessVersionInfoOriginalFileName =~ "CertOC.exe") and ProcessCommandLine matches regex "://[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}" and ProcessCommandLine contains "-GetCACAPS"
