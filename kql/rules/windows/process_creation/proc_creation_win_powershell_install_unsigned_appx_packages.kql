// Title: Unsigned AppX Installation Attempt Using Add-AppxPackage
// Sigma ID: 37651c2a-42cd-4a69-ae0d-22a4349aa04a
// Status: test | Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-01-31 | Modified: -
// ATT&CK: persistence, stealth
// Description: Detects usage of the "Add-AppxPackage" or it's alias "Add-AppPackage" to install unsigned AppX
//   packages
// False positives:
//   - Installation of unsigned packages for testing purposes
// References:
//   - https://learn.microsoft.com/en-us/windows/msix/package/unsigned-package
//   - https://twitter.com/WindowsDocs/status/1620078135080325122
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_powershell_install_unsigned_appx_packages.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where ((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") or (ProcessVersionInfoOriginalFileName in~ ("PowerShell.EXE", "pwsh.dll"))) and (ProcessCommandLine contains "Add-AppPackage " or ProcessCommandLine contains "Add-AppxPackage ") and ProcessCommandLine contains " -AllowUnsigned"
