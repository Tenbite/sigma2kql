// Title: Renamed Sysinternals Sdelete Execution
// Sigma ID: c1d867fe-8d95-4487-aab4-e53f2d339f90
// Status: test | Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-09-06 | Modified: 2026-06-29
// ATT&CK: impact, T1485
// Description: Detects the use of a renamed SysInternals Sdelete, which is something an administrator shouldn't
//   do (the renaming)
// False positives:
//   - System administrator usage
// References:
//   - https://learn.microsoft.com/en-us/sysinternals/downloads/sdelete
//   - https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1485/T1485.md
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/process_creation/proc_creation_win_renamed_sysinternals_sdelete.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ProcessVersionInfoOriginalFileName =~ "sdelete.exe" and (not((FolderPath endswith "\\sdelete.exe" or FolderPath endswith "\\sdelete64.exe" or FolderPath endswith "\\sdelete64a.exe")))
