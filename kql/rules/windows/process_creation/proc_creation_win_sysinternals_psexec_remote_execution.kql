// Title: Potential PsExec Remote Execution
// Sigma ID: ea011323-7045-460b-b2d7-0f7442ea6b38
// Status: test | Level: high
// Author: Florian Roth (Nextron Systems), Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-28 | Modified: 2025-09-01
// ATT&CK: resource-development, T1587.001
// Description: Detects potential psexec command that initiate execution on a remote systems via common
//   commandline flags used by the utility
// False positives:
//   - Unknown
// References:
//   - https://learn.microsoft.com/en-us/sysinternals/downloads/psexec
//   - https://www.poweradmin.com/paexec/
//   - https://www.fireeye.com/blog/threat-research/2020/10/kegtap-and-singlemalt-with-a-ransomware-chaser.html
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_sysinternals_psexec_remote_execution.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where (ProcessCommandLine contains "accepteula" and ProcessCommandLine contains " -u " and ProcessCommandLine contains " -p " and ProcessCommandLine contains " \\\\") and (not((ProcessCommandLine contains "\\\\localhost" or ProcessCommandLine contains "\\\\127.")))
