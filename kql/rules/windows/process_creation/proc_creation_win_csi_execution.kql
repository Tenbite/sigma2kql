// Title: Suspicious Csi.exe Usage
// Sigma ID: 40b95d31-1afc-469e-8d34-9a3a667d058e
// Status: test | Level: medium
// Author: Konstantin Grishchenko, oscd.community
// Date: 2020-10-17 | Modified: 2022-07-11
// ATT&CK: lateral-movement, execution, stealth, T1072, T1218
// Description: Csi.exe is a signed binary from Microsoft that comes with Visual Studio and provides C#
//   interactive capabilities. It can be used to run C# code from a file passed as a parameter in
//   command line. Early version of this utility provided with Microsoft “Roslyn” Community
//   Technology Preview was named 'rcsi.exe'
// False positives:
//   - Legitimate usage by software developers
// References:
//   - https://lolbas-project.github.io/lolbas/OtherMSBinaries/Csi/
//   - https://lolbas-project.github.io/lolbas/OtherMSBinaries/Rcsi/
//   - https://enigma0x3.net/2016/11/21/bypassing-application-whitelisting-by-using-rcsi-exe/
//   - https://twitter.com/Z3Jpa29z/status/1317545798981324801
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules/windows/process_creation/proc_creation_win_csi_execution.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\csi.exe" or FolderPath endswith "\\rcsi.exe") or (ProcessVersionInfoOriginalFileName in~ ("csi.exe", "rcsi.exe"))) and ProcessVersionInfoCompanyName =~ "Microsoft Corporation"
