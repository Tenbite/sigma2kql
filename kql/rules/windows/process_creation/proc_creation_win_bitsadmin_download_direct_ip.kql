// Title: Suspicious Download From Direct IP Via Bitsadmin
// Sigma ID: 99c840f2-2012-46fd-9141-c761987550ef
// Status: test | Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-06-28 | Modified: 2023-02-15
// ATT&CK: persistence, execution, stealth, T1197, S0190, T1036.003
// Description: Detects usage of bitsadmin downloading a file using an URL that contains an IP
// False positives:
//   - Unknown
// References:
//   - https://blog.netspi.com/15-ways-to-download-a-file/#bitsadmin
//   - https://isc.sans.edu/diary/22264
//   - https://lolbas-project.github.io/lolbas/Binaries/Bitsadmin/
//   - https://blog.talosintelligence.com/breaking-the-silence-recent-truebot-activity/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/process_creation/proc_creation_win_bitsadmin_download_direct_ip.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\bitsadmin.exe" or ProcessVersionInfoOriginalFileName =~ "bitsadmin.exe") and (ProcessCommandLine contains " /transfer " or ProcessCommandLine contains " /create " or ProcessCommandLine contains " /addfile ") and (ProcessCommandLine contains "://1" or ProcessCommandLine contains "://2" or ProcessCommandLine contains "://3" or ProcessCommandLine contains "://4" or ProcessCommandLine contains "://5" or ProcessCommandLine contains "://6" or ProcessCommandLine contains "://7" or ProcessCommandLine contains "://8" or ProcessCommandLine contains "://9")) and (not(ProcessCommandLine contains "://7-"))
