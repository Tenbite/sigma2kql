// Title: HackTool - Quarks PwDump Execution
// Sigma ID: 0685b176-c816-4837-8e7b-1216f346636b
// Status: test | Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-09-05 | Modified: 2023-02-05
// ATT&CK: credential-access, T1003.002
// Description: Detects usage of the Quarks PwDump tool via commandline arguments
// False positives:
//   - Unlikely
// References:
//   - https://github.com/quarkslab/quarkspwdump
//   - https://symantec-enterprise-blogs.security.com/blogs/threat-intelligence/seedworm-apt-iran-middle-east
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_hktl_quarks_pwdump.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where FolderPath endswith "\\QuarksPwDump.exe" or (ProcessCommandLine in~ (" -dhl", " --dump-hash-local", " -dhdc", " --dump-hash-domain-cached", " --dump-bitlocker", " -dhd ", " --dump-hash-domain ", "--ntds-file"))
