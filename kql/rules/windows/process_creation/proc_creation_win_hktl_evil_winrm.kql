// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where FolderPath endswith "\\ruby.exe" and (ProcessCommandLine contains "-i " and ProcessCommandLine contains "-u " and ProcessCommandLine contains "-p ")
