// Title: Suspicious Response File Execution Via Odbcconf.EXE
// Sigma ID: 2d32dd6f-3196-4093-b9eb-1ad8ab088ca5
// Status: test | Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-22 | Modified: 2024-03-13
// ATT&CK: stealth, T1218.008
// Description: Detects execution of "odbcconf" with the "-f" flag in order to load a response file with a
//   non-".rsp" extension.
// False positives:
//   - Unlikely
// References:
//   - https://learn.microsoft.com/en-us/sql/odbc/odbcconf-exe?view=sql-server-ver16
//   - https://lolbas-project.github.io/lolbas/Binaries/Odbcconf/
//   - https://www.trendmicro.com/en_us/research/17/h/backdoor-carrying-emails-set-sights-on-russian-speaking-businesses.html
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules/windows/process_creation/proc_creation_win_odbcconf_response_file_susp.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\odbcconf.exe" or ProcessVersionInfoOriginalFileName =~ "odbcconf.exe") and (ProcessCommandLine contains " -f " or ProcessCommandLine contains " /f " or ProcessCommandLine contains " –f " or ProcessCommandLine contains " —f " or ProcessCommandLine contains " ―f ")) and (not((ProcessCommandLine contains ".rsp" or (InitiatingProcessFolderPath =~ "C:\\Windows\\System32\\runonce.exe" and FolderPath =~ "C:\\Windows\\System32\\odbcconf.exe" and ProcessCommandLine contains ".exe /E /F \"C:\\WINDOWS\\system32\\odbcconf.tmp\""))))
