// Title: Disabled IE Security Features
// Sigma ID: fb50eb7a-5ab1-43ae-bcc9-091818cb8424
// Status: test | Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2020-06-19 | Modified: 2021-11-27
// ATT&CK: defense-impairment, T1685
// Description: Detects command lines that indicate unwanted modifications to registry keys that disable
//   important Internet Explorer security features
// False positives:
//   - Unknown
// References:
//   - https://unit42.paloaltonetworks.com/operation-ke3chang-resurfaces-with-new-tidepool-malware/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_powershell_disable_ie_features.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where (ProcessCommandLine contains " -name IEHarden " and ProcessCommandLine contains " -value 0 ") or (ProcessCommandLine contains " -name DEPOff " and ProcessCommandLine contains " -value 1 ") or (ProcessCommandLine contains " -name DisableFirstRunCustomize " and ProcessCommandLine contains " -value 2 ")
