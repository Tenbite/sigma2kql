// Title: CobaltStrike Load by Rundll32
// Sigma ID: ae9c6a7c-9521-42a6-915e-5aaa8689d529
// Status: test | Level: high
// Author: Wojciech Lesicki
// Date: 2021-06-01 | Modified: 2022-09-16
// ATT&CK: stealth, T1218.011
// Description: Rundll32 can be use by Cobalt Strike with StartW function to load DLLs from the command line.
// False positives:
//   - Unknown
// References:
//   - https://www.cobaltstrike.com/help-windows-executable
//   - https://redcanary.com/threat-detection-report/
//   - https://thedfirreport.com/2020/10/18/ryuk-in-5-hours/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_hktl_cobaltstrike_load_by_rundll32.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where (FolderPath endswith "\\rundll32.exe" or ProcessVersionInfoOriginalFileName =~ "RUNDLL32.EXE" or (ProcessCommandLine contains "rundll32.exe" or ProcessCommandLine contains "rundll32 ")) and (ProcessCommandLine contains ".dll" and (ProcessCommandLine endswith " StartW" or ProcessCommandLine endswith ",StartW"))
