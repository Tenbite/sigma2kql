// Title: Uncommon FileSystem Load Attempt By Format.com
// Sigma ID: 9fb6b26e-7f9e-4517-a48b-8cac4a1b6c60
// Status: test | Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-01-04 | Modified: 2024-05-13
// ATT&CK: stealth
// Description: Detects the execution of format.com with an uncommon filesystem selection that could indicate a
//   defense evasion activity in which "format.com" is used to load malicious DLL files or other
//   programs.
// False positives:
//   - Unknown
// References:
//   - https://twitter.com/0gtweet/status/1477925112561209344
//   - https://twitter.com/wdormann/status/1478011052130459653?s=20
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_format_uncommon_filesystem_load.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (FolderPath endswith "\\format.com" and ProcessCommandLine contains "/fs:") and (not((ProcessCommandLine contains "/fs:exFAT" or ProcessCommandLine contains "/fs:FAT" or ProcessCommandLine contains "/fs:NTFS" or ProcessCommandLine contains "/fs:ReFS" or ProcessCommandLine contains "/fs:UDF")))
