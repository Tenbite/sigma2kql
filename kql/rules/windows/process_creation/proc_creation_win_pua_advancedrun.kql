// Title: PUA - AdvancedRun Execution
// Sigma ID: d2b749ee-4225-417e-b20e-a8d2193cbb84
// Status: test | Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2022-01-20 | Modified: 2023-02-21
// ATT&CK: execution, privilege-escalation, stealth, T1564.003, T1134.002, T1059.003
// Description: Detects the execution of AdvancedRun utility
// False positives:
//   - Unknown
// References:
//   - https://twitter.com/splinter_code/status/1483815103279603714
//   - https://medium.com/s2wblog/analysis-of-destructive-malware-whispergate-targeting-ukraine-9d5d158f19f3
//   - https://www.elastic.co/security-labs/operation-bleeding-bear
//   - https://www.winhelponline.com/blog/run-program-as-system-localsystem-account-windows/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_pua_advancedrun.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where ProcessVersionInfoOriginalFileName =~ "AdvancedRun.exe" or (ProcessCommandLine contains " /EXEFilename " and ProcessCommandLine contains " /Run") or (ProcessCommandLine contains " /WindowState 0" and ProcessCommandLine contains " /RunAs " and ProcessCommandLine contains " /CommandLine ")
