// Title: Invoke-Obfuscation CLIP+ Launcher
// Sigma ID: b222df08-0e07-11eb-adc1-0242ac120002
// Status: test | Level: high
// Author: Jonathan Cheong, oscd.community
// Date: 2020-10-13 | Modified: 2022-11-17
// ATT&CK: stealth, T1027, execution, T1059.001
// Description: Detects Obfuscated use of Clip.exe to execute PowerShell
// False positives:
//   - Unknown
// References:
//   - https://github.com/SigmaHQ/sigma/issues/1009
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_hktl_invoke_obfuscation_clip.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where (ProcessCommandLine contains "cmd" and ProcessCommandLine contains "&&" and ProcessCommandLine contains "clipboard]::" and ProcessCommandLine contains "-f") and (ProcessCommandLine contains "/c" or ProcessCommandLine contains "/r")
