// Title: Renamed SysInternals DebugView Execution
// Sigma ID: cd764533-2e07-40d6-a718-cfeec7f2da7f
// Status: test | Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2020-05-28 | Modified: 2023-02-14
// ATT&CK: resource-development, T1588.002
// Description: Detects suspicious renamed SysInternals DebugView execution
// False positives:
//   - Unknown
// References:
//   - https://www.epicturla.com/blog/sysinturla
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_renamed_sysinternals_debugview.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ProcessVersionInfoProductName =~ "Sysinternals DebugView" and (not((ProcessVersionInfoOriginalFileName =~ "Dbgview.exe" and FolderPath endswith "\\Dbgview.exe")))
