// Title: Windows Internet Hosted WebDav Share Mount Via Net.EXE
// Sigma ID: 7e6237fe-3ddb-438f-9381-9bf9de5af8d0
// Status: test | Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-21 | Modified: 2023-07-25
// ATT&CK: lateral-movement, T1021.002
// Description: Detects when an internet hosted webdav share is mounted using the "net.exe" utility
// False positives:
//   - Unknown
// References:
//   - https://drive.google.com/file/d/1lKya3_mLnR3UQuCoiYruO3qgu052_iS_/view
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_net_use_mount_internet_share.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where ((FolderPath endswith "\\net.exe" or FolderPath endswith "\\net1.exe") or (ProcessVersionInfoOriginalFileName in~ ("net.exe", "net1.exe"))) and (ProcessCommandLine contains " use " and ProcessCommandLine contains " http")
