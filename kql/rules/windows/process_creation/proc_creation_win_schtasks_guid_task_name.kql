// Title: Suspicious Scheduled Task Name As GUID
// Sigma ID: ff2fff64-4cd6-4a2b-ba7d-e28a30bbe66b
// Status: test | Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-10-31 | Modified: -
// ATT&CK: privilege-escalation, persistence, execution, T1053.005
// Description: Detects creation of a scheduled task with a GUID like name
// False positives:
//   - Legitimate software naming their tasks as GUIDs
// References:
//   - https://thedfirreport.com/2022/10/31/follina-exploit-leads-to-domain-compromise/
//   - https://thedfirreport.com/2022/02/21/qbot-and-zerologon-lead-to-full-domain-compromise/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules/windows/process_creation/proc_creation_win_schtasks_guid_task_name.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (FolderPath endswith "\\schtasks.exe" and ProcessCommandLine contains "/Create ") and (ProcessCommandLine contains "/TN \"{" or ProcessCommandLine contains "/TN '{" or ProcessCommandLine contains "/TN {") and (ProcessCommandLine contains "}\"" or ProcessCommandLine contains "}'" or ProcessCommandLine contains "} ")
