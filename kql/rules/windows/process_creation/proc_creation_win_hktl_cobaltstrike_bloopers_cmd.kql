// Title: Operator Bloopers Cobalt Strike Commands
// Sigma ID: 647c7b9e-d784-4fda-b9a0-45c565a7b729
// Status: test | Level: high
// Author: _pete_0, TheDFIRReport
// Date: 2022-05-06 | Modified: 2023-01-30
// ATT&CK: execution, T1059.003
// Tags: stp.1u
// Description: Detects use of Cobalt Strike commands accidentally entered in the CMD shell
// False positives:
//   - Unknown
// References:
//   - https://hstechdocs.helpsystems.com/manuals/cobaltstrike/current/userguide/content/cobalt-4-5-user-guide.pdf
//   - https://thedfirreport.com/2021/10/04/bazarloader-and-the-conti-leaks/
//   - https://thedfirreport.com/2022/06/16/sans-ransomware-summit-2022-can-you-detect-this/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/process_creation/proc_creation_win_hktl_cobaltstrike_bloopers_cmd.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (ProcessVersionInfoOriginalFileName =~ "Cmd.Exe" or FolderPath endswith "\\cmd.exe") and ((ProcessCommandLine startswith "cmd " or ProcessCommandLine startswith "cmd.exe" or ProcessCommandLine startswith "c:\\windows\\system32\\cmd.exe") and (ProcessCommandLine contains "psinject" or ProcessCommandLine contains "spawnas" or ProcessCommandLine contains "make_token" or ProcessCommandLine contains "remote-exec" or ProcessCommandLine contains "rev2self" or ProcessCommandLine contains "dcsync" or ProcessCommandLine contains "logonpasswords" or ProcessCommandLine contains "execute-assembly" or ProcessCommandLine contains "getsystem"))
