// Title: HackTool - KrbRelayUp Execution
// Sigma ID: 12827a56-61a4-476a-a9cb-f3068f191073
// Status: test | Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-04-26 | Modified: 2023-02-04
// ATT&CK: credential-access, T1558.003, lateral-movement, T1550.003
// Description: Detects KrbRelayUp used to perform a universal no-fix local privilege escalation in Windows
//   domain environments where LDAP signing is not enforced
// False positives:
//   - Unlikely
// References:
//   - https://github.com/Dec0ne/KrbRelayUp
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules/windows/process_creation/proc_creation_win_hktl_krbrelayup.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (FolderPath endswith "\\KrbRelayUp.exe" or ProcessVersionInfoOriginalFileName =~ "KrbRelayUp.exe") or (ProcessCommandLine contains " relay " and ProcessCommandLine contains " -Domain " and ProcessCommandLine contains " -ComputerName ") or (ProcessCommandLine contains " krbscm " and ProcessCommandLine contains " -sc ") or (ProcessCommandLine contains " spawn " and ProcessCommandLine contains " -d " and ProcessCommandLine contains " -cn " and ProcessCommandLine contains " -cp ")
