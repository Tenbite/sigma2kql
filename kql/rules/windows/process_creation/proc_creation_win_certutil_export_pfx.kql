// Title: Certificate Exported Via Certutil.EXE
// Sigma ID: 3ffd6f51-e6c1-47b7-94b4-c1e61d4117c5
// Status: test | Level: medium
// Author: Florian Roth (Nextron Systems), Jonhnathan Ribeiro, oscd.community, Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-02-15 | Modified: 2024-03-05
// ATT&CK: stealth, T1027
// Description: Detects the execution of the certutil with the "exportPFX" flag which allows the utility to
//   export certificates.
// False positives:
//   - There legitimate reasons to export certificates. Investigate the activity to determine if it's benign
// References:
//   - https://www.splunk.com/en_us/blog/security/a-golden-saml-journey-solarwinds-continued.html
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules/windows/process_creation/proc_creation_win_certutil_export_pfx.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (FolderPath endswith "\\certutil.exe" or ProcessVersionInfoOriginalFileName =~ "CertUtil.exe") and (ProcessCommandLine contains "-exportPFX " or ProcessCommandLine contains "/exportPFX " or ProcessCommandLine contains "–exportPFX " or ProcessCommandLine contains "—exportPFX " or ProcessCommandLine contains "―exportPFX ")
