// Title: Findstr Launching .lnk File
// Sigma ID: 33339be3-148b-4e16-af56-ad16ec6c7e7b
// Status: test | Level: medium
// Author: Trent Liffick
// Date: 2020-05-01 | Modified: 2024-01-15
// ATT&CK: stealth, T1036, T1202, T1027.003
// Description: Detects usage of findstr to identify and execute a lnk file as seen within the HHS redirect
//   attack
// False positives:
//   - Unknown
// References:
//   - https://www.bleepingcomputer.com/news/security/hhsgov-open-redirect-used-by-coronavirus-phishing-to-spread-malware/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_findstr_lnk.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\find.exe" or FolderPath endswith "\\findstr.exe") or (ProcessVersionInfoOriginalFileName in~ ("FIND.EXE", "FINDSTR.EXE"))) and (ProcessCommandLine endswith ".lnk" or ProcessCommandLine endswith ".lnk\"" or ProcessCommandLine endswith ".lnk'")
