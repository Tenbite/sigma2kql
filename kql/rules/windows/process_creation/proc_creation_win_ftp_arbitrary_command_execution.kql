// Title: Potential Arbitrary Command Execution Via FTP.EXE
// Sigma ID: 06b401f4-107c-4ff9-947f-9ec1e7649f1e
// Status: test | Level: medium
// Author: Victor Sergeev, oscd.community
// Date: 2020-10-09 | Modified: 2024-04-23
// ATT&CK: execution, stealth, T1059, T1202
// Description: Detects execution of "ftp.exe" script with the "-s" or "/s" flag and any child processes ran by
//   "ftp.exe".
// False positives:
//   - Unknown
// References:
//   - https://lolbas-project.github.io/lolbas/Binaries/Ftp/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/process_creation/proc_creation_win_ftp_arbitrary_command_execution.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where InitiatingProcessFolderPath endswith "\\ftp.exe" or ((FolderPath endswith "\\ftp.exe" or ProcessVersionInfoOriginalFileName =~ "ftp.exe") and (ProcessCommandLine contains "-s:" or ProcessCommandLine contains "/s:" or ProcessCommandLine contains "–s:" or ProcessCommandLine contains "—s:" or ProcessCommandLine contains "―s:"))
