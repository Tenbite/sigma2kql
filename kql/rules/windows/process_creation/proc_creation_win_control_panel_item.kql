// Title: Control Panel Items
// Sigma ID: 0ba863e6-def5-4e50-9cea-4dd8c7dc46a4
// Status: test | Level: high
// Author: Kyaw Min Thein, Furkan Caliskan (@caliskanfurkan_)
// Date: 2020-06-22 | Modified: 2023-10-11
// ATT&CK: privilege-escalation, execution, stealth, T1218.002, persistence, T1546
// Description: Detects the malicious use of a control panel item
// False positives:
//   - Unknown
// References:
//   - https://ired.team/offensive-security/code-execution/code-execution-through-control-panel-add-ins
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/process_creation/proc_creation_win_control_panel_item.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\reg.exe" or ProcessVersionInfoOriginalFileName =~ "reg.exe") and (ProcessCommandLine contains "add" and ProcessCommandLine contains "CurrentVersion\\Control Panel\\CPLs")) or (ProcessCommandLine endswith ".cpl" and (not(((ProcessCommandLine contains "\\System32\\" or ProcessCommandLine contains "%System%" or ProcessCommandLine contains "|C:\\Windows\\system32|") or (ProcessCommandLine contains "regsvr32 " and ProcessCommandLine contains " /s " and ProcessCommandLine contains "igfxCPL.cpl")))))
