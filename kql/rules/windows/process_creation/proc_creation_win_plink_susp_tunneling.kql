// Title: Potential RDP Tunneling Via Plink
// Sigma ID: f38ce0b9-5e97-4b47-a211-7dc8d8b871da
// Status: test | Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-08-04 | Modified: 2023-01-27
// ATT&CK: command-and-control, T1572
// Description: Execution of plink to perform data exfiltration and tunneling
// False positives:
//   - Unknown
// References:
//   - https://www.microsoft.com/security/blog/2022/07/26/malicious-iis-extensions-quietly-open-persistent-backdoors-into-servers/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_plink_susp_tunneling.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (FolderPath endswith "\\plink.exe" and ProcessCommandLine contains ":127.0.0.1:3389") or ((FolderPath endswith "\\plink.exe" and ProcessCommandLine contains ":3389") and (ProcessCommandLine contains " -P 443" or ProcessCommandLine contains " -P 22"))
