// Title: DLL Loaded via CertOC.EXE
// Sigma ID: 242301bc-f92f-4476-8718-78004a6efd9f
// Status: test | Level: medium
// Author: Austin Songer @austinsonger
// Date: 2021-10-23 | Modified: 2024-03-05
// ATT&CK: stealth, T1218
// Description: Detects when a user installs certificates by using CertOC.exe to loads the target DLL file.
// False positives:
//   - Unknown
// References:
//   - https://twitter.com/sblmsrsn/status/1445758411803480072?s=20
//   - https://github.com/elastic/protections-artifacts/commit/746086721fd385d9f5c6647cada1788db4aea95f#diff-fe98e74189873d6df72a15df2eaa0315c59ba9cdaca93ecd68afc4ea09194ef2
//   - https://lolbas-project.github.io/lolbas/Binaries/Certoc/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_certoc_load_dll.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where (FolderPath endswith "\\certoc.exe" or ProcessVersionInfoOriginalFileName =~ "CertOC.exe") and (ProcessCommandLine contains " -LoadDLL " or ProcessCommandLine contains " /LoadDLL " or ProcessCommandLine contains " –LoadDLL " or ProcessCommandLine contains " —LoadDLL " or ProcessCommandLine contains " ―LoadDLL ")
