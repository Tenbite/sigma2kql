// Title: Exchange PowerShell Snap-Ins Usage
// Sigma ID: 25676e10-2121-446e-80a4-71ff8506af47
// Status: test | Level: high
// Author: FPT.EagleEye, Nasreddine Bencherchali (Nextron Systems)
// Date: 2021-03-03 | Modified: 2023-03-24
// ATT&CK: execution, T1059.001, collection, T1114
// Description: Detects adding and using Exchange PowerShell snap-ins to export mailbox data. As seen used by
//   HAFNIUM and APT27
// False positives:
//   - Unknown
// References:
//   - https://www.volexity.com/blog/2021/03/02/active-exploitation-of-microsoft-exchange-zero-day-vulnerabilities/
//   - https://www.microsoft.com/security/blog/2021/03/02/hafnium-targeting-exchange-servers/
//   - https://www.intrinsec.com/apt27-analysis/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_powershell_snapins_hafnium.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where (((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") or (ProcessVersionInfoOriginalFileName in~ ("PowerShell.EXE", "pwsh.dll"))) and ProcessCommandLine contains "Add-PSSnapin" and (ProcessCommandLine contains "Microsoft.Exchange.Powershell.Snapin" or ProcessCommandLine contains "Microsoft.Exchange.Management.PowerShell.SnapIn")) and (not((InitiatingProcessFolderPath =~ "C:\\Windows\\System32\\msiexec.exe" and ProcessCommandLine contains "$exserver=Get-ExchangeServer ([Environment]::MachineName) -ErrorVariable exerr 2> $null")))
