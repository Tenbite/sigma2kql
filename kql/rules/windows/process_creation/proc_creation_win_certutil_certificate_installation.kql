// Title: New Root Certificate Installed Via Certutil.EXE
// Sigma ID: d2125259-ddea-4c1c-9c22-977eb5b29cf0
// Status: test | Level: medium
// Author: oscd.community, @redcanary, Zach Stanford @svch0st
// Date: 2023-03-05 | Modified: 2024-03-05
// ATT&CK: defense-impairment, T1553.004
// Description: Detects execution of "certutil" with the "addstore" flag in order to install a new certificate
//   on the system. Adversaries may install a root certificate on a compromised system to avoid
//   warnings when connecting to adversary controlled web servers.
// False positives:
//   - Help Desk or IT may need to manually add a corporate Root CA on occasion. Need to test if GPO push doesn't trigger FP
// References:
//   - https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1553.004/T1553.004.md
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/process_creation/proc_creation_win_certutil_certificate_installation.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (FolderPath endswith "\\certutil.exe" or ProcessVersionInfoOriginalFileName =~ "CertUtil.exe") and (ProcessCommandLine contains "-addstore" or ProcessCommandLine contains "/addstore" or ProcessCommandLine contains "–addstore" or ProcessCommandLine contains "—addstore" or ProcessCommandLine contains "―addstore") and ProcessCommandLine contains "root"
