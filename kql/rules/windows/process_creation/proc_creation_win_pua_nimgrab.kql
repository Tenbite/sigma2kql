// Title: PUA - Nimgrab Execution
// Sigma ID: 74a12f18-505c-4114-8d0b-8448dd5485c6
// Status: test | Level: high
// Author: frack113
// Date: 2022-08-28 | Modified: 2024-11-23
// ATT&CK: command-and-control, T1105
// Description: Detects the usage of nimgrab, a tool bundled with the Nim programming framework and used for
//   downloading files.
// False positives:
//   - Legitimate use of Nim on a developer systems
// References:
//   - https://github.com/redcanaryco/atomic-red-team/blob/28d190330fe44de6ff4767fc400cc10fa7cd6540/atomics/T1105/T1105.md
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_pua_nimgrab.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where FolderPath endswith "\\nimgrab.exe" or (MD5 startswith "2DD44C3C29D667F5C0EF5F9D7C7FFB8B" or SHA256 startswith "F266609E91985F0FE3E31C5E8FAEEEC4FFA5E0322D8B6F15FE69F4C5165B9559")
