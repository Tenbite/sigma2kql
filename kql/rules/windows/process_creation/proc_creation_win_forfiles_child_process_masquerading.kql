// Title: Forfiles.EXE Child Process Masquerading
// Sigma ID: f53714ec-5077-420e-ad20-907ff9bb2958
// Status: test | Level: high
// Author: Nasreddine Bencherchali (Nextron Systems), Anish Bogati
// Date: 2024-01-05 | Modified: -
// ATT&CK: stealth, T1036
// Description: Detects the execution of "forfiles" from a non-default location, in order to potentially spawn a
//   custom "cmd.exe" from the current working directory.
// False positives:
//   - Unknown
// References:
//   - https://www.hexacorn.com/blog/2023/12/31/1-little-known-secret-of-forfiles-exe/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_forfiles_child_process_masquerading.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where ((InitiatingProcessCommandLine endswith ".exe" or InitiatingProcessCommandLine endswith ".exe\"") and FolderPath endswith "\\cmd.exe" and ProcessCommandLine startswith "/c echo \"") and (not(((InitiatingProcessFolderPath contains ":\\Windows\\System32\\" or InitiatingProcessFolderPath contains ":\\Windows\\SysWOW64\\") and InitiatingProcessFolderPath endswith "\\forfiles.exe" and (FolderPath contains ":\\Windows\\System32\\" or FolderPath contains ":\\Windows\\SysWOW64\\") and FolderPath endswith "\\cmd.exe")))
