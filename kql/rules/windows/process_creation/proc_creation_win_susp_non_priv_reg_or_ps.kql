// Title: Non-privileged Usage of Reg or Powershell
// Sigma ID: 8f02c935-effe-45b3-8fc9-ef8696a9e41d
// Status: test | Level: high
// Author: Teymur Kheirkhabarov (idea), Ryan Plas (rule), oscd.community
// Date: 2020-10-05 | Modified: 2024-12-01
// ATT&CK: persistence, defense-impairment, T1112
// Description: Search for usage of reg or Powershell by non-privileged users to modify service configuration in
//   registry
// False positives:
//   - Unknown
// References:
//   - https://image.slidesharecdn.com/kheirkhabarovoffzonefinal-181117201458/95/hunting-for-privilege-escalation-in-windows-environment-20-638.jpg
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules/windows/process_creation/proc_creation_win_susp_non_priv_reg_or_ps.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((ProcessCommandLine contains "reg " and ProcessCommandLine contains "add") or (ProcessCommandLine contains "powershell" or ProcessCommandLine contains "set-itemproperty" or ProcessCommandLine contains " sp " or ProcessCommandLine contains "new-itemproperty")) and ((ProcessIntegrityLevel in~ ("Medium", "S-1-16-8192")) and (ProcessCommandLine contains "ControlSet" and ProcessCommandLine contains "Services") and (ProcessCommandLine contains "ImagePath" or ProcessCommandLine contains "FailureCommand" or ProcessCommandLine contains "ServiceDLL"))
