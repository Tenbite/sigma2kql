// Title: Diskshadow Script Mode - Uncommon Script Extension Execution
// Sigma ID: 1dde5376-a648-492e-9e54-4241dd9b0c7f
// Status: test | Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-09-15 | Modified: 2024-03-05
// ATT&CK: stealth, T1218
// Description: Detects execution of "Diskshadow.exe" in script mode to execute an script with a potentially
//   uncommon extension. Initial baselining of the allowed extension list is required.
// False positives:
//   - False postitve might occur with legitimate or uncommon extensions used internally. Initial baseline is required.
// References:
//   - https://bohops.com/2018/03/26/diskshadow-the-return-of-vss-evasion-persistence-and-active-directory-database-extraction/
//   - https://www.ired.team/offensive-security/credential-access-and-credential-dumping/ntds.dit-enumeration
//   - https://medium.com/@cyberjyot/lolbin-execution-via-diskshadow-f6ff681a27a4
//   - https://learn.microsoft.com/en-us/windows-server/administration/windows-commands/diskshadow
//   - https://www.lifars.com/wp-content/uploads/2022/01/GriefRansomware_Whitepaper-2.pdf
//   - https://www.zscaler.com/blogs/security-research/technical-analysis-crytox-ransomware
//   - https://research.checkpoint.com/2022/evilplayout-attack-against-irans-state-broadcaster/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/process_creation/proc_creation_win_diskshadow_script_mode_susp_ext.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((ProcessVersionInfoOriginalFileName =~ "diskshadow.exe" or FolderPath endswith "\\diskshadow.exe") and (ProcessCommandLine contains "-s " or ProcessCommandLine contains "/s " or ProcessCommandLine contains "–s " or ProcessCommandLine contains "—s " or ProcessCommandLine contains "―s ")) and (not(ProcessCommandLine contains ".txt"))
