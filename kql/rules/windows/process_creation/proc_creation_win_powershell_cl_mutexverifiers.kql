// Title: Potential Script Proxy Execution Via CL_Mutexverifiers.ps1
// Sigma ID: 1e0e1a81-e79b-44bc-935b-ddb9c8006b3d
// Status: test | Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), oscd.community, Natalia Shornikova, frack113
// Date: 2022-05-21 | Modified: 2023-08-17
// ATT&CK: stealth, T1216
// Description: Detects the use of the Microsoft signed script "CL_mutexverifiers" to proxy the execution of
//   additional PowerShell script commands
// False positives:
//   - Unknown
// References:
//   - https://lolbas-project.github.io/lolbas/Scripts/CL_mutexverifiers/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules/windows/process_creation/proc_creation_win_powershell_cl_mutexverifiers.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((InitiatingProcessFolderPath endswith "\\powershell.exe" or InitiatingProcessFolderPath endswith "\\pwsh.exe") and FolderPath endswith "\\powershell.exe" and ProcessCommandLine contains " -nologo -windowstyle minimized -file ") and (ProcessCommandLine contains "\\AppData\\Local\\Temp\\" or ProcessCommandLine contains "\\Windows\\Temp\\")
