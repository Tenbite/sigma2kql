// Title: Esentutl Steals Browser Information
// Sigma ID: 6a69f62d-ce75-4b57-8dce-6351eb55b362
// Status: test | Level: medium
// Author: frack113
// Date: 2022-02-13 | Modified: 2024-03-05
// ATT&CK: collection, T1005
// Description: One way Qbot steals sensitive information is by extracting browser data from Internet Explorer
//   and Microsoft Edge by using the built-in utility esentutl.exe
// False positives:
//   - Legitimate use
// References:
//   - https://thedfirreport.com/2022/02/07/qbot-likes-to-move-it-move-it/
//   - https://redcanary.com/threat-detection-report/threats/qbot/
//   - https://thedfirreport.com/2022/10/31/follina-exploit-leads-to-domain-compromise/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/process_creation/proc_creation_win_esentutl_webcache.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (FolderPath endswith "\\esentutl.exe" or ProcessVersionInfoOriginalFileName =~ "esentutl.exe") and (ProcessCommandLine contains "-r" or ProcessCommandLine contains "/r" or ProcessCommandLine contains "–r" or ProcessCommandLine contains "—r" or ProcessCommandLine contains "―r") and ProcessCommandLine contains "\\Windows\\WebCache"
