// Title: Process Access via TrolleyExpress Exclusion
// Sigma ID: 4c0aaedc-154c-4427-ada0-d80ef9c9deb6
// Status: test | Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-02-10 | Modified: 2022-05-13
// ATT&CK: stealth, T1218.011, credential-access, T1003.001
// Description: Detects a possible process memory dump that uses the white-listed Citrix TrolleyExpress.exe
//   filename as a way to dump the lsass process memory
// False positives:
//   - Unknown
// References:
//   - https://twitter.com/_xpn_/status/1491557187168178176
//   - https://www.youtube.com/watch?v=Ie831jF0bb0
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules/windows/process_creation/proc_creation_win_citrix_trolleyexpress_procdump.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (ProcessCommandLine contains "\\TrolleyExpress 7" or ProcessCommandLine contains "\\TrolleyExpress 8" or ProcessCommandLine contains "\\TrolleyExpress 9" or ProcessCommandLine contains "\\TrolleyExpress.exe 7" or ProcessCommandLine contains "\\TrolleyExpress.exe 8" or ProcessCommandLine contains "\\TrolleyExpress.exe 9" or ProcessCommandLine contains "\\TrolleyExpress.exe -ma ") or (FolderPath endswith "\\TrolleyExpress.exe" and (not((ProcessVersionInfoOriginalFileName contains "CtxInstall" or isnull(ProcessVersionInfoOriginalFileName)))))
