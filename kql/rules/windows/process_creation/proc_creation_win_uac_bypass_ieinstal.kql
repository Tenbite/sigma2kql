// Title: UAC Bypass Using IEInstal - Process
// Sigma ID: 80fc36aa-945e-4181-89f2-2f907ab6775d
// Status: test | Level: high
// Author: Christian Burkard (Nextron Systems)
// Date: 2021-08-30 | Modified: 2024-12-01
// ATT&CK: privilege-escalation, T1548.002
// Description: Detects the pattern of UAC Bypass using IEInstal.exe (UACMe 64)
// False positives:
//   - Unknown
// References:
//   - https://github.com/hfiref0x/UACME
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_uac_bypass_ieinstal.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (ProcessIntegrityLevel in~ ("High", "System", "S-1-16-16384", "S-1-16-12288")) and InitiatingProcessFolderPath endswith "\\ieinstal.exe" and FolderPath contains "\\AppData\\Local\\Temp\\" and FolderPath endswith "consent.exe"
