// Title: Renamed BOINC Client Execution
// Sigma ID: 30d07da2-83ab-45d8-ae75-ec7c0edcaffc
// Status: test | Level: medium
// Author: Matt Anderson (Huntress)
// Date: 2024-07-23 | Modified: -
// ATT&CK: defense-impairment, T1553
// Description: Detects the execution of a renamed BOINC binary.
// False positives:
//   - Unknown
// References:
//   - https://boinc.berkeley.edu/
//   - https://www.virustotal.com/gui/file/91e405e8a527023fb8696624e70498ae83660fe6757cef4871ce9bcc659264d3/details
//   - https://www.huntress.com/blog/fake-browser-updates-lead-to-boinc-volunteer-computing-software
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_renamed_boinc.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where ProcessVersionInfoOriginalFileName =~ "BOINC.exe" and (not(FolderPath endswith "\\BOINC.exe"))
