// Title: PUA - NPS Tunneling Tool Execution
// Sigma ID: 68d37776-61db-42f5-bf54-27e87072d17e
// Status: test | Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-10-08 | Modified: 2024-11-23
// ATT&CK: command-and-control, T1090
// Description: Detects the use of NPS, a port forwarding and intranet penetration proxy server
// False positives:
//   - Legitimate use
// References:
//   - https://github.com/ehang-io/nps
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_pua_nps.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where FolderPath endswith "\\npc.exe" or (ProcessCommandLine contains " -server=" and ProcessCommandLine contains " -vkey=" and ProcessCommandLine contains " -password=") or ProcessCommandLine contains " -config=npc" or (MD5 startswith "AE8ACF66BFE3A44148964048B826D005" or SHA1 startswith "CEA49E9B9B67F3A13AD0BE1C2655293EA3C18181" or SHA256 startswith "5A456283392FFCEEEACA3D3426C306EB470304637520D72FED1CC1FEBBBD6856")
