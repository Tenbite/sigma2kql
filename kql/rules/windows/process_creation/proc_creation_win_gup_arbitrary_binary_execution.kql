// Title: Arbitrary Binary Execution Using GUP Utility
// Sigma ID: d65aee4d-2292-4cea-b832-83accd6cfa43
// Status: test | Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-10 | Modified: 2023-03-02
// ATT&CK: execution
// Description: Detects execution of the Notepad++ updater (gup) to launch other commands or executables
// False positives:
//   - Other parent binaries using GUP not currently identified
// References:
//   - https://twitter.com/nas_bench/status/1535322445439180803
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules/windows/process_creation/proc_creation_win_gup_arbitrary_binary_execution.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (InitiatingProcessFolderPath endswith "\\gup.exe" and FolderPath endswith "\\explorer.exe") and (not(((FolderPath endswith "\\explorer.exe" and ProcessCommandLine contains "\\Notepad++\\notepad++.exe") or InitiatingProcessFolderPath contains "\\Notepad++\\updater\\" or isnull(ProcessCommandLine))))
