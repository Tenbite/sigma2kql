// Title: Invoke-Obfuscation COMPRESS OBFUSCATION
// Sigma ID: 7eedcc9d-9fdb-4d94-9c54-474e8affc0c7
// Status: test | Level: medium
// Author: Timur Zinniatullin, oscd.community
// Date: 2020-10-18 | Modified: 2022-12-29
// ATT&CK: stealth, T1027, execution, T1059.001
// Description: Detects Obfuscated Powershell via COMPRESS OBFUSCATION
// False positives:
//   - Unknown
// References:
//   - https://github.com/SigmaHQ/sigma/issues/1009
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_hktl_invoke_obfuscation_via_compress.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where (ProcessCommandLine contains "new-object" and ProcessCommandLine contains "text.encoding]::ascii") and (ProcessCommandLine contains "system.io.compression.deflatestream" or ProcessCommandLine contains "system.io.streamreader" or ProcessCommandLine contains "readtoend(")
