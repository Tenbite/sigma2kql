// Title: Compress Data and Lock With Password for Exfiltration With WINZIP
// Sigma ID: e2e80da2-8c66-4e00-ae3c-2eebd29f6b6d
// Status: test | Level: medium
// Author: frack113
// Date: 2021-07-27 | Modified: 2022-12-25
// ATT&CK: collection, T1560.001
// Description: An adversary may compress or encrypt data that is collected prior to exfiltration using 3rd
//   party utilities
// False positives:
//   - Unknown
// References:
//   - https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1560.001/T1560.001.md
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_winzip_password_compression.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where (ProcessCommandLine contains "winzip.exe" or ProcessCommandLine contains "winzip64.exe") and ProcessCommandLine contains "-s\"" and (ProcessCommandLine contains " -min " or ProcessCommandLine contains " -a ")
