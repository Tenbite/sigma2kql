// Title: Potentially Suspicious GoogleUpdate Child Process
// Sigma ID: 84b1ecf9-6eff-4004-bafb-bae5c0e251b2
// Status: test | Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-15 | Modified: 2023-05-22
// ATT&CK: stealth
// Description: Detects potentially suspicious child processes of "GoogleUpdate.exe"
// False positives:
//   - Unknown
// References:
//   - https://www.ncsc.gov.uk/static-assets/documents/malware-analysis-reports/goofy-guineapig/NCSC-MAR-Goofy-Guineapig.pdf
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_googleupdate_susp_child_process.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where InitiatingProcessFolderPath endswith "\\GoogleUpdate.exe" and (not(((FolderPath contains "\\Google" or (FolderPath endswith "\\setup.exe" or FolderPath endswith "chrome_updater.exe" or FolderPath endswith "chrome_installer.exe")) or isnull(FolderPath))))
