// Title: Set Suspicious Files as System Files Using Attrib.EXE
// Sigma ID: efec536f-72e8-4656-8960-5e85d091345b
// Status: test | Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-06-28 | Modified: 2023-03-14
// ATT&CK: stealth, T1564.001
// Description: Detects the usage of attrib with the "+s" option to set scripts or executables located in
//   suspicious locations as system files to hide them from users and make them unable to be deleted
//   with simple rights. The rule limits the search to specific extensions and directories to avoid
//   FPs
// False positives:
//   - Unknown
// References:
//   - https://app.any.run/tasks/c28cabc8-a19f-40f3-a78b-cae506a5c0d4
//   - https://app.any.run/tasks/cfc8870b-ccd7-4210-88cf-a8087476a6d0
//   - https://unit42.paloaltonetworks.com/unit42-sure-ill-take-new-combojack-malware-alters-clipboards-steal-cryptocurrency/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules/windows/process_creation/proc_creation_win_attrib_system_susp_paths.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\attrib.exe" or ProcessVersionInfoOriginalFileName =~ "ATTRIB.EXE") and ProcessCommandLine contains " +s" and (ProcessCommandLine contains " %" or ProcessCommandLine contains "\\Users\\Public\\" or ProcessCommandLine contains "\\AppData\\Local\\" or ProcessCommandLine contains "\\ProgramData\\" or ProcessCommandLine contains "\\Downloads\\" or ProcessCommandLine contains "\\Windows\\Temp\\") and (ProcessCommandLine contains ".bat" or ProcessCommandLine contains ".dll" or ProcessCommandLine contains ".exe" or ProcessCommandLine contains ".hta" or ProcessCommandLine contains ".ps1" or ProcessCommandLine contains ".vbe" or ProcessCommandLine contains ".vbs")) and (not((ProcessCommandLine contains "\\Windows\\TEMP\\" and ProcessCommandLine contains ".exe")))
