// Title: Possible Privilege Escalation via Weak Service Permissions
// Sigma ID: d937b75f-a665-4480-88a5-2f20e9f9b22a
// Status: test | Level: high
// Author: Teymur Kheirkhabarov
// Date: 2019-10-26 | Modified: 2024-12-01
// ATT&CK: persistence, privilege-escalation, execution, stealth, T1574.011
// Description: Detection of sc.exe utility spawning by user with Medium integrity level to change service
//   ImagePath or FailureCommand
// False positives:
//   - Unknown
// References:
//   - https://speakerdeck.com/heirhabarov/hunting-for-privilege-escalation-in-windows-environment
//   - https://pentestlab.blog/2017/03/30/weak-service-permissions/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_sc_change_sevice_image_path_by_non_admin.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (FolderPath endswith "\\sc.exe" and (ProcessIntegrityLevel in~ ("Medium", "S-1-16-8192"))) and ((ProcessCommandLine contains "config" and ProcessCommandLine contains "binPath") or (ProcessCommandLine contains "failure" and ProcessCommandLine contains "command"))
