// Title: Imports Registry Key From a File
// Sigma ID: 73bba97f-a82d-42ce-b315-9182e76c57b1
// Status: test | Level: medium
// Author: Oddvar Moe, Sander Wiebing, oscd.community
// Date: 2020-10-07 | Modified: 2024-03-13
// ATT&CK: persistence, defense-impairment, T1112
// Description: Detects the import of the specified file to the registry with regedit.exe.
// False positives:
//   - Legitimate import of keys
//   - Evernote
// References:
//   - https://lolbas-project.github.io/lolbas/Binaries/Regedit/
//   - https://gist.github.com/api0cradle/cdd2d0d0ec9abb686f0e89306e277b8f
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/process_creation/proc_creation_win_regedit_import_keys.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\regedit.exe" or ProcessVersionInfoOriginalFileName =~ "REGEDIT.EXE") and (ProcessCommandLine contains " /i " or ProcessCommandLine contains " /s " or ProcessCommandLine contains ".reg")) and (not(((ProcessCommandLine contains " -e " or ProcessCommandLine contains " /e " or ProcessCommandLine contains " –e " or ProcessCommandLine contains " —e " or ProcessCommandLine contains " ―e " or ProcessCommandLine contains " -a " or ProcessCommandLine contains " /a " or ProcessCommandLine contains " –a " or ProcessCommandLine contains " —a " or ProcessCommandLine contains " ―a " or ProcessCommandLine contains " -c " or ProcessCommandLine contains " /c " or ProcessCommandLine contains " –c " or ProcessCommandLine contains " —c " or ProcessCommandLine contains " ―c ") and ProcessCommandLine matches regex ":[^ \\\\]")))
