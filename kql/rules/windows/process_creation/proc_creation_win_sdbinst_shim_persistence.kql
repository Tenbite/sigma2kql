// Title: Potential Shim Database Persistence via Sdbinst.EXE
// Sigma ID: 517490a7-115a-48c6-8862-1a481504d5a8
// Status: test | Level: medium
// Author: Markus Neis
// Date: 2019-01-16 | Modified: 2023-12-06
// ATT&CK: persistence, privilege-escalation, T1546.011
// Description: Detects installation of a new shim using sdbinst.exe. Adversaries may establish persistence
//   and/or elevate privileges by executing malicious content triggered by application shims
// False positives:
//   - Unknown
// References:
//   - https://www.mandiant.com/resources/blog/fin7-shim-databases-persistence
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_sdbinst_shim_persistence.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\sdbinst.exe" or ProcessVersionInfoOriginalFileName =~ "sdbinst.exe") and ProcessCommandLine contains ".sdb") and (not((InitiatingProcessFolderPath endswith "\\msiexec.exe" and (ProcessCommandLine contains ":\\Program Files (x86)\\IIS Express\\iisexpressshim.sdb" or ProcessCommandLine contains ":\\Program Files\\IIS Express\\iisexpressshim.sdb"))))
