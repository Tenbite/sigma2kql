// Title: Potential Register_App.Vbs LOLScript Abuse
// Sigma ID: 28c8f68b-098d-45af-8d43-8089f3e35403
// Status: test | Level: medium
// Author: Austin Songer @austinsonger
// Date: 2021-11-05 | Modified: 2022-07-07
// ATT&CK: stealth, T1218
// Description: Detects potential abuse of the "register_app.vbs" script that is part of the Windows SDK. The
//   script offers the capability to register new VSS/VDS Provider as a COM+ application. Attackers
//   can use this to install malicious DLLs for persistence and execution.
// False positives:
//   - Other VB scripts that leverage the same starting command line flags
// References:
//   - https://twitter.com/sblmsrsn/status/1456613494783160325?s=20
//   - https://github.com/microsoft/Windows-classic-samples/blob/7cbd99ac1d2b4a0beffbaba29ea63d024ceff700/Samples/Win7Samples/winbase/vss/vsssampleprovider/register_app.vbs
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/process_creation/proc_creation_win_lolscript_register_app.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\cscript.exe" or FolderPath endswith "\\wscript.exe") or (ProcessVersionInfoOriginalFileName in~ ("cscript.exe", "wscript.exe"))) and ProcessCommandLine contains ".vbs -register "
