// Title: Terminal Service Process Spawn
// Sigma ID: 1012f107-b8f1-4271-af30-5aed2de89b39
// Status: test | Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2019-05-22 | Modified: 2023-01-25
// ATT&CK: initial-access, T1190, lateral-movement, T1210
// Tags: car.2013-07-002
// Description: Detects a process spawned by the terminal service server process (this could be an indicator for
//   an exploitation of CVE-2019-0708)
// False positives:
//   - Unknown
// References:
//   - https://securingtomorrow.mcafee.com/other-blogs/mcafee-labs/rdp-stands-for-really-do-patch-understanding-the-wormable-rdp-vulnerability-cve-2019-0708/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_svchost_termserv_proc_spawn.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where (InitiatingProcessCommandLine contains "\\svchost.exe" and InitiatingProcessCommandLine contains "termsvcs") and (not(((FolderPath endswith "\\rdpclip.exe" or FolderPath endswith ":\\Windows\\System32\\csrss.exe" or FolderPath endswith ":\\Windows\\System32\\wininit.exe" or FolderPath endswith ":\\Windows\\System32\\winlogon.exe") or isnull(FolderPath))))
