// Title: Password Provided In Command Line Of Net.EXE
// Sigma ID: d4498716-1d52-438f-8084-4a603157d131
// Status: test | Level: medium
// Author: Tim Shelton (HAWK.IO)
// Date: 2021-12-09 | Modified: 2023-02-21
// ATT&CK: initial-access, persistence, privilege-escalation, lateral-movement, stealth, T1021.002, T1078
// Description: Detects a when net.exe is called with a password in the command line
// False positives:
//   - Unknown
// References:
//   - Internal Research
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_net_use_password_plaintext.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where (((FolderPath endswith "\\net.exe" or FolderPath endswith "\\net1.exe") or (ProcessVersionInfoOriginalFileName in~ ("net.exe", "net1.exe"))) and (ProcessCommandLine contains " use " and (ProcessCommandLine contains ":" and ProcessCommandLine contains "\\") and (ProcessCommandLine contains "/USER:" and ProcessCommandLine contains " "))) and (not(ProcessCommandLine endswith " "))
