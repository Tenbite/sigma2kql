// Title: Firewall Rule Deleted Via Netsh.EXE
// Sigma ID: 1a5fefe6-734f-452e-a07d-fc1c35bce4b2
// Status: test | Level: medium
// Author: frack113
// Date: 2022-08-14 | Modified: 2025-10-07
// ATT&CK: defense-impairment, T1686.003
// Description: Detects the removal of a port or application rule in the Windows Firewall configuration using
//   netsh
// False positives:
//   - Legitimate administration activity
//   - Software installations and removal
// References:
//   - https://app.any.run/tasks/8bbd5b4c-b82d-4e6d-a3ea-d454594a37cc/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules/windows/process_creation/proc_creation_win_netsh_fw_delete_rule.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\netsh.exe" or ProcessVersionInfoOriginalFileName =~ "netsh.exe") and (ProcessCommandLine contains "firewall" and ProcessCommandLine contains "delete ")) and (not(((InitiatingProcessFolderPath endswith "\\Dropbox.exe" and ProcessCommandLine contains "name=Dropbox") or (InitiatingProcessFolderPath endswith "\\instup.exe" and ProcessCommandLine contains "advfirewall firewall delete rule name=\"Avast Antivirus Admin Client\""))))
