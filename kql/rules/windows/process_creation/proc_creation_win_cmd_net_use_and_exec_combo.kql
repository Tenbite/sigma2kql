// Title: Suspicious File Execution From Internet Hosted WebDav Share
// Sigma ID: f0507c0f-a3a2-40f5-acc6-7f543c334993
// Status: test | Level: high
// Author: pH-T (Nextron Systems)
// Date: 2022-09-01 | Modified: 2023-02-21
// ATT&CK: execution, T1059.001
// Description: Detects the execution of the "net use" command to mount a WebDAV server and then immediately
//   execute some content in it. As seen being used in malicious LNK files
// False positives:
//   - Unknown
// References:
//   - https://twitter.com/ShadowChasing1/status/1552595370961944576
//   - https://www.virustotal.com/gui/file/a63376ee1dba76361df73338928e528ca5b20171ea74c24581605366dcaa0104/behavior
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_cmd_net_use_and_exec_combo.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (FolderPath contains "\\cmd.exe" or ProcessVersionInfoOriginalFileName =~ "Cmd.EXE") and (ProcessCommandLine contains " net use http" and ProcessCommandLine contains "& start /b " and ProcessCommandLine contains "\\DavWWWRoot\\") and (ProcessCommandLine contains ".exe " or ProcessCommandLine contains ".dll " or ProcessCommandLine contains ".bat " or ProcessCommandLine contains ".vbs " or ProcessCommandLine contains ".ps1 ")
