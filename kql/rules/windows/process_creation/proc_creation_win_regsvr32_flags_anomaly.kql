// Title: Potential Regsvr32 Commandline Flag Anomaly
// Sigma ID: b236190c-1c61-41e9-84b3-3fe03f6d76b0
// Status: test | Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2019-07-13 | Modified: 2024-03-13
// ATT&CK: stealth, T1218.010
// Description: Detects a potential command line flag anomaly related to "regsvr32" in which the "/i" flag is
//   used without the "/n" which should be uncommon.
// False positives:
//   - Administrator typo might cause some false positives
// References:
//   - https://twitter.com/sbousseaden/status/1282441816986484737?s=12
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_regsvr32_flags_anomaly.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (FolderPath endswith "\\regsvr32.exe" and (ProcessCommandLine contains " -i:" or ProcessCommandLine contains " /i:" or ProcessCommandLine contains " –i:" or ProcessCommandLine contains " —i:" or ProcessCommandLine contains " ―i:")) and (not(ProcessCommandLine contains " -n " or ProcessCommandLine contains " /n " or ProcessCommandLine contains " –n " or ProcessCommandLine contains " —n " or ProcessCommandLine contains " ―n "))
