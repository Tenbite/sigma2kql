// Title: Invoke-Obfuscation VAR++ LAUNCHER OBFUSCATION
// Sigma ID: e9f55347-2928-4c06-88e5-1a7f8169942e
// Status: test | Level: high
// Author: Timur Zinniatullin, oscd.community
// Date: 2020-10-13 | Modified: 2022-11-16
// ATT&CK: stealth, T1027, execution, T1059.001
// Description: Detects Obfuscated Powershell via VAR++ LAUNCHER
// False positives:
//   - Unknown
// References:
//   - https://github.com/SigmaHQ/sigma/issues/1009
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_hktl_invoke_obfuscation_via_var.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (ProcessCommandLine contains "&&set" and ProcessCommandLine contains "cmd" and ProcessCommandLine contains "/c" and ProcessCommandLine contains "-f") and (ProcessCommandLine contains "{0}" or ProcessCommandLine contains "{1}" or ProcessCommandLine contains "{2}" or ProcessCommandLine contains "{3}" or ProcessCommandLine contains "{4}" or ProcessCommandLine contains "{5}")
