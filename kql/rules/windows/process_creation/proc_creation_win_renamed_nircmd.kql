// Title: Renamed NirCmd.EXE Execution
// Sigma ID: 264982dc-dbad-4dce-b707-1e0d3e0f73d9
// Status: test | Level: high
// Author: X__Junior (Nextron Systems)
// Date: 2024-03-11 | Modified: -
// ATT&CK: execution, stealth, T1059, T1202
// Description: Detects the execution of a renamed "NirCmd.exe" binary based on the PE metadata fields.
// False positives:
//   - Unknown
// References:
//   - https://www.microsoft.com/en-us/security/blog/2024/01/17/new-ttps-observed-in-mint-sandstorm-campaign-targeting-high-profile-individuals-at-universities-and-research-orgs/
//   - https://www.nirsoft.net/utils/nircmd.html
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_renamed_nircmd.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ProcessVersionInfoOriginalFileName =~ "NirCmd.exe" and (not((FolderPath endswith "\\nircmd.exe" or FolderPath endswith "\\nircmdc.exe")))
