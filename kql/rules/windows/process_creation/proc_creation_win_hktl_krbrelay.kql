// Title: HackTool - KrbRelay Execution
// Sigma ID: e96253b8-6b3b-4f90-9e59-3b24b99cf9b4
// Status: test | Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2022-04-27 | Modified: 2023-02-04
// ATT&CK: credential-access, T1558.003
// Description: Detects the use of KrbRelay, a Kerberos relaying tool
// False positives:
//   - Unlikely
// References:
//   - https://github.com/cube0x0/KrbRelay
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/process_creation/proc_creation_win_hktl_krbrelay.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (FolderPath endswith "\\KrbRelay.exe" or ProcessVersionInfoOriginalFileName =~ "KrbRelay.exe") or (ProcessCommandLine contains " -spn " and ProcessCommandLine contains " -clsid " and ProcessCommandLine contains " -rbcd ") or (ProcessCommandLine contains "shadowcred" and ProcessCommandLine contains "clsid" and ProcessCommandLine contains "spn") or (ProcessCommandLine contains "spn " and ProcessCommandLine contains "session " and ProcessCommandLine contains "clsid ")
