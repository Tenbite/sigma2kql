// Title: Powershell Token Obfuscation - Process Creation
// Sigma ID: deb9b646-a508-44ee-b7c9-d8965921c6b6
// Status: test | Level: high
// Author: frack113
// Date: 2022-12-27 | Modified: 2026-03-16
// ATT&CK: stealth, T1027.009
// Description: Detects TOKEN OBFUSCATION technique from Invoke-Obfuscation
// False positives:
//   - Unknown
// References:
//   - https://github.com/danielbohannon/Invoke-Obfuscation
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/process_creation/proc_creation_win_powershell_token_obfuscation.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (ProcessCommandLine matches regex "\\w+`(?:\\w+|-|.)`[\\w+|\\s]" or ProcessCommandLine matches regex "\"(?:\\{\\d\\})+\"\\s*-f" or ProcessCommandLine matches regex "(?i)\\$\\{`?e`?n`?v`?:`?p`?a`?t`?h`?\\}") and (not(ProcessCommandLine contains "${env:path}"))
