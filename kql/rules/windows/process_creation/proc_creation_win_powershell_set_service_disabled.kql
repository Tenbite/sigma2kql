// Title: Service StartupType Change Via PowerShell Set-Service
// Sigma ID: 62b20d44-1546-4e61-afce-8e175eb9473c
// Status: test | Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-03-04 | Modified: -
// ATT&CK: execution, defense-impairment, T1685
// Description: Detects the use of the PowerShell "Set-Service" cmdlet to change the startup type of a service
//   to "disabled" or "manual"
// False positives:
//   - False positives may occur with troubleshooting scripts
// References:
//   - https://www.virustotal.com/gui/file/38283b775552da8981452941ea74191aa0d203edd3f61fb2dee7b0aea3514955
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/process_creation/proc_creation_win_powershell_set_service_disabled.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (FolderPath endswith "\\powershell.exe" or ProcessVersionInfoOriginalFileName =~ "PowerShell.EXE") and ((ProcessCommandLine contains "Set-Service" and ProcessCommandLine contains "-StartupType") and (ProcessCommandLine contains "Disabled" or ProcessCommandLine contains "Manual"))
