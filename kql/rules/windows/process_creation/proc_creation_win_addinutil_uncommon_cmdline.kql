// Title: Uncommon AddinUtil.EXE CommandLine Execution
// Sigma ID: 4f2cd9b6-4a17-440f-bb2a-687abb65993a
// Status: test | Level: medium
// Author: Michael McKinley (@McKinleyMike), Tony Latteri (@TheLatteri)
// Date: 2023-09-18 | Modified: -
// ATT&CK: stealth, T1218
// Description: Detects execution of the Add-In deployment cache updating utility (AddInutil.exe) with uncommon
//   Addinroot or Pipelineroot paths. An adversary may execute AddinUtil.exe with uncommon
//   Addinroot/Pipelineroot paths that point to the adversaries Addins.Store payload.
// False positives:
//   - Unknown
// References:
//   - https://www.blue-prints.blog/content/blog/posts/lolbin/addinutil-lolbas.html
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules/windows/process_creation/proc_creation_win_addinutil_uncommon_cmdline.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\addinutil.exe" or ProcessVersionInfoOriginalFileName =~ "AddInUtil.exe") and (ProcessCommandLine contains "-AddInRoot:" or ProcessCommandLine contains "-PipelineRoot:")) and (not((ProcessCommandLine contains "-AddInRoot:\"C:\\Program Files (x86)\\Common Files\\Microsoft Shared\\VSTA" or ProcessCommandLine contains "-AddInRoot:C:\\Program Files (x86)\\Common Files\\Microsoft Shared\\VSTA" or ProcessCommandLine contains "-PipelineRoot:\"C:\\Program Files (x86)\\Common Files\\Microsoft Shared\\VSTA" or ProcessCommandLine contains "-PipelineRoot:C:\\Program Files (x86)\\Common Files\\Microsoft Shared\\VSTA")))
