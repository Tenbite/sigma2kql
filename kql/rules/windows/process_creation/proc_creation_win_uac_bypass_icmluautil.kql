// Title: UAC Bypass via ICMLuaUtil
// Sigma ID: 49f2f17b-b4c8-4172-a68b-d5bf95d05130
// Status: test | Level: high
// Author: Florian Roth (Nextron Systems), Elastic (idea)
// Date: 2022-09-13 | Modified: 2022-09-27
// ATT&CK: privilege-escalation, T1548.002
// Description: Detects the pattern of UAC Bypass using ICMLuaUtil Elevated COM interface
// False positives:
//   - Unknown
// References:
//   - https://www.elastic.co/guide/en/security/current/uac-bypass-via-icmluautil-elevated-com-interface.html
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_uac_bypass_icmluautil.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where (InitiatingProcessFolderPath endswith "\\dllhost.exe" and (InitiatingProcessCommandLine contains "/Processid:{3E5FC7F9-9A51-4367-9063-A120244FBEC7}" or InitiatingProcessCommandLine contains "/Processid:{D2E7041B-2927-42FB-8E9F-7CE93B6DC937}")) and (not((FolderPath endswith "\\WerFault.exe" or ProcessVersionInfoOriginalFileName =~ "WerFault.exe")))
