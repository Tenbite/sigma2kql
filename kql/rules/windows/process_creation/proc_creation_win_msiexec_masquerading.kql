// Title: Potential MsiExec Masquerading
// Sigma ID: e22a6eb2-f8a5-44b5-8b44-a2dbd47b1144
// Status: test | Level: high
// Author: Florian Roth (Nextron Systems)
// Date: 2019-11-14 | Modified: 2026-10-31
// ATT&CK: stealth, T1036.005
// Description: Detects the execution of msiexec.exe from an uncommon directory
// False positives:
//   - Unknown
// References:
//   - https://twitter.com/200_okay_/status/1194765831911215104
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/483b91bb583250faca0aa87415d4187a3ea2c957/rules/windows/process_creation/proc_creation_win_msiexec_masquerading.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (FolderPath endswith "\\msiexec.exe" or ProcessVersionInfoOriginalFileName =~ "msiexec.exe") and (not((FolderPath startswith "C:\\Windows\\System32\\" or FolderPath startswith "C:\\Windows\\SysWOW64\\" or FolderPath startswith "C:\\Windows\\WinSxS\\")))
