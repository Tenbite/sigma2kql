// Title: PUA - Nmap/Zenmap Execution
// Sigma ID: f6ecd1cf-19b8-4488-97f6-00f0924991a3
// Status: test | Level: medium
// Author: frack113
// Date: 2021-12-10 | Modified: 2023-12-11
// ATT&CK: discovery, T1046
// Description: Detects usage of namp/zenmap. Adversaries may attempt to get a listing of services running on
//   remote hosts, including those that may be vulnerable to remote software exploitation
// False positives:
//   - Legitimate administrator activity
// References:
//   - https://nmap.org/
//   - https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1046/T1046.md#atomic-test-3---port-scan-nmap-for-windows
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_pua_nmap_zenmap.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where (FolderPath endswith "\\nmap.exe" or FolderPath endswith "\\zennmap.exe") or (ProcessVersionInfoOriginalFileName in~ ("nmap.exe", "zennmap.exe"))
