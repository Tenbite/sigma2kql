// Title: Suspicious Child Process Of Veeam Dabatase
// Sigma ID: d55b793d-f847-4eea-b59a-5ab09908ac90
// Status: test | Level: critical
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2023-05-04 | Modified: -
// ATT&CK: initial-access, persistence, privilege-escalation
// Description: Detects suspicious child processes of the Veeam service process. This could indicate potential
//   RCE or SQL Injection.
// References:
//   - https://labs.withsecure.com/publications/fin7-target-veeam-servers
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/adf5a626c4a776f3f023056f0f398b9523a2f09e/rules/windows/process_creation/proc_creation_win_mssql_veaam_susp_child_processes.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (InitiatingProcessFolderPath endswith "\\sqlservr.exe" and InitiatingProcessCommandLine contains "VEEAMSQL") and (((FolderPath endswith "\\cmd.exe" or FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe" or FolderPath endswith "\\wsl.exe" or FolderPath endswith "\\wt.exe") and (ProcessCommandLine contains "-ex " or ProcessCommandLine contains "bypass" or ProcessCommandLine contains "cscript" or ProcessCommandLine contains "DownloadString" or ProcessCommandLine contains "http://" or ProcessCommandLine contains "https://" or ProcessCommandLine contains "mshta" or ProcessCommandLine contains "regsvr32" or ProcessCommandLine contains "rundll32" or ProcessCommandLine contains "wscript" or ProcessCommandLine contains "copy ")) or (FolderPath endswith "\\net.exe" or FolderPath endswith "\\net1.exe" or FolderPath endswith "\\netstat.exe" or FolderPath endswith "\\nltest.exe" or FolderPath endswith "\\ping.exe" or FolderPath endswith "\\tasklist.exe" or FolderPath endswith "\\whoami.exe"))
