// Title: Potential SPN Enumeration Via Setspn.EXE
// Sigma ID: 1eeed653-dbc8-4187-ad0c-eeebb20e6599
// Status: test | Level: medium
// Author: Markus Neis, keepwatch
// Date: 2018-11-14 | Modified: 2023-10-23
// ATT&CK: credential-access, T1558.003
// Description: Detects service principal name (SPN) enumeration used for Kerberoasting
// False positives:
//   - Administration activity
// References:
//   - https://web.archive.org/web/20200329173843/https://p16.praetorian.com/blog/how-to-use-kerberoasting-t1208-for-privilege-escalation
//   - https://www.praetorian.com/blog/how-to-use-kerberoasting-t1208-for-privilege-escalation/?edition=2019
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_setspn_spn_enumeration.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where (FolderPath endswith "\\setspn.exe" or ProcessVersionInfoOriginalFileName =~ "setspn.exe" or (ProcessVersionInfoFileDescription contains "Query or reset the computer" and ProcessVersionInfoFileDescription contains "SPN attribute")) and (ProcessCommandLine contains " -q " or ProcessCommandLine contains " /q ")
