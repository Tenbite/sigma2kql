// Title: Shell32 DLL Execution in Suspicious Directory
// Sigma ID: 32b96012-7892-429e-b26c-ac2bf46066ff
// Status: test | Level: high
// Author: Christian Burkard (Nextron Systems)
// Date: 2021-11-24 | Modified: 2023-02-09
// ATT&CK: execution, stealth, T1218.011
// Description: Detects shell32.dll executing a DLL in a suspicious directory
// False positives:
//   - Unknown
// References:
//   - https://www.group-ib.com/resources/threat-research/red-curl-2.html
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_rundll32_shell32_susp_execution.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, microsoft_xdr schema)

DeviceProcessEvents
| where (FolderPath endswith "\\rundll32.exe" or ProcessVersionInfoOriginalFileName =~ "RUNDLL32.EXE") and ((ProcessCommandLine contains "shell32.dll" and ProcessCommandLine contains "Control_RunDLL") and (ProcessCommandLine contains "%AppData%" or ProcessCommandLine contains "%LocalAppData%" or ProcessCommandLine contains "%Temp%" or ProcessCommandLine contains "%tmp%" or ProcessCommandLine contains "\\AppData\\" or ProcessCommandLine contains "\\Temp\\" or ProcessCommandLine contains "\\Users\\Public\\"))
