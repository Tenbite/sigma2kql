// Title: Windows Firewall Disabled via PowerShell
// Sigma ID: 12f6b752-042d-483e-bf9c-915a6d06ad75
// Status: test | Level: medium
// Author: Tim Rauch, Elastic (idea)
// Date: 2022-09-14 | Modified: 2023-02-13
// ATT&CK: defense-impairment, T1685
// Description: Detects attempts to disable the Windows Firewall using PowerShell
// False positives:
//   - Unknown
// References:
//   - https://www.elastic.co/guide/en/security/current/windows-firewall-disabled-via-powershell.html
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/05d1031f537e830b76da53bae2400c5814c89165/rules/windows/process_creation/proc_creation_win_powershell_disable_firewall.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe" or FolderPath endswith "\\powershell_ise.exe") or (ProcessVersionInfoOriginalFileName in~ ("PowerShell.EXE", "pwsh.dll"))) and (ProcessCommandLine contains "Set-NetFirewallProfile " and ProcessCommandLine contains " -Enabled " and ProcessCommandLine contains " False") and (ProcessCommandLine contains " -All " or ProcessCommandLine contains "Public" or ProcessCommandLine contains "Domain" or ProcessCommandLine contains "Private")
