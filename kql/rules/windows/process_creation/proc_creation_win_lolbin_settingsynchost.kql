// Title: Using SettingSyncHost.exe as LOLBin
// Sigma ID: b2ddd389-f676-4ac4-845a-e00781a48e5f
// Status: test | Level: high
// Author: Anton Kutepov, oscd.community
// Date: 2020-02-05 | Modified: 2021-11-27
// ATT&CK: privilege-escalation, persistence, execution, stealth, T1574.008
// Description: Detects using SettingSyncHost.exe to run hijacked binary
// False positives:
//   - Unknown
// References:
//   - https://www.hexacorn.com/blog/2020/02/02/settingsynchost-exe-as-a-lolbin
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/process_creation/proc_creation_win_lolbin_settingsynchost.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (not((FolderPath startswith "C:\\Windows\\System32\\" or FolderPath startswith "C:\\Windows\\SysWOW64\\"))) and (InitiatingProcessCommandLine contains "cmd.exe /c" and InitiatingProcessCommandLine contains "RoamDiag.cmd" and InitiatingProcessCommandLine contains "-outputpath")
