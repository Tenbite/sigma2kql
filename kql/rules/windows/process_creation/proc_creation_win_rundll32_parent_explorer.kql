// Title: Rundll32 Spawned Via Explorer.EXE
// Sigma ID: 1723e720-616d-4ddc-ab02-f7e3685a4713
// Status: test | Level: medium
// Author: CD_ROM_
// Date: 2022-05-21 | Modified: 2023-08-31
// ATT&CK: stealth
// Description: Detects execution of "rundll32.exe" with a parent process of Explorer.exe. This has been
//   observed by variants of Raspberry Robin, as first reported by Red Canary.
// False positives:
//   - Unknown
// References:
//   - https://redcanary.com/blog/raspberry-robin/
//   - https://thedfirreport.com/2022/09/26/bumblebee-round-two/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/process_creation/proc_creation_win_rundll32_parent_explorer.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (InitiatingProcessFolderPath endswith "\\explorer.exe" and (FolderPath endswith "\\rundll32.exe" or ProcessVersionInfoOriginalFileName =~ "RUNDLL32.EXE")) and (not((ProcessCommandLine contains " C:\\Windows\\System32\\" or ProcessCommandLine endswith " -localserver 22d8c27b-47a1-48d1-ad08-7da7abd79617")))
