// Title: New Remote Desktop Connection Initiated Via Mstsc.EXE
// Sigma ID: 954f0af7-62dd-418f-b3df-a84bc2c7a774
// Status: test | Level: medium
// Author: frack113
// Date: 2022-01-07 | Modified: 2024-06-04
// ATT&CK: lateral-movement, T1021.001
// Description: Detects the usage of "mstsc.exe" with the "/v" flag to initiate a connection to a remote server.
//   Adversaries may use valid accounts to log into a computer using the Remote Desktop Protocol
//   (RDP). The adversary may then perform actions as the logged-on user.
// False positives:
//   - WSL (Windows Sub System For Linux)
// References:
//   - https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1021.001/T1021.001.md#t1021001---remote-desktop-protocol
//   - https://learn.microsoft.com/en-us/windows-server/administration/windows-commands/mstsc
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ccbb0369507f796db0b0ae6854c8a2be471b9d84/rules/windows/process_creation/proc_creation_win_mstsc_remote_connection.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language 12.4.1, live Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\mstsc.exe" or ProcessVersionInfoOriginalFileName =~ "mstsc.exe") and (ProcessCommandLine contains " -v:" or ProcessCommandLine contains " /v:" or ProcessCommandLine contains " –v:" or ProcessCommandLine contains " —v:" or ProcessCommandLine contains " ―v:")) and (not((InitiatingProcessFolderPath =~ "C:\\Windows\\System32\\lxss\\wslhost.exe" and ProcessCommandLine contains "C:\\ProgramData\\Microsoft\\WSL\\wslg.rdp")))
