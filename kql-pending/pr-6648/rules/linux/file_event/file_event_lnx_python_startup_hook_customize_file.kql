// Pull request author: elhoim
// Change: new rule
// Title: Potential Python Startup Hook Customize File Created - Linux
// Sigma ID: 58ccd8d4-d435-408b-9ae7-c7aa1911bd7f
// Status: experimental | Level: medium
// Author: elhoim
// Date: 2026-11-18 | Modified: -
// ATT&CK: persistence, privilege-escalation, T1546.018
// Description: Detects the creation of a "sitecustomize.py" or "usercustomize.py" file. The Python "site"
//   module automatically imports these files at interpreter startup, so code placed in them runs
//   every time Python starts for the user or system-wide, which adversaries abuse for persistence
//   and code execution.
// False positives:
//   - Python packages or environment managers legitimately shipping a "sitecustomize.py" (e.g. coverage or profiling tooling)
// References:
//   - https://docs.python.org/3/library/site.html
//   - https://dfir.ch/posts/publish_python_pth_extension/
//   - https://github.com/redcanaryco/atomic-red-team/blob/388942adbd9641f4dfdcf079d7efe9a75ec0ac43/atomics/T1546.018/T1546.018.md
//   - https://blog.talosintelligence.com/the-serpents-tongue-luring-the-python-out-of-its-den/
//   - https://securitylabs.datadoghq.com/articles/litellm-compromised-pypi-docker/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/916b43c3d4e63a69bebd374eebcc95731dc1c8e4/rules/linux/file_event/file_event_lnx_python_startup_hook_customize_file.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceFileEvents
| where (FolderPath endswith "/sitecustomize.py" or FolderPath endswith "/usercustomize.py") and (not((InitiatingProcessFolderPath matches regex "^/(usr/)?s?bin/(apk|apt|apt-get|dnf|dnf5|dpkg|rpm|yum|zypper)$" and (FolderPath startswith "/etc/python" or FolderPath startswith "/usr/lib/python" or FolderPath startswith "/usr/lib64/python" or FolderPath startswith "/usr/local/lib/python"))))
