// PENDING: from an OPEN SigmaHQ pull request. Not reviewed or merged by SigmaHQ yet.
// Pull request: #6262 new: add coverage for schtasks creation via Schedule.Service ComObject
// Pull request URL: https://github.com/SigmaHQ/sigma/pull/6262
// Pull request author: swachchhanda000
// Change: new rule
// Title: Powershell Create Scheduled Task via CommandLine
// Sigma ID: 3a00e18c-bde4-4e81-bc8f-500e24c720a6
// Status: experimental | Level: medium
// Author: frack113, Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-08-25 | Modified: -
// ATT&CK: execution, persistence, privilege-escalation, T1053.005
// Description: Detects PowerShell invocations that create scheduled tasks via the command line. Covers native
//   PowerShell cmdlets (e.g. Register-ScheduledTask), the WMI/CIM method, and the Schedule.Service
//   COM object (which bypasses schtasks.exe-based detections).
// False positives:
//   - Legitimate administrative scripts passed inline on the command line
// References:
//   - https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1053.005/T1053.005.md#atomic-test-4---powershell-cmdlet-scheduled-task
//   - https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1053.005/T1053.005.md#atomic-test-6---wmi-invoke-cimmethod-scheduled-task
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/342ccf844e2719b464aa96f85298dfb541a52769/rules/windows/process_creation/proc_creation_win_powershell_create_schtasks.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") or (ProcessVersionInfoOriginalFileName in~ ("powershell.exe", "pwsh.dll"))) and ((ProcessCommandLine contains "New-ScheduledTaskAction" or ProcessCommandLine contains "New-ScheduledTaskTrigger" or ProcessCommandLine contains "New-ScheduledTaskPrincipal" or ProcessCommandLine contains "New-ScheduledTaskSettingsSet" or ProcessCommandLine contains "New-ScheduledTask" or ProcessCommandLine contains "Register-ScheduledTask") or (ProcessCommandLine contains "Invoke-CimMethod" and ProcessCommandLine contains "-ClassName" and ProcessCommandLine contains "PS_ScheduledTask" and ProcessCommandLine contains "-NameSpace" and ProcessCommandLine contains "Root\\Microsoft\\Windows\\TaskScheduler") or (ProcessCommandLine contains "-ComObject" and ProcessCommandLine contains "Schedule.Service" and ProcessCommandLine contains "RegisterTaskDefinition"))
