// Title: Esentutl Write To Alternate Data Stream
// Sigma ID: d6df5c7d-8566-441a-ac2b-f4fdbab4944b
// Status: experimental | Level: high
// Author: EinLamYe
// Date: 2026-06-29 | Modified: -
// ATT&CK: stealth, T1564.004
// Description: Detects usage of "esentutl.exe" in its copy/duplicate mode (/y /d) where the destination is an
//   NTFS Alternate Data Stream (ADS). Adversaries abuse this LOLBin to stash an executable payload
//   inside an ADS in order to hide it from directory listings and evade detection.
// False positives:
//   - Unknown
// References:
//   - https://lolbas-project.github.io/lolbas/Binaries/Esentutl/
//   - https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1564.004/T1564.004.md
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/c5875f6ddd2f5087d0f0a63a34a2ed4468a9d328/rules/windows/process_creation/proc_creation_win_lolbin_esentutl_ads.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (FolderPath endswith "\\esentutl.exe" or ProcessVersionInfoOriginalFileName =~ "esentutl.exe") and (ProcessCommandLine contains " /y" and ProcessCommandLine contains " /d") and ProcessCommandLine matches regex "\\\\[^\\\\ ]+:[^\\\\/ ]"
