// Title: Expand Write To Alternate Data Stream
// Sigma ID: 8f3e4199-4b91-47ea-92d8-def43ccbd14f
// Status: experimental | Level: high
// Author: EinLamYe
// Date: 2026-06-29 | Modified: -
// ATT&CK: stealth, T1564.004
// Description: Detects usage of "expand.exe" where the destination is an NTFS Alternate Data Stream (ADS).
//   Adversaries abuse "expand.exe" to copy a (potentially remote) file into an ADS in order to hide
//   a payload and evade detection.
// False positives:
//   - Unknown
// References:
//   - https://lolbas-project.github.io/lolbas/Binaries/Expand/
//   - https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1564.004/T1564.004.md
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/c5875f6ddd2f5087d0f0a63a34a2ed4468a9d328/rules/windows/process_creation/proc_creation_win_lolbin_expand_ads.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (FolderPath endswith "\\expand.exe" or ProcessVersionInfoOriginalFileName =~ "expand.exe") and ProcessCommandLine matches regex "\\\\[^\\\\ ]+:[^\\\\/ ]"
