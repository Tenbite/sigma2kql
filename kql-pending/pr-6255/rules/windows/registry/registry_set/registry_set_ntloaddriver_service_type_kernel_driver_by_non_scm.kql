// Pull request: #6255 new: BTR Reforged Exploit
// Pull request URL: https://github.com/SigmaHQ/sigma/pull/6255
// Pull request author: swachchhanda000
// Change: new rule
// Title: Potential NtLoadDriver Syscall Abuse to Load Suspicious Kernel Driver Service
// Sigma ID: 2e8a4f61-7d3b-4c95-a1e8-9f5c2b7d0413
// Status: experimental | Level: medium
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-08-24 | Modified: -
// ATT&CK: stealth, defense-impairment, privilege-escalation, persistence, T1543.003, T1112
// Description: Detects a service Type registry value being set to 1 (kernel driver) by potentially suspicious
//   non-legitimate processes. Calls the undocumented NtLoadDriver syscall, this bypasses SCM,
//   meaning Event ID 7045 will not trigger. Threat actors can abuse this to load a malicious or
//   vulnerable kernel driver in order to disable security products, achieve persistence, or perform
//   arbitrary kernel operations.
// False positives:
//   - Third-party driver installers writing service keys directly via registry API
// References:
//   - https://research.checkpoint.com/2026/btr-reforged-weaponizing-defenders-remediation-driver-as-a-kernel-operation-primitive/
//   - http://undocumented.ntinternals.net/index.html?page=UserMode%2FUndocumented%20Functions%2FExecutable%20Images%2FNtLoadDriver.html
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/8083136c567777cc662626deeeac153dd2bd3a69/rules/windows/registry/registry_set/registry_set_ntloaddriver_service_type_kernel_driver_by_non_scm.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.
// Note: 2 wildcard comparison(s) rewritten to 'matches regex' (KQL treats * in contains/endswith/== as a literal character)

DeviceRegistryEvents
| where ((RegistryKey matches regex @"(?i)\\SYSTEM\\CurrentControlSet\\Services.*$" or (RegistryKey contains "\\SYSTEM\\ControlSet" and RegistryKey matches regex @"(?i)\\Services.*$")) and (RegistryKey endswith "\\Type" and RegistryValueData =~ "DWORD (0x00000001)")) and (not((InitiatingProcessFolderPath =~ "SYSTEM" or (InitiatingProcessFolderPath startswith "C:\\Windows\\Installer\\" and InitiatingProcessFolderPath endswith ".tmp") or ((InitiatingProcessFolderPath startswith "C:\\Windows\\system32\\" or InitiatingProcessFolderPath startswith "C:\\Windows\\SysWOW64\\" or InitiatingProcessFolderPath startswith "C:\\Windows\\WinSxS\\" or InitiatingProcessFolderPath startswith "C:\\Windows\\uus\\") and (InitiatingProcessFolderPath endswith "\\drvinst.exe" or InitiatingProcessFolderPath endswith "\\loginui.exe" or InitiatingProcessFolderPath endswith "\\loginw32.exe" or InitiatingProcessFolderPath endswith "\\msiexec.exe" or InitiatingProcessFolderPath endswith "\\ntoskrnl.exe" or InitiatingProcessFolderPath endswith "\\poqexec.exe" or InitiatingProcessFolderPath endswith "\\rundll32.exe" or InitiatingProcessFolderPath endswith "\\services.exe" or InitiatingProcessFolderPath endswith "\\silsvc.exe" or InitiatingProcessFolderPath endswith "\\TiWorker.exe" or InitiatingProcessFolderPath endswith "\\waasmedicagent.exe" or InitiatingProcessFolderPath endswith "\\wininit.exe")) or (InitiatingProcessFolderPath startswith "C:\\Program Files\\" or InitiatingProcessFolderPath startswith "C:\\Program Files (x86)\\" or InitiatingProcessFolderPath startswith "C:\\ProgramData\\")))) and (not(((InitiatingProcessFolderPath endswith "\\procexp.exe" or InitiatingProcessFolderPath endswith "\\procexp64.exe" or InitiatingProcessFolderPath endswith "\\procexp64a.exe") and RegistryKey contains "\\Services\\PROCEXP")))
