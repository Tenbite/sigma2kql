// PENDING: from an OPEN SigmaHQ pull request. Not reviewed or merged by SigmaHQ yet.
// Pull request: #6328 Microsoft Office Application Loading Task Scheduler DLL
// Pull request URL: https://github.com/SigmaHQ/sigma/pull/6328
// Pull request author: saksham-17
// Change: new rule
// Title: Microsoft Office Application Loading Task Scheduler DLL
// Sigma ID: 8d1e674c-5c03-4be1-949c-4b85a472dc16
// Status: experimental | Level: medium
// Author: Saksham Bhattarai
// Date: 2026-11-02 | Modified: -
// ATT&CK: persistence, privilege-escalation, T1053.005, execution, T1204.002
// Description: Detects a Microsoft Office application loading taskschd.dll, which exposes COM interfaces for
//   managing Windows Scheduled Tasks. This load is an early precursor to scheduled task creation or
//   modification and has been frequently observed in macro-enabled malicious documents attempting to
//   establish persistence.
// False positives:
//   - Legitimate add-ins or automation scripts that use Office applications to manage scheduled tasks (rare in most environments)
// References:
//   - https://github.com/saksham-17/detection-lab/blob/cbc25dfe1e5eda0c4e5a7d66b6d3bbd27829e158/T1053.005-scheduled-task/tests/test5-task-scheduler-via-VBA/report.md
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/820c1333588ea6ceb92564d45e5d4e647e218528/rules/windows/image_load/image_load_office_taskschd_dll_load.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceImageLoadEvents
| where (FolderPath endswith "\\taskschd.dll" or InitiatingProcessVersionInfoOriginalFileName =~ "taskschd.dll") and (InitiatingProcessFolderPath endswith "\\eqnedt32.exe" or InitiatingProcessFolderPath endswith "\\excel.exe" or InitiatingProcessFolderPath endswith "\\fltldr.exe" or InitiatingProcessFolderPath endswith "\\graph.exe" or InitiatingProcessFolderPath endswith "\\msaccess.exe" or InitiatingProcessFolderPath endswith "\\mspub.exe" or InitiatingProcessFolderPath endswith "\\onenote.exe" or InitiatingProcessFolderPath endswith "\\onenoteim.exe" or InitiatingProcessFolderPath endswith "\\onenotem.exe" or InitiatingProcessFolderPath endswith "\\outlook.exe" or InitiatingProcessFolderPath endswith "\\powerpnt.exe" or InitiatingProcessFolderPath endswith "\\visio.exe" or InitiatingProcessFolderPath endswith "\\winproj.exe" or InitiatingProcessFolderPath endswith "\\winword.exe")
