// Change: new rule
// Title: Startup Items Enumeration Via CommandLine Utility
// Sigma ID: 5ddf2c53-4535-4285-a298-e089ddf4c698
// Status: experimental | Level: medium
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-06-02 | Modified: -
// ATT&CK: discovery, T1082
// Description: Detects enumeration of startup items on Windows via WMIC or PowerShell WMI/CIM cmdlets. Startup
//   items are programs configured to run automatically at boot. Attackers may enumerate them during
//   reconnaissance or to verify their own persistence mechanisms have been added successfully.
// False positives:
//   - Legitimate administration and endpoint management activity (SCCM, Intune, inventory scripts).
// References:
//   - https://lolbas-project.github.io/lolbas/Binaries/Wmic/
//   - https://blog.talosintelligence.com/uat-8302/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/40aa27b6b02ea945e964ceee5e4eef63f1944300/rules/windows/process_creation/proc_creation_win_susp_startup_enumeration.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\wmic.exe" or ProcessVersionInfoOriginalFileName =~ "wmic.exe") and ProcessCommandLine contains " startup " and (ProcessCommandLine contains " get " or ProcessCommandLine contains " list ")) or (((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") or (ProcessVersionInfoOriginalFileName in~ ("PowerShell.EXE", "pwsh.dll"))) and (ProcessCommandLine contains "Get-CimInstance" or ProcessCommandLine contains "Get-WmiObject" or ProcessCommandLine contains "gwmi " or ProcessCommandLine contains "gcim ") and ProcessCommandLine contains "Win32_StartupCommand")
