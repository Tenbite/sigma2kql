// PENDING: from an OPEN SigmaHQ pull request. Not reviewed or merged by SigmaHQ yet.
// Pull request: #6522 fix: Legitimate Application Writing Files In Uncommon Location - filter expand.exe $dpx$ scratch files and certutil RootCAs.sst written as S
// Pull request URL: https://github.com/SigmaHQ/sigma/pull/6522
// Pull request author: redsand
// Change: update to existing rule
// Title: Legitimate Application Writing Files In Uncommon Location
// Sigma ID: 1cf465a1-2609-4c15-9b66-c32dbe4bfd67
// Status: experimental | Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2025-12-10 | Modified: 2026-10-26
// ATT&CK: stealth, T1218, command-and-control, T1105
// Description: Detects legitimate applications writing any type of file to uncommon or suspicious locations
//   that are not typical for application data storage or execution. Adversaries may leverage
//   legitimate applications (Living off the Land Binaries - LOLBins) to drop or download malicious
//   files to uncommon locations on the system to evade detection by security solutions.
// False positives:
//   - Unknown
// References:
//   - https://lolbas-project.github.io/#/download
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/28a2f864e7e0fec38b4ae74b80977023742fc13b/rules/windows/file/file_event/file_event_win_susp_legitimate_app_dropping_in_uncommon_location.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceFileEvents
| where ((InitiatingProcessFolderPath endswith "\\eqnedt32.exe" or InitiatingProcessFolderPath endswith "\\wordpad.exe" or InitiatingProcessFolderPath endswith "\\wordview.exe" or InitiatingProcessFolderPath endswith "\\cmdl32.exe" or InitiatingProcessFolderPath endswith "\\certutil.exe" or InitiatingProcessFolderPath endswith "\\certoc.exe" or InitiatingProcessFolderPath endswith "\\CertReq.exe" or InitiatingProcessFolderPath endswith "\\bitsadmin.exe" or InitiatingProcessFolderPath endswith "\\Desktopimgdownldr.exe" or InitiatingProcessFolderPath endswith "\\esentutl.exe" or InitiatingProcessFolderPath endswith "\\expand.exe" or InitiatingProcessFolderPath endswith "\\extrac32.exe" or InitiatingProcessFolderPath endswith "\\replace.exe" or InitiatingProcessFolderPath endswith "\\mshta.exe" or InitiatingProcessFolderPath endswith "\\ftp.exe" or InitiatingProcessFolderPath endswith "\\Ldifde.exe" or InitiatingProcessFolderPath endswith "\\RdrCEF.exe" or InitiatingProcessFolderPath endswith "\\hh.exe" or InitiatingProcessFolderPath endswith "\\finger.exe" or InitiatingProcessFolderPath endswith "\\findstr.exe") and (FolderPath contains ":\\Perflogs" or FolderPath contains ":\\ProgramData\\" or FolderPath contains ":\\Temp\\" or FolderPath contains ":\\Users\\Public\\" or FolderPath contains ":\\Windows\\" or FolderPath contains "\\$Recycle.Bin\\" or FolderPath contains "\\AppData\\Local\\" or FolderPath contains "\\AppData\\Roaming\\" or FolderPath contains "\\Contacts\\" or FolderPath contains "\\Desktop\\" or FolderPath contains "\\Favorites\\" or FolderPath contains "\\Favourites\\" or FolderPath contains "\\inetpub\\wwwroot\\" or FolderPath contains "\\Music\\" or FolderPath contains "\\Pictures\\" or FolderPath contains "\\Start Menu\\Programs\\Startup\\" or FolderPath contains "\\Users\\Default\\" or FolderPath contains "\\Videos\\")) and (not(((InitiatingProcessFolderPath endswith "\\esentutl.exe" and (FolderPath startswith "C:\\Windows\\System32\\SRUDB_" or FolderPath startswith "C:\\Windows\\System32\\TEMPREPAIR") and (FolderPath endswith ".INTEG.RAW" or FolderPath endswith ".EDB")) or (InitiatingProcessFolderPath endswith "\\esentutl.exe" and FolderPath startswith "C:\\ProgramData\\Dell\\DTP\\DB\\SRUDBData\\") or (InitiatingProcessFolderPath endswith "\\expand.exe" and (RequestAccountName contains "AUTHORI" or RequestAccountName contains "AUTORI") and FolderPath startswith "C:\\Windows\\Temp\\" and FolderPath contains "$dpx$.tmp") or (InitiatingProcessFolderPath endswith "\\certutil.exe" and (RequestAccountName contains "AUTHORI" or RequestAccountName contains "AUTORI") and FolderPath startswith "C:\\Windows\\SystemTemp\\" and FolderPath endswith "\\RootCAs.sst"))))
