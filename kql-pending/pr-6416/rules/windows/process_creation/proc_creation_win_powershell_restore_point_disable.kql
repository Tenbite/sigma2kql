// Change: new rule
// Title: System Restore Point Disabling or Removal Attempt via PowerShell
// Sigma ID: f33aef95-e27b-414f-ba14-b2e363692486
// Status: experimental | Level: medium
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-10-02 | Modified: -
// ATT&CK: impact, T1490
// Description: Detects PowerShell commands that attempt to disable or remove Windows System Restore Points.
//   This technique is used by attackers post-intrusion to inhibit system recovery, commonly observed
//   alongside shadow copy deletion in ransomware operations.
// False positives:
//   - Legitimate administrator actions
// References:
//   - https://learn.microsoft.com/en-us/powershell/module/microsoft.powershell.management/disable-computerrestore?view=powershell-5.1
//   - https://securelist.ru/tr/hacking-cat/117062/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/b52c3cce054de01ac594f211f111b75c62e6267f/rules/windows/process_creation/proc_creation_win_powershell_restore_point_disable.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") or (ProcessVersionInfoOriginalFileName in~ ("PowerShell.EXE", "pwsh.dll"))) and (ProcessCommandLine contains "Disable-ComputerRestore" or ProcessCommandLine contains "Remove-ComputerRestorePoint")
