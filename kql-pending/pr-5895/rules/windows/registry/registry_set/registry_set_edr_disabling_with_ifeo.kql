// PENDING: from an OPEN SigmaHQ pull request. Not reviewed or merged by SigmaHQ yet.
// Pull request: #5895 feat: addition of EDR disabling through mitigation options
// Pull request URL: https://github.com/SigmaHQ/sigma/pull/5895
// Pull request author: kurisukun
// Change: new rule
// Title: EDR Disabling through Image File Execution Options
// Sigma ID: 7c217021-17ef-4208-9f88-3c4cc3d049fb
// Status: experimental | Level: high
// Author: Chris Barros Henriques (Swiss Post Cybersecurity)
// Date: 2026-03-06 | Modified: -
// ATT&CK: defense-evasion, T1562.001
// Description: Detects the creation of a new key under `HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Image
//   File Execution Options` with a MitigationOptions value on a specific EDR process. This prevents
//   the targeted process from loading non-Microsoft-signed DLLs, breaking EDR functionality that
//   relies on vendor-signed DLL.
// False positives:
//   - Legitimate updates from the AV/EDR itself
// References:
//   - https://www.orangecyberdefense.com/global/blog/cybersecurity/fairy-law
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/c7c51a25de685cd35de4c797c2bbbbf0c9267230/rules/windows/registry/registry_set/registry_set_edr_disabling_with_ifeo.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceRegistryEvents
| where ((RegistryKey startswith "HKEY_LOCAL_MACHINE\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Image File Execution Options" and (RegistryKey contains "MitigationOptions" or RegistryKey contains "MitigationAuditOptions")) and (RegistryKey contains "SentinelAgent.exe" or RegistryKey contains "SentinelAgentWorker.exe" or RegistryKey contains "SentinelCleaner.exe" or RegistryKey contains "SentinelCtl.exe" or RegistryKey contains "SentinelHelperService.exe" or RegistryKey contains "SentinelMemoryScanner.exe" or RegistryKey contains "SentinelRemediation.exe" or RegistryKey contains "SentinelServiceHost.exe" or RegistryKey contains "SentinelStaticEngine.exe" or RegistryKey contains "SentinelStaticEngineScanner.exe" or RegistryKey contains "SentinelUI.exe" or RegistryKey contains "mfetp.exe" or RegistryKey contains "mfeatp.exe" or RegistryKey contains "mfeesp.exe" or RegistryKey contains "macomserver.exe" or RegistryKey contains "mfemms.exe" or RegistryKey contains "mfefire.exe" or RegistryKey contains "mfehcs.exe" or RegistryKey contains "mcshield.exe" or RegistryKey contains "mfevtps.exe" or RegistryKey contains "mfewc.exe" or RegistryKey contains "HMPAlert.exe" or RegistryKey contains "SEDService.exe" or RegistryKey contains "SEDTelemetry.exe" or RegistryKey contains "SLDService.exe" or RegistryKey contains "SNTPService.exe" or RegistryKey contains "Sophos UI.exe" or RegistryKey contains "SophosMainUI.exe" or RegistryKey contains "SophosAMSITelemetryCollector.exe" or RegistryKey contains "SophosCleanup.exe" or RegistryKey contains "SophosESH.exe" or RegistryKey contains "SophosESHTelemetry.exe" or RegistryKey contains "SophosFileScanner.exe" or RegistryKey contains "SophosFS.exe" or RegistryKey contains "Sophos.exe" or RegistryKey contains "SophosOSQuery.exe" or RegistryKey contains "SSPService.exe" or RegistryKey contains "BDRedline.exe" or RegistryKey contains "EPConsole.exe" or RegistryKey contains "EPIntegrationService.exe" or RegistryKey contains "EPProtectedService.exe" or RegistryKey contains "EPSecurityService.exe" or RegistryKey contains "EPUpdateService.exe" or RegistryKey contains "EPUpdateServer.exe")) and (not((RegistryValueData in~ ("-", "(empty)"))))
