// Pull request author: swachchhanda000
// Change: new rule
// Title: Suspicious Renamed System Binaries Execution
// Sigma ID: 88d67e95-c155-43ce-8bb6-4530d488629b
// Status: experimental | Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-03-03 | Modified: -
// ATT&CK: stealth, T1036.003
// Description: Detects execution of system binaries that have been renamed, which is a common technique used by
//   adversaries to evade detection. Attackers often rename legitimate system binaries to bypass
//   security controls and execute malicious payloads without raising suspicion.
// False positives:
//   - Unlikely
// References:
//   - https://arcticwolf.com/resources/blog/sloppylemming-deploys-burrowshell-and-rust-based-rat-to-target-pakistan-and-bangladesh/
//   - https://medium.com/@DCSO_CyTec/shortandmalicious-strelastealer-aims-for-mail-credentials-a4c3e78c8abc
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/88613eedefe2a4c6caa63eaa3d150ce9449655b2/rules/windows/process_creation/proc_creation_win_renamed_susp_system_binaries.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (ProcessVersionInfoOriginalFileName in~ ("msinfo32.exe", "netsh.exe", "packageinspector.exe", "phoneactivate.exe", "slui.exe")) and (not((FolderPath endswith "\\msinfo32.exe" or FolderPath endswith "\\netsh.exe" or FolderPath endswith "\\packageinspector.exe" or FolderPath endswith "\\phoneactivate.exe" or FolderPath endswith "\\slui.exe")))
