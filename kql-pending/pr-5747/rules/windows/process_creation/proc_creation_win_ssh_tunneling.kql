// Pull request author: louiselalanne
// Change: new rule
// Title: SSH Tunneling via SSH Client on Windows
// Sigma ID: 5d0f9e4a-1b6c-4f3e-a8d7-9e0f1a2b3c4d
// Status: experimental | Level: medium
// Author: Louise Lalanne
// Date: 2026-09-30 | Modified: -
// ATT&CK: command-and-control, T1572, T1090.001
// Description: Detects the use of SSH clients on Windows (PuTTY, OpenSSH) to create SSH tunnels, a technique
//   commonly abused to relay traffic into a network, expose internal services to a remote host, or
//   pivot into an otherwise unreachable segment.
// False positives:
//   - Legitimate SSH tunneling by system administrators or developers
// References:
//   - https://www.elastic.co/guide/en/security/current/prebuilt-rule-8-19-29-potential-ssh-reverse-port-forwarding.html
//   - https://man.openbsd.org/ssh.1#-L
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/73d38045adafeed60bfbb14535a38678f0f3fda5/rules/windows/process_creation/proc_creation_win_ssh_tunneling.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\putty.exe" or FolderPath endswith "\\plink.exe") and (ProcessCommandLine contains " -L" or ProcessCommandLine contains " -R" or ProcessCommandLine contains " -D")) or (FolderPath endswith "\\ssh.exe" and (ProcessCommandLine contains " -L" or ProcessCommandLine contains " -R" or ProcessCommandLine contains " -D"))
