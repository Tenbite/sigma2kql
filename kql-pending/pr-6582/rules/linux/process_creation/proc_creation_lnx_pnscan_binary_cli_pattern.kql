// Title: Pnscan Binary Data Transmission Activity
// Sigma ID: 97de11cd-4b67-4abf-9a8b-1020e670aa9e
// Status: test | Level: medium
// Author: David Burkett (@signalblur)
// Date: 2024-04-16 | Modified: -
// ATT&CK: discovery, T1046
// Description: Detects command line patterns associated with the use of Pnscan for sending and receiving binary
//   data across the network. This behavior has been identified in a Linux malware campaign targeting
//   Docker, Apache Hadoop, Redis, and Confluence and was previously used by the threat actor known
//   as TeamTNT
// False positives:
//   - Unknown
// References:
//   - https://www.cadosecurity.com/blog/spinning-yarn-a-new-linux-malware-campaign-targets-docker-apache-hadoop-redis-and-confluence
//   - https://web.archive.org/web/20250319000946/https://intezer.com/wp-content/uploads/2021/09/TeamTNT-Cryptomining-Explosion.pdf
//   - https://regex101.com/r/RugQYK/1
//   - https://www.virustotal.com/gui/file/beddf70a7bab805f0c0b69ac0989db6755949f9f68525c08cb874988353f78a9/content
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/cb982537eb7397f93785ec066cce7b017050a43f/rules/linux/process_creation/proc_creation_lnx_pnscan_binary_cli_pattern.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ProcessCommandLine matches regex "-(W|R)\\s?(\\s|\"|')([0-9a-fA-F]{2}\\s?){2,20}(\\s|\"|')"
