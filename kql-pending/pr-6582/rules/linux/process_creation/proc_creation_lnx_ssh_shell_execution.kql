// Pull request author: elhoim
// Change: update to existing rule
// Title: Shell Invocation Via Ssh - Linux
// Sigma ID: 8737b7f6-8df3-4bb7-b1da-06019b99b687
// Status: test | Level: high
// Author: Li Ling, Andy Parkidomo, Robert Rakowski, Blake Hartstein (Bloomberg L.P.)
// Date: 2024-08-29 | Modified: -
// ATT&CK: execution, T1059
// Description: Detects the use of the "ssh" utility to execute a shell. Such behavior may be associated with
//   privilege escalation, unauthorized command execution, or to break out from restricted
//   environments.
// False positives:
//   - Unknown
// References:
//   - https://gtfobins.github.io/gtfobins/ssh/
//   - https://github.com/elastic/detection-rules/blob/0aacc5e19292f764a002ea2093b2a076db35b589/rules/_deprecated/execution_shell_evasion_linux_binary.toml
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/cb982537eb7397f93785ec066cce7b017050a43f/rules/linux/process_creation/proc_creation_lnx_ssh_shell_execution.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (FolderPath endswith "/ssh" and (ProcessCommandLine contains "ProxyCommand=;" or ProcessCommandLine contains "permitlocalcommand=yes" or ProcessCommandLine contains "localhost")) and (ProcessCommandLine contains "/bin/bash" or ProcessCommandLine contains "/bin/dash" or ProcessCommandLine contains "/bin/fish" or ProcessCommandLine contains "/bin/sh" or ProcessCommandLine contains "/bin/zsh" or ProcessCommandLine contains "sh 0<&2 1>&2" or ProcessCommandLine contains "sh 1>&2 0<&2")
