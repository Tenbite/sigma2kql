// Title: Shadow Copies Creation Using Operating Systems Utilities
// Sigma ID: b17ea6f7-6e90-447e-a799-e6c0a493d6ce
// Status: test | Level: medium
// Author: Teymur Kheirkhabarov, Daniil Yugoslavskiy, oscd.community
// Date: 2019-10-22 | Modified: 2022-11-10
// ATT&CK: credential-access, T1003, T1003.002, T1003.003
// Description: Shadow Copies creation using operating systems utilities, possible credential access
// False positives:
//   - Legitimate administrator working with shadow copies, access for backup purposes
// References:
//   - https://www.slideshare.net/heirhabarov/hunting-for-credentials-dumping-in-windows-environment
//   - https://www.levelblue.com/blogs/spiderlabs-blog/tutorial-for-ntds-goodness-vssadmin-wmis-ntds.dit-system/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/cb982537eb7397f93785ec066cce7b017050a43f/rules/windows/process_creation/proc_creation_win_susp_shadow_copies_creation.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe" or FolderPath endswith "\\wmic.exe" or FolderPath endswith "\\vssadmin.exe") or (ProcessVersionInfoOriginalFileName in~ ("PowerShell.EXE", "pwsh.dll", "wmic.exe", "VSSADMIN.EXE"))) and (ProcessCommandLine contains "shadow" and ProcessCommandLine contains "create")
