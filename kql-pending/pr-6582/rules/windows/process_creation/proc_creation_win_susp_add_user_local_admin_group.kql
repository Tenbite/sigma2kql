// ATT&CK: privilege-escalation, persistence, T1098
// Description: Detects addition of users to the local administrator group via "Net" or "Add-LocalGroupMember".
// False positives:
//   - Administrative activity
// References:
//   - https://blog.talosintelligence.com/recent-cyber-attack/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/cb982537eb7397f93785ec066cce7b017050a43f/rules/windows/process_creation/proc_creation_win_susp_add_user_local_admin_group.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((ProcessCommandLine contains "localgroup " and ProcessCommandLine contains " /add") or (ProcessCommandLine contains "Add-LocalGroupMember " and ProcessCommandLine contains " -Group ")) and (ProcessCommandLine contains " administrators " or ProcessCommandLine contains " administrateur")
