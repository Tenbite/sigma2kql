// Pull request: #6605 New rule: Potential Systemd Credential Exposure Via Temporary Directory
// Pull request URL: https://github.com/SigmaHQ/sigma/pull/6605
// Pull request author: A1B345T1A
// Change: new rule
// Title: Potential Systemd Credential Exposure Via Temporary Directory
// Sigma ID: 66a786dd-39c9-43b6-bc31-224735278a4a
// Status: experimental | Level: medium
// Author: Sairus Santosh
// Date: 2026-11-09 | Modified: -
// ATT&CK: credential-access, T1552.001
// Description: Detects the use of systemd-creds to decrypt credentials into temporary directories such as /tmp,
//   /var/tmp, or /dev/shm. This activity may expose plaintext credentials and should be investigated
//   if unexpected.
// False positives:
//   - Legitimate administrative credential decryption
//   - Authorized testing or maintenance involving temporary files
// References:
//   - https://www.freedesktop.org/software/systemd/man/latest/systemd-creds.html
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/612635809373ca88ea94ab31df0412bcc38d86a5/rules/linux/process_creation/proc_creation_lnx_systemd_creds_decrypt_tmp.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where FolderPath endswith "/systemd-creds" and ProcessCommandLine matches regex "(?:^|\\s)decrypt\\s+(?:--[^\\s]+\\s+)*[^\\s-][^\\s]*\\s+\"?(?:/tmp/|/var/tmp/|/dev/shm/)"
