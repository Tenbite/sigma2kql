// PENDING: from an OPEN SigmaHQ pull request. Not reviewed or merged by SigmaHQ yet.
// Pull request: #6449 Add macOS browser credential and cookie store access rule
// Pull request URL: https://github.com/SigmaHQ/sigma/pull/6449
// Pull request author: yana-ivanov
// Change: new rule
// Title: Potential Browser Credential and Cookie Store Access - macOS
// Sigma ID: f0fba1f3-972d-4209-b652-9fd7196281ab
// Status: experimental | Level: medium
// Author: Yana Ivanov
// Date: 2026-10-10 | Modified: 2026-11-15
// ATT&CK: credential-access, T1555.003, T1539
// Description: Detects copy, archive, read and database tools accessing browser credential and cookie stores
//   from user profile directories on macOS. macOS infostealers such as Atomic Stealer (AMOS) copy
//   Chromium and Firefox profile artifacts including "Login Data", "Cookies" and "Web Data" into a
//   staging directory before archiving and exfiltrating them. The rule requires the accessing
//   process to be one of those tools, because the browsers themselves carry their own profile
//   directory on the command line via --user-data-dir and ship feature flags whose names contain the
//   word Cookies.
// False positives:
//   - Backup, migration or endpoint management tooling that copies user profile data
//   - Browser profile synchronisation or recovery utilities
//   - Administrators or developers inspecting browser profile databases
// References:
//   - https://www.trendmicro.com/en_us/research/25/i/an-mdr-analysis-of-the-amos-stealer-campaign.html
//   - https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1555.003/T1555.003.md
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/64bba8917f35ff34268e97ac5fe73d642e93baca/rules/macos/process_creation/proc_creation_macos_browser_credential_store_access.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (FolderPath endswith "/cat" or FolderPath endswith "/cp" or FolderPath endswith "/mv" or FolderPath endswith "/ditto" or FolderPath endswith "/rsync" or FolderPath endswith "/tar" or FolderPath endswith "/zip" or FolderPath endswith "/curl" or FolderPath endswith "/sqlite3" or FolderPath endswith "/base64" or FolderPath endswith "/osascript" or FolderPath endswith "/sh" or FolderPath endswith "/bash" or FolderPath endswith "/zsh") and (ProcessCommandLine contains "Library/Application Support/Google/Chrome" or ProcessCommandLine contains "Library/Application Support/Chromium" or ProcessCommandLine contains "Library/Application Support/BraveSoftware" or ProcessCommandLine contains "Library/Application Support/Microsoft Edge" or ProcessCommandLine contains "Library/Application Support/Vivaldi" or ProcessCommandLine contains "Library/Application Support/Opera Software" or ProcessCommandLine contains "Library/Application Support/Firefox/Profiles") and (ProcessCommandLine contains "/Login Data" or ProcessCommandLine contains "/Cookies" or ProcessCommandLine contains "/Web Data" or ProcessCommandLine contains "/cookies.sqlite" or ProcessCommandLine contains "/logins.json" or ProcessCommandLine contains "/key4.db")
