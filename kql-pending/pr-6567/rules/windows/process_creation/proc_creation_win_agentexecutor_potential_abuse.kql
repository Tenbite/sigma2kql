// Pull request: #6567 fix: five Windows rules with conditions that can never match
// Pull request URL: https://github.com/SigmaHQ/sigma/pull/6567
// Pull request author: DavidRamPari
// Change: update to existing rule
// Title: AgentExecutor PowerShell Execution
// Sigma ID: 7efd2c8d-8b18-45b7-947d-adfe9ed04f61
// Status: test | Level: medium
// Author: Nasreddine Bencherchali (Nextron Systems), memory-shards
// Date: 2022-12-24 | Modified: 2026-11-05
// ATT&CK: stealth, T1218
// Description: Detects execution of the AgentExecutor.exe binary. Which can be abused as a LOLBIN to execute
//   powershell scripts with the ExecutionPolicy "Bypass" or any binary named "powershell.exe"
//   located in the path provided by 6th positional argument
// False positives:
//   - Legitimate use via Intune management. You exclude script paths and names to reduce FP rate
// References:
//   - https://twitter.com/lefterispan/status/1286259016436514816
//   - https://lolbas-project.github.io/lolbas/OtherMSBinaries/Agentexecutor/
//   - https://learn.microsoft.com/en-us/mem/intune/apps/intune-management-extension
//   - https://twitter.com/jseerden/status/1247985304667066373/photo/1
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/6a30e3674e4b3f048b7d8fbd3dafab5e5d3bf22f/rules/windows/process_creation/proc_creation_win_agentexecutor_potential_abuse.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\AgentExecutor.exe" or ProcessVersionInfoOriginalFileName =~ "AgentExecutor.exe") and (ProcessCommandLine contains " -powershell" or ProcessCommandLine contains " -remediationScript")) and (not(InitiatingProcessFolderPath endswith "\\Microsoft.Management.Services.IntuneWindowsAgent.exe"))
