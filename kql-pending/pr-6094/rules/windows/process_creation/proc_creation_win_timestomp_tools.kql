// Title: Timestomping Via Known Utilities
// Sigma ID: db6d1f1c-5996-4cd8-89f2-e18506649fbc
// Status: experimental | Level: high
// Author: EinLamYe
// Date: 2026-06-29 | Modified: -
// ATT&CK: stealth, T1070.006
// Description: Detects execution of known timestomping utilities and command-line patterns used to modify NTFS
//   file timestamps ($STANDARD_INFORMATION). Adversaries timestomp files to blend malicious
//   artifacts into legitimate directories and evade timeline-based forensic analysis.
// False positives:
//   - Unlikely
// References:
//   - https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1070.006/T1070.006.md
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/8e7b36a9de00c979a098f16eb29c1c22fb63cb4b/rules/windows/process_creation/proc_creation_win_timestomp_tools.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\setmace.exe" or FolderPath endswith "\\timestomp.exe") or (ProcessVersionInfoOriginalFileName in~ ("setmace.exe", "timestomp.exe"))) or ProcessCommandLine contains "setfiletime"
