// PENDING: from an OPEN SigmaHQ pull request. Not reviewed or merged by SigmaHQ yet.
// Pull request: #6523 fix: Disable Windows Event Logging Via Registry - filter DrvInst.exe registering driver event channels
// Pull request URL: https://github.com/SigmaHQ/sigma/pull/6523
// Pull request author: redsand
// Change: update to existing rule
// Title: Disable Windows Event Logging Via Registry
// Sigma ID: 2f78da12-f7c7-430b-8b19-a28f269b77a3
// Status: test | Level: high
// Author: frack113, Nasreddine Bencherchali (Nextron Systems)
// Date: 2022-07-04 | Modified: 2026-10-26
// ATT&CK: defense-impairment, T1685.001
// Description: Detects tampering with the "Enabled" registry key in order to disable Windows logging of a
//   Windows event channel
// False positives:
//   - Rare falsepositives may occur from legitimate administrators disabling specific event log for troubleshooting
// References:
//   - https://twitter.com/WhichbufferArda/status/1543900539280293889
//   - https://github.com/DebugPrivilege/CPP/blob/c39d365617dbfbcb01fffad200d52b6239b2918c/Windows%20Defender/RestoreDefenderConfig.cpp
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/f86483f22a746a1965639eee6b994e18898ea385/rules/windows/registry/registry_set/registry_set_disable_winevt_logging.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.
// Note: 5 wildcard comparison(s) rewritten to 'matches regex' (KQL treats * in contains/endswith/== as a literal character)

DeviceRegistryEvents
| where (RegistryKey matches regex @"(?i)\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels.*$" and RegistryKey endswith "\\Enabled" and RegistryValueData =~ "DWORD (0x00000000)") and (not((InitiatingProcessFolderPath =~ "C:\\Windows\\system32\\wevtutil.exe" or (InitiatingProcessFolderPath in~ ("C:\\Windows\\System32\\DrvInst.exe", "C:\\Windows\\SysWOW64\\DrvInst.exe")) or (InitiatingProcessFolderPath startswith "C:\\Windows\\winsxs\\" and InitiatingProcessFolderPath endswith "\\TiWorker.exe") or (InitiatingProcessFolderPath =~ "C:\\Windows\\System32\\svchost.exe" and (RegistryKey contains "\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\Microsoft-Windows-FileInfoMinifilter" or RegistryKey matches regex @"(?i)\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\Microsoft-Windows-ASN1.*$" or RegistryKey matches regex @"(?i)\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\Microsoft-Windows-Kernel-AppCompat.*$" or RegistryKey matches regex @"(?i)\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\Microsoft-Windows-Runtime\\Error.*$" or RegistryKey matches regex @"(?i)\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\Microsoft-Windows-CAPI2/Operational.*$")) or (InitiatingProcessFolderPath =~ "C:\\Windows\\servicing\\TrustedInstaller.exe" and RegistryKey contains "\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels\\Microsoft-Windows-Compat-Appraiser")))) and (not((InitiatingProcessFolderPath =~ "" or isnull(InitiatingProcessFolderPath))))
