// PENDING: from an OPEN SigmaHQ pull request. Not reviewed or merged by SigmaHQ yet.
// Pull request: #6464 feat(windows): detect potential Veeam credential access via psql.exe
// Pull request URL: https://github.com/SigmaHQ/sigma/pull/6464
// Pull request author: bran-dot-flake
// Change: new rule
// Title: Potential Veeam PostgreSQL Credential Table Query Via Psql.EXE
// Sigma ID: e0d60916-a8dc-4a3a-a6a9-acfd8c10e00e
// Status: experimental | Level: medium
// Author: Brandon Chaney
// Date: 2026-10-14 | Modified: -
// ATT&CK: credential-access, T1555, collection, T1005
// Description: Detects the PostgreSQL psql client executing a SELECT query against the credentials table in the
//   VeeamBackup database. Similar credential access was documented in an Akira ransomware intrusion.
//   Legitimate Veeam credential recovery procedures may also produce this activity.
// False positives:
//   - Authorized Veeam credential recovery or database troubleshooting, as described in Veeam KB4349.
// References:
//   - https://thedfirreport.com/2026/06/29/from-bing-search-to-ransomware-bumblebee-and-adaptixc2-deliver-akira-3/
//   - https://www.veeam.com/kb4349
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/d204349fcf5481ac562c94bc66a703b6e950c951/rules/windows/process_creation/proc_creation_win_psql_veeam_credential_query.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where FolderPath endswith "\\psql.exe" and ProcessCommandLine matches regex "(?i)\\s(?:-d\\s+|--dbname(?:=|\\s+))\"?VeeamBackup\"?(?:\\s|$)" and ProcessCommandLine matches regex "(?i)select\\s" and ProcessCommandLine matches regex "(?i)from\\s+(?:(?:[a-z_][a-z0-9_]*|\"[a-z_][a-z0-9_]*\")\\.)?\"?credentials\"?(?:\\s|[,;)\"]|$)"
