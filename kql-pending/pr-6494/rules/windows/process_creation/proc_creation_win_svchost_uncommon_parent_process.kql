// Status: test | Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2017-08-15 | Modified: 2026-10-22
// ATT&CK: stealth, T1036.005
// Description: Detects an uncommon svchost parent process
// False positives:
//   - Unknown
// References:
//   - Internal Research
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/276ba4a3db114b4bf8993ece754d89d1dcf3035e/rules/windows/process_creation/proc_creation_win_svchost_uncommon_parent_process.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where FolderPath endswith "\\svchost.exe" and (not(((InitiatingProcessFolderPath endswith "\\Mrt.exe" or InitiatingProcessFolderPath endswith "\\MsMpEng.exe" or InitiatingProcessFolderPath endswith "\\ngen.exe" or InitiatingProcessFolderPath endswith "\\rpcnet.exe" or InitiatingProcessFolderPath endswith "\\services.exe" or InitiatingProcessFolderPath endswith "\\TiWorker.exe") or (InitiatingProcessFolderPath endswith "\\svchost.exe" and (FolderPath in~ ("C:\\Windows\\System32\\svchost.exe", "C:\\Windows\\SysWow64\\svchost.exe")) and (ProcessCommandLine endswith "svchost.exe\"" or ProcessCommandLine endswith "svchost.exe")) or ((InitiatingProcessFolderPath in~ ("C:\\Windows\\System32\\svchost.exe", "C:\\Windows\\SysWow64\\svchost.exe")) and (FolderPath in~ ("C:\\Windows\\System32\\svchost.exe", "C:\\Windows\\SysWow64\\svchost.exe")) and (ProcessCommandLine contains " -k " or ProcessCommandLine contains " -p ")) or isnull(InitiatingProcessFolderPath) or (InitiatingProcessFolderPath in~ ("-", "")))))
