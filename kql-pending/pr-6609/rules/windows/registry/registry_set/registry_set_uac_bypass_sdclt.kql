// Title: UAC Bypass via Sdclt
// Sigma ID: 5b872a46-3b90-45c1-8419-f675db8053aa
// Status: test | Level: high
// Author: Omer Yampel, Christian Burkard (Nextron Systems)
// Date: 2017-03-17 | Modified: 2026-11-12
// ATT&CK: privilege-escalation, T1548.002
// Tags: car.2019-04-001
// Description: Detects the pattern of UAC Bypass using registry key manipulation of sdclt.exe (e.g. UACMe 53)
// False positives:
//   - Unknown
// References:
//   - https://enigma0x3.net/2017/03/17/fileless-uac-bypass-using-sdclt-exe/
//   - https://github.com/hfiref0x/UACME
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/23e9c73742bad8c640fa459e2731b003b6f37175/rules/windows/registry/registry_set/registry_set_uac_bypass_sdclt.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.
// Note: 1 wildcard comparison(s) rewritten to 'matches regex' (KQL treats * in contains/endswith/== as a literal character)

DeviceRegistryEvents
| where (RegistryKey endswith "Software\\Classes\\exefile\\shell\\runas\\command\\isolatedCommand" or (RegistryKey endswith "Software\\Classes\\Folder\\shell\\open\\command\\SymbolicLinkValue" and RegistryValueData matches regex "-1[0-9]{3}\\\\Software\\\\Classes\\\\")) and (not((RegistryKey endswith "SOFTWARE\\Classes\\exefile\\shell\\runas\\command\\IsolatedCommand" and (RegistryValueData in~ ("\"%%1\" %%*", "\"%1\" %*"))))) and (not(((InitiatingProcessFolderPath startswith "C:\\Windows\\System32\\" or InitiatingProcessFolderPath startswith "C:\\Windows\\SysWOW64\\" or InitiatingProcessFolderPath startswith "C:\\Windows\\WinSxS\\") and InitiatingProcessFolderPath endswith "\\containerworker.exe" and RegistryKey matches regex @"(?i)\\Windows\\Containers\\Layers.*$")))
