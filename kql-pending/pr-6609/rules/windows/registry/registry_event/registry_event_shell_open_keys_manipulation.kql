// Pull request author: swachchhanda000
// Change: update to existing rule
// Title: Shell Open Registry Keys Manipulation
// Sigma ID: 152f3630-77c1-4284-bcc0-4cc68ab2f6e7
// Status: test | Level: high
// Author: Christian Burkard (Nextron Systems)
// Date: 2021-08-30 | Modified: 2026-11-12
// ATT&CK: persistence, privilege-escalation, T1548.002, T1546.001
// Description: Detects manipulation of shell open command registry keys such as "ms-settings" and "exefile",
//   which are commonly abused to achieve UAC bypass (e.g. via fodhelper.exe) or establish
//   persistence through file association hijacking.
// False positives:
//   - Unknown
// References:
//   - https://github.com/hfiref0x/UACME
//   - https://winscripting.blog/2017/05/12/first-entry-welcome-and-uac-bypass/
//   - https://github.com/RhinoSecurityLabs/Aggressor-Scripts/tree/master/UACBypass
//   - https://tria.ge/211119-gs7rtshcfr/behavioral2 [Lokibot sample from Nov 2021]
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/23e9c73742bad8c640fa459e2731b003b6f37175/rules/windows/registry/registry_event/registry_event_shell_open_keys_manipulation.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.
// Note: 1 wildcard comparison(s) rewritten to 'matches regex' (KQL treats * in contains/endswith/== as a literal character)

DeviceRegistryEvents
| where ((ActionType =~ "RegistryValueSet" and RegistryKey endswith "Classes\\ms-settings\\shell\\open\\command\\SymbolicLinkValue" and RegistryValueData contains "\\Software\\Classes\\{") or RegistryKey endswith "Classes\\ms-settings\\shell\\open\\command\\DelegateExecute" or (ActionType =~ "RegistryValueSet" and (RegistryKey endswith "Classes\\ms-settings\\shell\\open\\command\\(Default)" or RegistryKey endswith "Classes\\exefile\\shell\\open\\command\\(Default)"))) and (not((RegistryValueData =~ "(Empty)" or (RegistryValueData in~ ("{4813071a-41ad-44a2-9835-886d2f63ca30}", "{A56A841F-E974-45C1-8001-7E3F8A085917}", "{4ED3A719-CEA8-4BD9-910D-E252F997AFC2}", "{BFEC0C93-0B7D-4F2C-B09C-AFFFC4BDAE78}")) or (ActionType =~ "RegistryValueSet" and RegistryKey endswith "\\exefile\\shell\\open\\command\\(Default)" and (RegistryValueData in~ ("\"%%1\" %%*", "\"%1\" %*")))))) and (not(((InitiatingProcessFolderPath startswith "C:\\Windows\\System32\\" or InitiatingProcessFolderPath startswith "C:\\Windows\\SysWOW64\\" or InitiatingProcessFolderPath startswith "C:\\Windows\\WinSxS\\") and InitiatingProcessFolderPath endswith "\\containerworker.exe" and RegistryKey matches regex @"(?i)\\Windows\\Containers\\Layers.*$")))
