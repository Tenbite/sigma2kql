// PENDING: from an OPEN SigmaHQ pull request. Not reviewed or merged by SigmaHQ yet.
// Pull request: #6521 fix: Suspicious Run Key from Download - filter installers registering their Program Files app, and key create/delete events
// Pull request URL: https://github.com/SigmaHQ/sigma/pull/6521
// Pull request author: redsand
// Change: update to existing rule
// Title: Suspicious Run Key from Download
// Sigma ID: 9c5037d1-c568-49b3-88c7-9846a5bdc2be
// Status: test | Level: high
// Author: Florian Roth (Nextron Systems), Swachchhanda Shrawan Poude (Nextron Systems)
// Date: 2019-10-01 | Modified: 2026-10-26
// ATT&CK: privilege-escalation, persistence, T1547.001
// Description: Detects the suspicious RUN keys created by software located in Download or temporary
//   Outlook/Internet Explorer directories
// False positives:
//   - Software installers downloaded and used by users
// References:
//   - https://app.any.run/tasks/c5bef5b7-f484-4c43-9cf3-d5c5c7839def/
//   - https://github.com/HackTricks-wiki/hacktricks/blob/e4c7b21b8f36c97c35b7c622732b38a189ce18f7/src/windows-hardening/windows-local-privilege-escalation/privilege-escalation-with-autorun-binaries.md
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/27c3ac204c05d6301a6a923633eafaa3ad49419d/rules/windows/registry/registry_event/registry_event_susp_download_run_key.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.
// Note: 1 wildcard comparison(s) rewritten to 'matches regex' (KQL treats * in contains/endswith/== as a literal character)

DeviceRegistryEvents
| where ((InitiatingProcessFolderPath contains "\\AppData\\Local\\Packages\\Microsoft.Outlook_" or InitiatingProcessFolderPath contains "\\AppData\\Local\\Microsoft\\Olk\\Attachments\\" or InitiatingProcessFolderPath contains "\\Downloads\\" or InitiatingProcessFolderPath contains "\\Temporary Internet Files\\Content.Outlook\\" or InitiatingProcessFolderPath contains "\\Local Settings\\Temporary Internet Files\\") and (RegistryKey contains "\\Software\\Microsoft\\Windows\\CurrentVersion\\Run" or RegistryKey contains "\\Software\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Run" or RegistryKey contains "\\Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer\\Run")) and (not((ActionType in~ ("RegistryKeyCreated", "RegistryKeyDeleted", "RegistryValueDeleted", "DeleteValue")))) and (not((RegistryKey matches regex @"(?i)^HKEY_LOCAL_MACHINE.*$" and (RegistryValueData startswith "C:\\Program Files\\" or RegistryValueData startswith "C:\\Program Files (x86)\\" or RegistryValueData startswith "\"C:\\Program Files\\" or RegistryValueData startswith "\"C:\\Program Files (x86)\\"))))
