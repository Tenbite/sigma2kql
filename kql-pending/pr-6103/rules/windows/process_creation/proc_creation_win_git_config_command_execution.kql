// PENDING: from an OPEN SigmaHQ pull request. Not reviewed or merged by SigmaHQ yet.
// Pull request: #6103 Add rule: arbitrary command execution via git config override
// Pull request URL: https://github.com/SigmaHQ/sigma/pull/6103
// Pull request author: ashish-cybersec
// Change: new rule
// Title: Potential Arbitrary Command Execution Via Git Config Override
// Sigma ID: b551e93d-e3f1-4076-92eb-dd2dbce9e34d
// Status: experimental | Level: medium
// Author: Ashish Pulivarthy (ashish-cybersec)
// Date: 2026-07-02 | Modified: -
// ATT&CK: execution, stealth, T1202
// Description: Detects execution of "git.exe" with an inline configuration override ("-c"). The override points
//   a code-execution directive at a command interpreter. Covered directives include
//   "core.sshCommand", "core.fsmonitor" and "core.pager". Git runs the value of these directives as
//   an external program. A threat actor can therefore use the trusted "git.exe" binary as a proxy.
//   This achieves arbitrary command execution while evading detection. The rule also covers the
//   "ext::" transport. A related abuse stores the payload in a repository's ".git/config" file. It
//   is triggered when an editor or IDE runs "git status" and stays off the command line.
// False positives:
//   - Rare legitimate use of a git configuration directive that points to a scripting interpreter (e.g. a custom pager or editor wrapper). Baseline before enabling.
// References:
//   - https://github.com/justinsteven/advisories/blob/c6754fdb255aed503a3cd40023c54419f820c3b3/2022_git_buried_bare_repos_and_fsmonitor_various_abuses.md
//   - https://www.cobalt.io/blog/red-team-technique-exploiting-git-fsmonitor-for-initial-access
//   - https://github.com/RootUp/git-fsmonitor
//   - https://gtfobins.github.io/gtfobins/git/
//   - https://git-scm.com/docs/git-remote-ext
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/571554a631b20ef57b205de5924f3cceefb3d30d/rules/windows/process_creation/proc_creation_win_git_config_command_execution.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (FolderPath endswith "\\git.exe" or ProcessVersionInfoOriginalFileName =~ "git.exe") and (((ProcessCommandLine contains "core.sshCommand=" or ProcessCommandLine contains "core.fsmonitor=" or ProcessCommandLine contains "core.pager=" or ProcessCommandLine contains "core.editor=" or ProcessCommandLine contains "sequence.editor=" or ProcessCommandLine contains "diff.external=") and (ProcessCommandLine contains "cmd " or ProcessCommandLine contains "cmd.exe" or ProcessCommandLine contains "cmd /" or ProcessCommandLine contains "powershell" or ProcessCommandLine contains "pwsh" or ProcessCommandLine contains "mshta" or ProcessCommandLine contains "rundll32" or ProcessCommandLine contains "regsvr32" or ProcessCommandLine contains "wscript" or ProcessCommandLine contains "cscript" or ProcessCommandLine contains "bitsadmin" or ProcessCommandLine contains "certutil" or ProcessCommandLine contains ".bat" or ProcessCommandLine contains ".cmd" or ProcessCommandLine contains ".ps1" or ProcessCommandLine contains ".vbs" or ProcessCommandLine contains ".hta")) or ProcessCommandLine contains "ext::")
