// Change: update to existing rule
// Title: WSF/JSE/JS/VBA/VBE File Execution Via Cscript/Wscript
// Sigma ID: 1e33157c-53b1-41ad-bbcc-780b80b58288
// Status: test | Level: medium
// Author: Michael Haag
// Date: 2019-01-16 | Modified: 2026-02-17
// ATT&CK: execution, T1059.005, T1059.007
// Tags: detection.threat-hunting
// Description: Detects script file execution (.js, .jse, .vba, .vbe, .vbs, .wsf, .wsh) by Wscript/Cscript.
// False positives:
//   - Some additional tuning is required. It is recommended to add the user profile path in CommandLine if it is getting too noisy.
// References:
//   - https://thedfirreport.com/2023/10/30/netsupport-intrusion-results-in-domain-compromise/
//   - https://redcanary.com/blog/gootloader/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ad147b5514596e70f2782769d9833046b7c8e12b/rules-threat-hunting/windows/process_creation/proc_creation_win_wscript_cscript_script_exec.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((ProcessVersionInfoOriginalFileName in~ ("wscript.exe", "cscript.exe")) or (FolderPath endswith "\\wscript.exe" or FolderPath endswith "\\cscript.exe")) and (ProcessCommandLine contains ".js" or ProcessCommandLine contains ".jse" or ProcessCommandLine contains ".vba" or ProcessCommandLine contains ".vbe" or ProcessCommandLine contains ".vbs" or ProcessCommandLine contains ".wsf" or ProcessCommandLine contains ".wsh")
