// Change: update to existing rule
// Title: Suspicious ZipExec Execution
// Sigma ID: 90dcf730-1b71-4ae7-9ffc-6fcf62bd0132
// Status: test | Level: medium
// Author: frack113
// Date: 2021-11-07 | Modified: 2022-12-25
// ATT&CK: execution, stealth, T1218, T1202
// Description: ZipExec is a Proof-of-Concept (POC) tool to wrap binary-based tools into a password-protected
//   zip file.
// False positives:
//   - Unknown
// References:
//   - https://twitter.com/SBousseaden/status/1451237393017839616
//   - https://github.com/Tylous/ZipExec
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ed4273b30b6bba81f525a9ba136c2bcdb6d8ca95/rules/windows/process_creation/proc_creation_win_hktl_zipexec.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (ProcessCommandLine contains "/generic:Microsoft_Windows_Shell_ZipFolder:filename=" and ProcessCommandLine contains ".zip" and ProcessCommandLine contains "/pass:" and ProcessCommandLine contains "/user:") or (ProcessCommandLine contains "/delete" and ProcessCommandLine contains "Microsoft_Windows_Shell_ZipFolder:filename=" and ProcessCommandLine contains ".zip")
