// Title: MMC Spawning Windows Shell
// Sigma ID: 05a2ab7e-ce11-4b63-86db-ab32e763e11d
// Status: test | Level: high
// Author: Karneades, Swisscom CSIRT
// Date: 2019-08-05 | Modified: 2022-07-14
// ATT&CK: lateral-movement, T1021.003
// Description: Detects a Windows command line executable started from MMC
// References:
//   - https://enigma0x3.net/2017/01/05/lateral-movement-using-the-mmc20-application-com-object/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ad147b5514596e70f2782769d9833046b7c8e12b/rules/windows/process_creation/proc_creation_win_mmc_susp_child_process.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where InitiatingProcessFolderPath endswith "\\mmc.exe" and ((FolderPath endswith "\\cmd.exe" or FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe" or FolderPath endswith "\\wscript.exe" or FolderPath endswith "\\cscript.exe" or FolderPath endswith "\\sh.exe" or FolderPath endswith "\\bash.exe" or FolderPath endswith "\\reg.exe" or FolderPath endswith "\\regsvr32.exe") or FolderPath contains "\\BITSADMIN")
