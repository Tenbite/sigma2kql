// Change: update to existing rule
// Title: Microsoft IIS Service Account Password Dumped
// Sigma ID: 2d3cdeec-c0db-45b4-aa86-082f7eb75701
// Status: test | Level: high
// Author: Tim Rauch, Janantha Marasinghe, Elastic (original idea)
// Date: 2022-11-08 | Modified: 2023-01-22
// ATT&CK: credential-access, T1003
// Description: Detects the Internet Information Services (IIS) command-line tool, AppCmd, being used to list
//   passwords
// False positives:
//   - Unknown
// References:
//   - https://github.com/elastic/detection-rules/blob/0aacc5e19292f764a002ea2093b2a076db35b589/rules/windows/credential_access_iis_apppoolsa_pwd_appcmd.toml
//   - https://twitter.com/0gtweet/status/1588815661085917186?cxt=HHwWhIDUyaDbzYwsAAAA
//   - https://www.netspi.com/blog/technical/network-penetration-testing/decrypting-iis-passwords-to-break-out-of-the-dmz-part-2/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ad147b5514596e70f2782769d9833046b7c8e12b/rules/windows/process_creation/proc_creation_win_iis_appcmd_service_account_password_dumped.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.
// Note: 1 wildcard comparison(s) rewritten to 'matches regex' (KQL treats * in contains/endswith/== as a literal character)

DeviceProcessEvents
| where ((FolderPath endswith "\\appcmd.exe" or ProcessVersionInfoOriginalFileName =~ "appcmd.exe") and ProcessCommandLine contains "list ") and ((ProcessCommandLine contains " /config" or ProcessCommandLine contains " /xml" or ProcessCommandLine contains " -config" or ProcessCommandLine contains " -xml") or ((ProcessCommandLine contains " /@t" or ProcessCommandLine contains " /text" or ProcessCommandLine contains " /show" or ProcessCommandLine contains " -@t" or ProcessCommandLine contains " -text" or ProcessCommandLine contains " -show") and (ProcessCommandLine matches regex @"(?i):.*" or ProcessCommandLine contains "password")))
