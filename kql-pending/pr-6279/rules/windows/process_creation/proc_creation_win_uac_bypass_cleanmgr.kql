// Change: update to existing rule
// Title: UAC Bypass Using Disk Cleanup
// Sigma ID: b697e69c-746f-4a86-9f59-7bfff8eab881
// Status: test | Level: high
// Author: Christian Burkard (Nextron Systems)
// Date: 2021-08-30 | Modified: 2024-12-01
// ATT&CK: privilege-escalation, T1548.002
// Description: Detects the pattern of UAC Bypass using scheduled tasks and variable expansion of cleanmgr.exe
//   (UACMe 34)
// False positives:
//   - Unknown
// References:
//   - https://github.com/hfiref0x/UACME
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ed4273b30b6bba81f525a9ba136c2bcdb6d8ca95/rules/windows/process_creation/proc_creation_win_uac_bypass_cleanmgr.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ProcessCommandLine endswith "\"\\system32\\cleanmgr.exe /autoclean /d C:" and InitiatingProcessCommandLine =~ "C:\\Windows\\system32\\svchost.exe -k netsvcs -p -s Schedule" and (ProcessIntegrityLevel in~ ("High", "System", "S-1-16-16384", "S-1-16-12288"))
