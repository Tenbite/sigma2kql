// Change: update to existing rule
// Title: UAC Bypass Using NTFS Reparse Point - Process
// Sigma ID: 39ed3c80-e6a1-431b-9df3-911ac53d08a7
// Status: test | Level: high
// Author: Christian Burkard (Nextron Systems)
// Date: 2021-08-30 | Modified: 2024-12-01
// ATT&CK: privilege-escalation, T1548.002
// Description: Detects the pattern of UAC Bypass using NTFS reparse point and wusa.exe DLL hijacking (UACMe 36)
// False positives:
//   - Unknown
// References:
//   - https://github.com/hfiref0x/UACME
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ed4273b30b6bba81f525a9ba136c2bcdb6d8ca95/rules/windows/process_creation/proc_creation_win_uac_bypass_ntfs_reparse_point.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (ProcessCommandLine startswith "\"C:\\Windows\\system32\\wusa.exe\"  /quiet C:\\Users\\" and ProcessCommandLine endswith "\\AppData\\Local\\Temp\\update.msu" and (ProcessIntegrityLevel in~ ("High", "System", "S-1-16-16384", "S-1-16-12288"))) or (InitiatingProcessCommandLine =~ "\"C:\\Windows\\system32\\dism.exe\" /online /quiet /norestart /add-package /packagepath:\"C:\\Windows\\system32\\pe386\" /ignorecheck" and (ProcessIntegrityLevel in~ ("High", "System")) and (ProcessCommandLine contains "C:\\Users\\" and ProcessCommandLine contains "\\AppData\\Local\\Temp\\" and ProcessCommandLine contains "\\dismhost.exe {") and FolderPath endswith "\\DismHost.exe")
