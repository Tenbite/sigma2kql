// Change: update to existing rule
// Title: Whoami.EXE Execution Anomaly
// Sigma ID: 8de1cbe8-d6f5-496d-8237-5f44a721c7a0
// Status: test | Level: medium
// Author: Florian Roth (Nextron Systems)
// Date: 2021-08-12 | Modified: 2025-03-06
// ATT&CK: discovery, T1033
// Tags: car.2016-03-001
// Description: Detects the execution of whoami.exe with suspicious parent processes.
// False positives:
//   - Admin activity
//   - Scripts and administrative tools used in the monitored environment
//   - Monitoring activity
// References:
//   - https://brica.de/alerts/alert/public/1247926/agent-tesla-keylogger-delivered-inside-a-power-iso-daa-archive/
//   - https://app.any.run/tasks/7eaba74e-c1ea-400f-9c17-5e30eee89906/
//   - https://www.youtube.com/watch?v=DsJ9ByX84o4&t=6s
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/ed4273b30b6bba81f525a9ba136c2bcdb6d8ca95/rules/windows/process_creation/proc_creation_win_whoami_parent_anomaly.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (FolderPath endswith "\\whoami.exe" or ProcessVersionInfoOriginalFileName =~ "whoami.exe") and (not(((InitiatingProcessFolderPath endswith "\\cmd.exe" or InitiatingProcessFolderPath endswith "\\powershell_ise.exe" or InitiatingProcessFolderPath endswith "\\powershell.exe" or InitiatingProcessFolderPath endswith "\\pwsh.exe") or isnull(InitiatingProcessFolderPath) or (InitiatingProcessFolderPath in~ ("", "-"))))) and (not(InitiatingProcessFolderPath endswith ":\\Program Files\\Microsoft Monitoring Agent\\Agent\\MonitoringHost.exe"))
