// Title: HackTool - CrackMapExec File Indicators
// Sigma ID: 736ffa74-5f6f-44ca-94ef-1c0df4f51d2a
// Status: test | Level: high
// Author: Nasreddine Bencherchali (Nextron Systems)
// Date: 2024-03-11 | Modified: 2026-10-14
// ATT&CK: credential-access, T1003.001
// Description: Detects file creation events with filename patterns used by CrackMapExec.
// False positives:
//   - Unknown
// References:
//   - https://github.com/byt3bl33d3r/CrackMapExec/
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/2c47efc57dee1a9cb86b038e7cab70189d4953cc/rules/windows/file/file_event/file_event_win_hktl_crackmapexec_indicators.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceFileEvents
| where FolderPath startswith "C:\\Windows\\Temp\\" and ((FolderPath endswith "\\temp.ps1" or FolderPath endswith "\\msol.ps1") or (FolderPath matches regex "(?i)^C:\\\\Windows\\\\Temp\\\\[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\.txt$" or FolderPath matches regex "(?i)^C:\\\\Windows\\\\Temp\\\\[a-z]{8}\\.tmp$"))
