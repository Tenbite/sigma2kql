// PENDING: from an OPEN SigmaHQ pull request. Not reviewed or merged by SigmaHQ yet.
// Pull request: #5897 fix: Split Service Binary in Suspicious Folder into two distinct rules
// Pull request URL: https://github.com/SigmaHQ/sigma/pull/5897
// Pull request author: swachchhanda000
// Change: new rule
// Title: Service StartType Modification by Process Running from Suspicious Directory
// Sigma ID: 5def21e6-8927-4ebd-bf20-16f440369564
// Status: experimental | Level: high
// Author: Florian Roth (Nextron Systems), frack113
// Date: 2026-10-11 | Modified: -
// ATT&CK: persistence, defense-impairment, T1112, privilege-escalation, T1543.003
// Description: Detect the modification of a service start type by a process running from a suspicious
//   directory. If the service start type is set to "Automatic" or "System", the service will be
//   started at boot time, which can be used by attackers to maintain persistence. And it could be
//   particularly suspicious if the modification is performed by a process running from a directory
//   that is not commonly used for legitimate software, such as user profile directories, temporary
//   folders, or other non-standard locations.
// False positives:
//   - Software installation or deployment scripts setting a service to start automatically
//   - Management tooling running from a staging directory and changing service start types
//   - Legitimate administrative activity re-configuring service startup. Inspect the writing process and user context to determine intent
// References:
//   - https://www.elastic.co/guide/en/security/8.19/suspicious-imagepath-service-creation.html
//   - https://docs.specterops.io/ghostpack-docs/SharpUp-mdx/checks/unquotedservicepath
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/c6fee922f43a1e5a7d8d4cf3b824416f65c36b56/rules/windows/registry/registry_set/registry_set_susp_service_startup_modification.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.
// Note: 2 wildcard comparison(s) rewritten to 'matches regex' (KQL treats * in contains/endswith/== as a literal character)

DeviceRegistryEvents
| where ((RegistryKey matches regex @"(?i)\\System.*$" and RegistryKey contains "ControlSet" and RegistryKey matches regex @"(?i)\\Services.*$") and RegistryKey endswith "\\Start" and (InitiatingProcessFolderPath contains "\\$Recycle.Bin\\" or InitiatingProcessFolderPath contains "\\ADMIN$\\" or InitiatingProcessFolderPath contains "\\AppData\\" or InitiatingProcessFolderPath contains "\\Desktop\\" or InitiatingProcessFolderPath contains "\\Documents\\" or InitiatingProcessFolderPath contains "\\Downloads\\" or InitiatingProcessFolderPath contains "\\Favorites\\" or InitiatingProcessFolderPath contains "\\Favourites\\" or InitiatingProcessFolderPath contains "\\Music\\" or InitiatingProcessFolderPath contains "\\Perflogs\\" or InitiatingProcessFolderPath contains "\\Pictures\\" or InitiatingProcessFolderPath contains "\\Temp\\" or InitiatingProcessFolderPath contains "\\Users\\Default\\" or InitiatingProcessFolderPath contains "\\Users\\Public\\" or InitiatingProcessFolderPath contains "\\Videos\\" or InitiatingProcessFolderPath contains "\\Windows\\Debug\\" or InitiatingProcessFolderPath contains "\\Windows\\Tasks\\" or InitiatingProcessFolderPath contains "\\Windows\\Tracing\\") and (RegistryValueData in~ ("DWORD (0x00000000)", "DWORD (0x00000001)", "DWORD (0x00000002)"))) and (not((InitiatingProcessFolderPath contains "\\Common Files\\" and InitiatingProcessFolderPath contains "\\Temp\\")))
