// PENDING: from an OPEN SigmaHQ pull request. Not reviewed or merged by SigmaHQ yet.
// Pull request: #5897 fix: Split Service Binary in Suspicious Folder into two distinct rules
// Pull request URL: https://github.com/SigmaHQ/sigma/pull/5897
// Pull request author: swachchhanda000
// Change: new rule
// Title: Suspicious Service Binary Location
// Sigma ID: 1a8af205-1d32-4352-b937-d933ecf5e7d6
// Status: experimental | Level: high
// Author: Florian Roth (Nextron Systems), frack113
// Date: 2026-10-11 | Modified: -
// ATT&CK: persistence, defense-impairment, T1112, privilege-escalation, T1543.003
// Description: Detects services with a binary path pointing to a suspicious location. Attackers may create or
//   modify services to point to malicious executables in order to maintain persistence on a
//   compromised system. It could be particularly suspicious if the service binary path points to a
//   directory that is not commonly used for legitimate software, such as user profile directories,
//   temporary folders, or other non-standard locations.
// False positives:
//   - Software installation or upgrade staging a service binary in a temporary or user-profile directory before moving it
//   - Backup or deployment tooling running from a staging directory and registering or updating a service
//   - Legitimate administrative activity re-pointing a service ImagePath. Inspect the writing process and user context to determine intent
// References:
//   - https://www.elastic.co/guide/en/security/8.19/suspicious-imagepath-service-creation.html
//   - https://docs.specterops.io/ghostpack-docs/SharpUp-mdx/checks/unquotedservicepath
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/c6fee922f43a1e5a7d8d4cf3b824416f65c36b56/rules/windows/registry/registry_set/registry_set_service_susp_service_binary_location.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.
// Note: 2 wildcard comparison(s) rewritten to 'matches regex' (KQL treats * in contains/endswith/== as a literal character)

DeviceRegistryEvents
| where ((RegistryKey matches regex @"(?i)\\System.*$" and RegistryKey contains "ControlSet" and RegistryKey matches regex @"(?i)\\Services.*$") and RegistryKey endswith "\\ImagePath" and (RegistryValueData contains "\\$Recycle.Bin\\" or RegistryValueData contains "\\ADMIN$\\" or RegistryValueData contains "\\Desktop\\" or RegistryValueData contains "\\Documents\\" or RegistryValueData contains "\\Downloads\\" or RegistryValueData contains "\\Favorites\\" or RegistryValueData contains "\\Favourites\\" or RegistryValueData contains "\\Music\\" or RegistryValueData contains "\\Perflogs\\" or RegistryValueData contains "\\Pictures\\" or RegistryValueData contains "\\Temp\\" or RegistryValueData contains "\\Users\\Default\\" or RegistryValueData contains "\\Users\\Public\\" or RegistryValueData contains "\\Videos\\" or RegistryValueData contains "\\Windows\\Debug\\" or RegistryValueData contains "\\Windows\\Tasks\\" or RegistryValueData contains "\\Windows\\Tracing\\" or RegistryValueData contains "%Public%\\" or RegistryValueData contains "%Temp%")) and (not((RegistryKey endswith "\\CurrentControlSet\\Services\\MBAMInstallerService\\ImagePath" and RegistryValueData endswith "\\AppData\\Local\\Temp\\MBAMInstallerService.exe\"" and InitiatingProcessFolderPath =~ "C:\\Windows\\system32\\services.exe")))
