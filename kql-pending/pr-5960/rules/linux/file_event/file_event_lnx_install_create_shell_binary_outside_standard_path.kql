// PENDING: from an OPEN SigmaHQ pull request. Not reviewed or merged by SigmaHQ yet.
// Pull request: #5960 new: CVE-2026-41651 Pack2TheRoot detection rules and generic Linux LPE coverage
// Pull request URL: https://github.com/SigmaHQ/sigma/pull/5960
// Pull request author: swachchhanda000
// Change: new rule
// Title: Shell Binary Created by Install Outside Standard Paths
// Sigma ID: 25b7d368-f0d9-4d4f-ac20-d2df7f1a0337
// Status: experimental | Level: high
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-04-24 | Modified: -
// ATT&CK: privilege-escalation, stealth, execution, T1036, T1548.001, T1059.004
// Description: Detects the 'install' utility writing a shell binary to a location outside standard system
//   binary directories. The 'install' command is commonly abused in privilege escalation postinst
//   scripts to drop a SUID-enabled copy of bash (or another shell) into a writable path such as /tmp
//   or /home, which the attacker then executes with '-p' to obtain a root shell. There is no
//   legitimate reason for 'install' to place a shell binary outside of standard system paths (e.g.
//   /bin, /usr/bin).
// False positives:
//   - Unlikely
// References:
//   - https://gtfobins.github.io/gtfobins/bash/#suid
//   - https://github.com/Vozec/CVE-2026-41651
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/f8f8984ea4e01afa9b9a4f55559461818bd16d5a/rules/linux/file_event/file_event_lnx_install_create_shell_binary_outside_standard_path.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceFileEvents
| where (InitiatingProcessFolderPath endswith "/install" and (FolderPath endswith "bash" or FolderPath endswith "/sh" or FolderPath endswith "dash" or FolderPath endswith "zsh" or FolderPath endswith "ksh" or FolderPath endswith "mksh" or FolderPath endswith "csh" or FolderPath endswith "fish")) and (not((FolderPath startswith "/bin/" or FolderPath startswith "/usr/bin/" or FolderPath startswith "/sbin/" or FolderPath startswith "/usr/sbin/" or FolderPath startswith "/usr/local/bin/" or FolderPath startswith "/usr/local/sbin/")))
