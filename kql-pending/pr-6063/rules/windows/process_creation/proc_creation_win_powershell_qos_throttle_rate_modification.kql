// PENDING: from an OPEN SigmaHQ pull request. Not reviewed or merged by SigmaHQ yet.
// Pull request: #6063 new: edrchoker qos throttle rate modification rules
// Pull request URL: https://github.com/SigmaHQ/sigma/pull/6063
// Pull request author: swachchhanda000
// Change: new rule
// Title: QoS ThrottleRate Policy Set via PowerShell CommandLine
// Sigma ID: 09a2d760-9500-4088-9d9d-f63f88b2e0d7
// Status: experimental | Level: medium
// Author: Swachchhanda Shrawan Poudel (Nextron Systems)
// Date: 2026-06-09 | Modified: -
// ATT&CK: defense-impairment, T1685
// Description: Detects PowerShell invoking New-NetQosPolicy or Set-NetQosPolicy with a
//   ThrottleRateActionBitsPerSecond parameter to potentially set abnormal bandwidth limits on
//   targeted processes. ThrottleRateActionBitsPerSecond is a QoS policy setting that can be used to
//   limit the bandwidth of targeted processes. Tools such as EDRChoker use this to throttle network
//   bandwidth of targeted processes (e.g. EDR agents) to near-zero, silencing telemetry without
//   terminating the process.
// False positives:
//   - Legitimate QoS bandwidth policy management by administrators
// References:
//   - https://learn.microsoft.com/en-us/powershell/module/netqos/new-netqospolicy?view=windowsserver2025-ps
//   - https://github.com/TwoSevenOneT/EDRChoker/
//   - https://www.zerosalarium.com/2026/06/edrchoker-choking-telemetry-stream-block-edr.html
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/17172ba8e70f32db2d8132fe1562146c80087920/rules/windows/process_creation/proc_creation_win_powershell_qos_throttle_rate_modification.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where ((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") or (ProcessVersionInfoOriginalFileName in~ ("PowerShell.EXE", "pwsh.dll"))) and (ProcessCommandLine contains "New-NetQosPolicy" or ProcessCommandLine contains "Set-NetQosPolicy") and ProcessCommandLine contains "ThrottleRateActionBitsPerSecond"
