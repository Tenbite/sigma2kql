// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceProcessEvents
| where (ProcessCommandLine contains "AmsiScanBuffer" or ProcessCommandLine contains "VirtualProtect") or (ProcessCommandLine contains "[Ref].Assembly" or ProcessCommandLine contains "System.Management.Automation.AmsiUtils")
