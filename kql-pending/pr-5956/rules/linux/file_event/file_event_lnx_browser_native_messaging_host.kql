// PENDING: from an OPEN SigmaHQ pull request. Not reviewed or merged by SigmaHQ yet.
// Pull request: #5956 new: Native Messaging Host Registration Detection for Windows, macOS and Linux
// Pull request URL: https://github.com/SigmaHQ/sigma/pull/5956
// Pull request author: Fz0x00
// Change: new rule
// Title: Potential Suspicious Browser Native Messaging Host File Creation on Linux
// Sigma ID: 564ca037-6cd4-459e-94d6-ad725dad1f6b
// Status: experimental | Level: medium
// Author: PersonalRules
// Date: 2026-04-23 | Modified: -
// ATT&CK: persistence, T1176.001, execution
// Description: Detects the creation of native messaging host manifest files in browser-specific directories on
//   Linux. Native messaging allows browser extensions to communicate with local binaries via
//   stdin/stdout, which can be abused to execute arbitrary commands and escape the browser sandbox.
// False positives:
//   - Legitimate browser extensions installing native messaging hosts (password managers, screen readers, etc.)
//   - Package managers (apt, yum, dnf) installing browser extension packages
//   - Browser updates that register new native messaging hosts
// References:
//   - https://developer.chrome.com/docs/extensions/develop/concepts/native-messaging
//   - https://learn.microsoft.com/en-us/microsoft-edge/extensions-chromium/developer-guide/native-messaging
//   - https://developer.mozilla.org/en-US/docs/Mozilla/Add-ons/WebExtensions/Native_manifests
//   - https://github.com/praetorian-inc/ChromeAlone
// Sigma rule: https://github.com/SigmaHQ/sigma/blob/32adff53abb9817be521584dba2c24fa19649564/rules/linux/file_event/file_event_lnx_browser_native_messaging_host.yml
// License: Detection Rule License (DRL) 1.1 - https://github.com/SigmaHQ/Detection-Rule-License
// Converted by sigma2kql (target: microsoft_xdr, pySigma 1.5.1, pySigma-backend-kusto 1.0.1)
// Validation: passed (Kusto.Language, Defender schema)
// Machine-generated and not tested against real telemetry. Verify before use as a detection.

DeviceFileEvents
| where FolderPath contains "/etc/opt/chrome/native-messaging-hosts/" or FolderPath contains "/.config/google-chrome/NativeMessagingHosts/" or FolderPath contains "/etc/chromium/native-messaging-hosts/" or FolderPath contains "/.config/chromium/NativeMessagingHosts/" or FolderPath contains "/etc/opt/edge/native-messaging-hosts/" or FolderPath contains "/.config/microsoft-edge/NativeMessagingHosts/" or (FolderPath contains "/usr/lib/mozilla/native-messaging-hosts/" or FolderPath contains "/usr/lib64/mozilla/native-messaging-hosts/") or FolderPath contains "/.mozilla/native-messaging-hosts/"
